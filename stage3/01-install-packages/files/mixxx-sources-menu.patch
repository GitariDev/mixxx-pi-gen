+namespace SourceGlyphs {
+inline QString svg(const QString& name) {
+    static const QMap<QString, QString> paths{
+            {QStringLiteral("pi"),
+                    QStringLiteral("<path d=\"M9 18V5l10-2v13\"/><circle cx=\"6.5\" cy=\"18\" r=\"2.5\"/>"
