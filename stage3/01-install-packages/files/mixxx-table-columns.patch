+// The stretch column never gets narrower than this; with many wide columns
+// the table scrolls sideways instead of squeezing it.
+constexpr int kStretchColumnMinimumWidth = 160;
+
+// The given column takes the free width, so the visible columns fill the
+// table. When it is hidden (or there is none), the last visible column
+// stretches instead. All columns stay Interactive: QHeaderView::Stretch
+// would shrink the column to the 20 px minimum section size when the other
+// columns are wide. Call again when the width or another column changes.
+inline void stretchColumn(QHeaderView* header, int column) {
+    const bool fill = column >= 0 && column < header->count() &&
+            !header->isSectionHidden(column);
+    header->setStretchLastSection(!fill);
+    if (!fill) {
+        return;
+    }
+    int others = 0;
+    for (int section = 0; section < header->count(); ++section) {
+        if (section != column && !header->isSectionHidden(section)) {
+            others += header->sectionSize(section);
+        }
+    }
+    const int width = std::max(kStretchColumnMinimumWidth, header->viewport()->width() - others);
+    if (header->sectionSize(column) != width) {
+        header->resizeSection(column, width);
+    }
+}
