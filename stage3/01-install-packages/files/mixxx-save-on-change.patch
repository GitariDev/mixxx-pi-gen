+bool writeFileAtomically(const QString& filePath, const QByteArray& contents) {
+    const QFileInfo fileInfo(filePath);
+    if (!fileInfo.absoluteDir().exists()) {
+        QDir().mkpath(fileInfo.absolutePath());
+    }
+    // QSaveFile writes a temporary file in the same directory and renames it
+    // over the old file in commit(); the old file is never removed first.
+    // No direct-write fallback: in a read-only directory the write fails and
+    // the old file stays as it was.
+    QSaveFile file(filePath);
+    file.setDirectWriteFallback(false);
+    if (!file.open(QIODevice::WriteOnly)) {
+        qWarning().nospace() << "Could not write " << filePath << ": " << file.errorString();
+        return false;
+    }
+    if (file.write(contents) != contents.size() || !file.flush()) {
+        qWarning().nospace() << "Error while writing " << filePath << ": " << file.errorString();
+        file.cancelWriting();
+        return false;
+    }
+#ifdef Q_OS_UNIX
+    // Qt 6.8 QSaveFile::commit() also calls fdatasync() but ignores its
+    // result; this sync reports a failing disk before the rename.
+    if (::fsync(file.handle()) != 0) {
+        qWarning().nospace() << "Error while syncing " << filePath << ": "
+                             << qt_error_string(errno);
+        file.cancelWriting();
+        return false;
+    }
+#endif
+    if (!file.commit()) {
+        qWarning().nospace() << "Could not replace " << filePath << ": " << file.errorString();
+        return false;
+    }
+#ifdef Q_OS_UNIX
+    // Make the rename itself durable. The new file is in place already, so
+    // a failure here is only logged.
+    const int directory = ::open(QFile::encodeName(fileInfo.absolutePath()).constData(),
+            O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+    if (directory < 0 || ::fsync(directory) != 0) {
+        qWarning().nospace() << "Could not sync the directory of " << filePath << ": "
+                             << qt_error_string(errno);
+    }
+    if (directory >= 0) {
+        ::close(directory);
+    }
+#endif
+    return true;
+}
