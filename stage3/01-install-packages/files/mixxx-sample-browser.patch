+// R-8: the Load sample screen shares the one library widget with Tracks. Each
+// keeps its own place: the source (a sidebar row), the search text and the
+// scroll position. Entering sample mode remembers Tracks' place and shows the
+// sample browser's last place (the first time: the Samples folder); leaving
+// remembers the sample place and shows Tracks' place again.
+struct BrowsePlace {
+    // The sidebar row that shows the list. A reset of the sidebar model (a
+    // child feature rebuilding its tree, a drive coming or going) ends a
+    // persistent index, so the path from the top finds the row again.
+    QPersistentModelIndex source;
+    QVariantList path;
+    QString search;
+    int scroll = 0;
+};
+
+// One step of a sidebar path: the row's data (a folder path, a playlist id,
+// a drive) when it has any, else its label (a source's title).
+inline QVariant sourcePathStep(const QModelIndex& index, int dataRole) {
+    const QVariant data = index.data(dataRole);
+    if (data.isValid() && !(data.userType() == QMetaType::QString && data.toString().isEmpty())) {
+        return data;
+    }
+    return index.data(Qt::DisplayRole);
+}
+
+inline QVariantList sourcePath(const QModelIndex& index, int dataRole) {
+    QVariantList path;
+    for (QModelIndex step = index; step.isValid(); step = step.parent()) {
+        path.prepend(sourcePathStep(step, dataRole));
+    }
+    return path;
+}
+
+inline BrowsePlace browsePlace(const QModelIndex& index, int dataRole) {
+    return BrowsePlace{QPersistentModelIndex(index), sourcePath(index, dataRole), {}, 0};
+}
+
+// The row a place names now: its persistent index while it lives, else the
+// row found by its path. Invalid when it is gone (a drive pulled out).
+inline QModelIndex locatePlace(const QAbstractItemModel* model, const BrowsePlace& place,
+        int dataRole) {
+    if (place.source.isValid() && place.source.model() == model) {
+        return place.source;
+    }
+    if (!model || place.path.isEmpty()) {
+        return {};
+    }
+    QModelIndex parent;
+    for (const QVariant& step : place.path) {
+        QModelIndex found;
+        for (int row = 0; row < model->rowCount(parent); ++row) {
+            const QModelIndex candidate = model->index(row, 0, parent);
+            if (sourcePathStep(candidate, dataRole) == step) {
+                found = candidate;
+                break;
+            }
+        }
+        if (!found.isValid()) {
+            return {};
+        }
+        parent = found;
+    }
+    return parent;
+}
+
+class SampleBrowser {
+  public:
+    // [MixPi],sample_source values.
+    enum Source {
+        kNoSource = 0,
+        kSamples = 1,
+        kCollection = 2,
+        kDrive = 3,
+        kRecordings = 4,
+    };
+    // What the list shows now.
+    std::function<BrowsePlace()> capture;
+    // Shows a place. A place whose row is gone shows the start source.
+    std::function<void(const BrowsePlace&)> show;
+    // The row a place names now (invalid: gone).
+    std::function<QModelIndex(const BrowsePlace&)> locate;
+    // The place of a fixed source; its row is invalid when it is not there
+    // (no open drive).
+    std::function<BrowsePlace(int)> sourcePlace;
+    // The source shown changed (0: a list picked in Sources).
+    std::function<void(int)> sourceChanged;
+
+    bool active() const {
+        return m_active;
+    }
+    int source() const {
+        return m_source;
+    }
+
+    void setActive(bool active) {
+        if (active) {
+            enter();
+        } else {
+            leave(true);
+        }
+    }
+
+    void enter() {
+        if (m_active) {
+            return;
+        }
+        m_tracks = capture ? capture() : BrowsePlace{};
+        m_active = true;
+        if (m_hasSample && exists(m_sample)) {
+            place(m_sample, m_sampleSource);
+        } else {
+            choose(kSamples);
+        }
+    }
+
+    // Leaves sample mode. restoreTracks false: what is shown now stays (a
+    // drive opened from the media screen shows in Tracks).
+    void leave(bool restoreTracks) {
+        if (!m_active) {
+            return;
+        }
+        m_sample = capture ? capture() : BrowsePlace{};
+        m_hasSample = true;
+        m_sampleSource = m_source;
+        m_active = false;
+        setSource(kNoSource);
+        if (restoreTracks) {
+            apply(m_tracks);
+        }
+    }
+
+    // A source button. Returns the source shown: an open drive that is not
+    // there falls back to the Samples folder.
+    int choose(int source) {
+        if (!m_active || source < kSamples || source > kRecordings) {
+            return m_source;
+        }
+        BrowsePlace where = sourcePlace ? sourcePlace(source) : BrowsePlace{};
+        if (!exists(where) && source != kSamples) {
+            source = kSamples;
+            where = sourcePlace ? sourcePlace(source) : BrowsePlace{};
+        }
+        place(where, source);
+        return m_source;
+    }
+
+    // A list was opened another way (picked in Sources): which fixed source
+    // it is, if any. It is now the sample browser's place.
+    void shown(const BrowsePlace& where) {
+        if (!m_active || m_applying) {
+            return;
+        }
+        m_shown = where;
+        const QModelIndex index = locate ? locate(where) : QModelIndex();
+        int source = kNoSource;
+        for (int candidate = kSamples; candidate <= kRecordings && sourcePlace; ++candidate) {
+            const QModelIndex fixed = locate ? locate(sourcePlace(candidate)) : QModelIndex();
+            if (index.isValid() && fixed == index) {
+                source = candidate;
+                break;
+            }
+        }
+        setSource(source);
+    }
+
+    // The sidebar rows changed. A sample place that went away (a drive
+    // pulled out) falls back to the Samples folder.
+    void sourcesChanged() {
+        if (m_active && !m_applying && m_source != kSamples && !exists(m_shown)) {
+            choose(kSamples);
+        }
+    }
+
+  private:
+    bool exists(const BrowsePlace& where) const {
+        return locate && locate(where).isValid();
+    }
+
+    void place(const BrowsePlace& where, int source) {
+        m_shown = where;
+        setSource(source);
+        apply(where);
+    }
+
+    void apply(const BrowsePlace& where) {
+        if (!show) {
+            return;
+        }
+        m_applying = true;
+        show(where);
+        m_applying = false;
+    }
+
+    void setSource(int source) {
+        m_source = source;
+        if (sourceChanged) {
+            sourceChanged(source);
+        }
+    }
+
+    bool m_active = false;
+    bool m_applying = false;
+    bool m_hasSample = false;
+    int m_source = kNoSource;
+    int m_sampleSource = kSamples;
+    BrowsePlace m_tracks;
+    BrowsePlace m_sample;
+    BrowsePlace m_shown;
+};
+
 }
