+// [ChannelN],mixpi_from_usb (council round 1): 1 while the deck's track lives
+// on a mounted removable drive and is not yet ON PI; 0 for Pi tracks, for an
+// empty deck, and once the eject has marked it ON PI.
+inline bool fromUsb(const QString& location, const QStringList& drivePaths, bool onPi) {
+    if (onPi || location.isEmpty()) {
+        return false;
+    }
+    for (const auto& path : drivePaths) {
+        if (!path.isEmpty() &&
+                location.startsWith(path.endsWith(QLatin1Char('/')) ? path : QString(path + QLatin1Char('/')))) {
+            return true;
+        }
+    }
+    return false;
+}
