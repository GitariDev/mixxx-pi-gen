/* Browse is the only Pioneered page with a LibraryWrapper. Keep the decks
 * and Overview/Samples at their existing sizes on the 800x444 display.
 * Colours are the agreed UI tokens (agreed-ui/design/tokens.css). Fonts are
 * build B's (owner, 2026-11-18). */
#LibraryWrapper QTableView,
#LibraryWrapper WLibraryTextBrowser,
#LibraryWrapper WLibrarySidebar {
    font-size: 17px;
}

#LibraryWrapper WTrackTableViewHeader::section {
    font-size: 16px;
    min-height: 34px;
    padding: 0px 7px;
    margin: 0px;
    background-color: #1d222a;
    color: #e4e7ec;
    border: 0px;
    border-bottom: 1px solid #2c333d;
    border-right: 1px solid #2c333d;
}

/* The header's own area past the last section (seen after TITLE's edge is
 * dragged narrower) in the same --mx-surface-2 as the sections, as the
 * mockups' header row (layout.css .mxl-th) runs the full width. Without it
 * Qt draws its default light grey #efefef there. */
#LibraryWrapper WTrackTableViewHeader {
    background-color: #1d222a;
}

/* ...and the sections' 1 px --mx-line bottom line under that empty area too,
 * full width to the scroll bar (spec 2h, owner's choice B; wave J14). Qt draws
 * it in the header's last pixel row, the row the sections' own line is in, so
 * the header keeps its 35 px (34 px sections plus their line) and the sections
 * still show one line, not two. A rule of its own, so the H1 background rule
 * above stays as it is. */
#LibraryWrapper QTableView > WTrackTableViewHeader {
    border-bottom: 1px solid #2c333d;
}

/* The source list without the touch menu property; the Sources side menu
 * (spec s5) is styled by mixpi-sources-menu.qss, whose rules win. */
#LibraryWrapper WLibrarySidebar {
    background-color: #0a0d12;
    color: #eef2f7;
    border: 0px;
    selection-background-color: #1f2a17;
    selection-color: #ffffff;
}
#LibraryWrapper WLibrarySidebar::item {
    min-height: 56px;
    padding: 0px 14px;
    border-bottom: 1px solid #1c2531;
}
#LibraryWrapper WLibrarySidebar::item:selected {
    background-color: #1f2a17;
    color: #ffffff;
}

/* 24 px scroll bars at the right edge of every list (spec section 1, R-9). */
#LibraryWrapper QScrollBar {
    background-color: #161a20;
    border: 0px;
    margin: 0px;
}
#LibraryWrapper QScrollBar:horizontal {
    height: 24px;
}
#LibraryWrapper QScrollBar:vertical {
    width: 24px;
    border-left: 1px solid #2c333d;
}
#LibraryWrapper QScrollBar::handle {
    background-color: #5b6472;
    border: 5px solid #161a20;
    border-radius: 8px;
}
#LibraryWrapper QScrollBar::handle:horizontal {
    min-width: 56px;
    border: 5px solid #161a20;
}
#LibraryWrapper QScrollBar::handle:vertical {
    min-height: 56px;
}
#LibraryWrapper QScrollBar::handle:pressed {
    background-color: #a3c45e;
}
#LibraryWrapper QScrollBar::add-page,
#LibraryWrapper QScrollBar::sub-page {
    background-color: #161a20;
}

/* ☰ and ✎ are 48 px Navigate icon buttons (R-11); EDIT LIST and BACK keep text. */
#LibraryActionsButton, #LibrarySourcesButton, #LibraryBackButton, #SidebarButton {
    background-color: #1d222a;
    border: 1px solid #3a424e;
    border-radius: 3px;
    color: #e4e7ec;
    font-family: "Ubuntu Condensed", "Ubuntu";
    font-size: 17px;
    font-weight: bold;
    margin: 0px;
}
#LibraryActionsButton[pressed="true"], #LibrarySourcesButton[pressed="true"],
#LibraryBackButton[pressed="true"], #SidebarButton[pressed="true"] {
    background-color: #262c35;
}
/* ✎ while its menu is open: the lit tint (spec section 1). */
#LibraryActionsButton[value="1"] {
    background-color: rgba(163, 196, 94, 66);
    border: 2px solid #a3c45e;
}
/* While Sources is open the ☰ is the standard close control (spec s5, R-11):
 * surface-2, the red ✕ icon, no outline; pressed, danger-surface with a
 * danger border. It is not a lit button. */
#SidebarButton[value="1"] {
    background-color: #1d222a;
    border: 1px solid #1d222a;
}
#SidebarButton[value="1"][pressed="true"] {
    background-color: #34191b;
    border-color: #d0574d;
}

#LibraryBackButton:disabled {
    color: #7f8896;
    background-color: #13161b;
    border: 1px dashed #2c333d;
}

/* The search field fills the header (spec s3): a field on the page colour.
 * Build B's font: Open Sans (Pioneered's `*` rule), 17 px, bold (Pioneered's
 * #SearchBox rule). */
#LibraryWrapper #SearchBox {
    background-color: #0d1014;
    border: 1px solid #2c333d;
    border-radius: 3px;
    color: #e4e7ec;
    font-family: "Open Sans", "Ubuntu";
    font-size: 17px;
    font-weight: bold;
    margin: 0px;
}

/* The BPM lock is not a touch control. Draw no indicator in the BPM column. */
#LibraryWrapper #LibraryBPMButton::indicator {
    width: 0px;
    height: 0px;
    image: none;
    border: 0px;
}

/* The library tables (Tracks, Load sample, the table beside Sources) in the
 * mockups' colours (m-tracks.png, m-loadsample.png; agreed-ui layout.css
 * .mxl-tbl and .mxl-row): rows on #000 with every other row in --mx-surface
 * #161a20, text in --mx-text, and the selected row deck 1 at 32% over the
 * page (#263b51) with the same text. This replaces Pioneered's #32323c
 * stripes, white text and light selection (spec 2b). */
#LibraryWrapper QTableView {
    background-color: #000000;
    alternate-background-color: #161a20;
    color: #e4e7ec;
    selection-background-color: #263b51;
    selection-color: #e4e7ec;
}

/* One dark selection bar; the current-cell outline takes the same colour,
 * so the selected row has no second frame. */
#LibraryWrapper WTrackTableView {
    selection-background-color: #263b51;
    selection-color: #e4e7ec;
    qproperty-focusBorderColor: #263b51;
}
