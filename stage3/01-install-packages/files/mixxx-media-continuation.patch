+std::function<void()> Library::openRemovableSourceAsync(const QJsonObject& volume,
+        QObject* receiver, std::function<void(QString)> completion) {
+    const auto observed = MixpiMedia::inspectSelected(volume);
+    if (observed.database.empty()) {
+        const auto error = openRemovableSource(volume);
+        QTimer::singleShot(0, receiver, [completion = std::move(completion), error] { completion(error); });
+        return {};
+    }
+    auto source = std::find_if(m_sidebarSources.begin(), m_sidebarSources.end(),
+            [](const SidebarSource& item) { return item.id == QStringLiteral("RekordboxFeature"); });
+    QString error;
+    LibraryFeature* feature = nullptr;
+    if (!m_pLibraryWidget || !m_pSidebarWidget || source == m_sidebarSources.end()) {
+        error = tr("Library or native source is unavailable.");
+    } else {
+        const auto selectedSource = *source;
+        feature = selectedSource.feature;
+        if (!feature && selectedSource.create) {
+            feature = selectedSource.create();
+            addFeature(feature);
+            feature->bindLibraryWidget(m_pLibraryWidget, m_pSidebarKeyboard);
+            feature->bindSidebarWidget(m_pSidebarWidget);
+            emit setTrackTableFont(m_trackTableFont);
+            emit setTrackTableRowHeight(m_iTrackTableRowHeight);
+        }
+        if (feature) {
+            m_pConfig->setValue(selectedSource.preference, true);
+            applySidebarSourceVisibility();
+        } else {
+            error = tr("Native source could not be initialized.");
+        }
+    }
+    if (!error.isEmpty()) {
+        QTimer::singleShot(0, receiver, [completion = std::move(completion), error] { completion(error); });
+        return {};
+    }
+    const QPointer<Library> owner(this);
+    return static_cast<RekordboxFeature*>(feature)->openRemovableDeviceAsync(
+            volume.value("mount").toObject().value("path").toString(),
+            QString::fromStdString(observed.revision), QString::fromStdString(observed.database), receiver,
+            [owner, completion = std::move(completion)](QString result) {
+                if (!owner) {
+                    return;
+                }
+                if (result.isEmpty()) {
+                    ControlObject::set(ConfigKey("[MixPi]", "sample_load"), 0);
+                    ControlObject::set(ConfigKey("[MixPi]", "loop_deck"), 0);
+                    ControlObject::set(ConfigKey("[Tab]", "library"), 1);
+                }
+                completion(result);
+            });
 }
 
