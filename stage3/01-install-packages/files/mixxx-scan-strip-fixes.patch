+bool LibraryScannerDlg::toolPanelOpen() const {
+    // [MixPi],loop_deck is the skin's: 0 none, 1 or 2 that deck's tool panel.
+    const auto* pLoopDeck = ControlObject::getControl(
+            ConfigKey(kMixPiGroup, QStringLiteral("loop_deck")), ControlFlag::NoWarnIfMissing);
+    return pLoopDeck && (pLoopDeck->get() == 1 || pLoopDeck->get() == 2);
+}
