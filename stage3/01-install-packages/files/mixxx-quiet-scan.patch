+QWidget* scannerStripHost() {
+    QWidget* pHidden = nullptr;
+    const auto widgets = QApplication::topLevelWidgets();
+    for (QWidget* pWidget : widgets) {
+        if (!qobject_cast<QMainWindow*>(pWidget)) {
+            continue;
+        }
+        if (pWidget->isVisible()) {
+            return pWidget;
+        }
+        if (!pHidden) {
+            pHidden = pWidget;
+        }
+    }
+    return pHidden;
+}
