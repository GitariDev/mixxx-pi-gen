+// rekordbox stores a path with its accented letters precomposed (NFC). A drive
+// filled on a Mac can hold the same file name decomposed (NFD), and Linux finds
+// names byte for byte, so the stored path would miss the file. Use the form the
+// drive holds. This only looks at the drive; nothing is written.
+QString driveFileLocation(const QString& devicePath, const QString& filePath) {
+    const QString location = devicePath + filePath;
+    const bool ascii = std::all_of(filePath.cbegin(), filePath.cend(), [](QChar character) {
+        return character.unicode() < 0x80;
+    });
+    if (ascii || QFile::exists(location)) {
+        return location;
+    }
+    for (const auto form : {QString::NormalizationForm_C, QString::NormalizationForm_D}) {
+        const QString candidate = devicePath + filePath.normalized(form);
+        if (candidate != location && QFile::exists(candidate)) {
+            return candidate;
+        }
+    }
+    return location;
+}
