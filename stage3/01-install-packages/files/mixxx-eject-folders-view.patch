+void Library::releaseGoneFolder() {
+    // Spec 2e, as 2g applies it (owner: "Let just land on the top menu
+    // instead"): BrowseFeature empties the table when the mount of its
+    // folder went. When that folder is the place Tracks shows (through
+    // Folders: Removable Devices, a Quick Link or /), the Sources menu lands
+    // on its top level with nothing current, as for a rekordbox drive (J4).
+    // A list of This Pi or another drive in Tracks: the menu stays. The
+    // saved start (★) is not touched.
+    const QString folder = m_pBrowseFeature->releaseGoneFolder();
+    const QModelIndex computer = sourceRow(QStringLiteral("BrowseFeature"));
+    if (folder.isEmpty() || !m_pSidebarWidget || !m_pShownPlace || !computer.isValid()) {
+        return;
+    }
+    const QVariantList& place = m_pShownPlace->path;
+    if (place.size() > 1 &&
+            place.first() == LibraryInterface::sourcePathStep(computer, SidebarModel::DataRole) &&
+            QDir::cleanPath(place.last().toString()) == QDir::cleanPath(folder)) {
+        m_pSidebarWidget->releaseShownSource();
+    }
+}
