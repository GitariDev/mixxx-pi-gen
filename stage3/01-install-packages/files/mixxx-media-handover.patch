+// R-6 engine A (system eject): drain Mixxx's own use in-process, release the
+// library views, unload stopped players that are not on a copy, wait until
+// the drain is idle (10 s at most, Cancel allowed), unmount each volume
+// through udisks2 with a timeout, confirm in the mount table, retire the
+// drive. Any failure cancels the drain and leaves the drive mounted.
+class MixpiEjectEngine : public QObject {
+  public:
+    static constexpr qint64 kDrainMs = 10000;
+    static constexpr int kPollMs = 100;
+    struct Volume {
+        QString device; // major:minor, for the mount table check (never shown)
+        QString source; // the block device for udisks2
+    };
+    using Done = std::function<void(bool)>;
+    struct Hooks {
+        std::function<bool()> mustStopFirst;
+        std::function<bool()> beginDrain;
+        std::function<bool()> drainIdle;
+        std::function<void()> cancelDrain;
+        std::function<bool()> retire;
+        std::function<void()> releaseViews;
+        std::function<void()> unloadStopped;
+        std::function<void(const QString& source, Done done)> unmount;
+        std::function<bool(const QString& device)> stillMounted;
+        std::function<qint64()> now;
+    };
+    static inline const QString kFailure = QStringLiteral("Not ejected. The drive is still in use.");
+
+    explicit MixpiEjectEngine(Hooks hooks, QObject* parent = nullptr)
+            : QObject(parent), m_hooks(std::move(hooks)) {
+        if (!m_hooks.now) {
+            m_hooks.now = [] { return QDateTime::currentMSecsSinceEpoch(); };
+        }
+        m_poll.setInterval(kPollMs);
+        connect(&m_poll, &QTimer::timeout, this, [this] { poll(); });
+    }
+
+    std::function<void(MixpiMediaPage::Step)> progress;
+    // ok; message (empty when cancelled by the owner)
+    std::function<void(bool, QString)> finished;
+
+    bool running() const {
+        return m_running;
+    }
+
+    bool start(const QList<Volume>& volumes) {
+        if (m_running || volumes.isEmpty()) {
+            return false;
+        }
+        m_volumes = volumes;
+        m_running = true;
+        step(MixpiMediaPage::Step::Drain);
+        if ((m_hooks.mustStopFirst && m_hooks.mustStopFirst()) || !m_hooks.beginDrain || !m_hooks.beginDrain()) {
+            fail();
+            return true;
+        }
+        step(MixpiMediaPage::Step::Keep);
+        if (m_hooks.releaseViews) {
+            m_hooks.releaseViews();
+        }
+        if (m_hooks.unloadStopped) {
+            m_hooks.unloadStopped();
+        }
+        step(MixpiMediaPage::Step::Close);
+        m_started = m_hooks.now();
+        m_poll.start();
+        poll();
+        return true;
+    }
+
+    // Cancel works until the unmount starts.
+    bool cancel() {
+        if (!m_running || m_unmounting) {
+            return false;
+        }
+        stop();
+        if (m_hooks.cancelDrain) {
+            m_hooks.cancelDrain();
+        }
+        if (finished) {
+            finished(false, {});
+        }
+        return true;
+    }
+
+  private:
+    void step(MixpiMediaPage::Step value) {
+        if (progress) {
+            progress(value);
+        }
+    }
+
+    void poll() {
+        if (!m_running || m_unmounting) {
+            return;
+        }
+        if (m_hooks.drainIdle && m_hooks.drainIdle()) {
+            m_poll.stop();
+            m_unmounting = true;
+            step(MixpiMediaPage::Step::Unmount);
+            unmountNext(0);
+            return;
+        }
+        if (m_hooks.now() - m_started >= kDrainMs) {
+            fail();
+        }
+    }
+
+    void unmountNext(int index) {
+        if (index >= m_volumes.size()) {
+            for (const auto& volume : std::as_const(m_volumes)) {
+                if (!m_hooks.stillMounted || m_hooks.stillMounted(volume.device)) {
+                    fail();
+                    return;
+                }
+            }
+            if (!m_hooks.retire || !m_hooks.retire()) {
+                fail();
+                return;
+            }
+            stop();
+            step(MixpiMediaPage::Step::Done);
+            if (finished) {
+                finished(true, {});
+            }
+            return;
+        }
+        if (!m_hooks.unmount) {
+            fail();
+            return;
+        }
+        const QPointer<MixpiEjectEngine> guard(this);
+        m_hooks.unmount(m_volumes[index].source, [guard, index](bool ok) {
+            if (!guard || !guard->m_running) {
+                return;
+            }
+            if (!ok) {
+                guard->fail();
+                return;
+            }
+            guard->unmountNext(index + 1);
+        });
+    }
+
+    void stop() {
+        m_poll.stop();
+        m_running = false;
+        m_unmounting = false;
+    }
+
+    void fail() {
+        stop();
+        if (m_hooks.cancelDrain) {
+            m_hooks.cancelDrain();
+        }
+        if (finished) {
+            finished(false, kFailure);
+        }
+    }
+
+    Hooks m_hooks;
+    QList<Volume> m_volumes;
+    QTimer m_poll;
+    qint64 m_started = 0;
+    bool m_running = false;
+    bool m_unmounting = false;
+};
