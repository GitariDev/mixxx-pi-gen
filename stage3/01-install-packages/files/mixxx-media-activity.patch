diff --git a/src/library/mixpimediaactivity.h b/src/library/mixpimediaactivity.h
new file mode 100644
--- /dev/null
+++ b/src/library/mixpimediaactivity.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include <QString>
+#include <QStringList>
+
+#include "library/media/mediauseregistry.h"
+
+namespace mixxx::media {
+
+inline QString activityText(const MediaUseRegistry::Snapshot& snapshot) {
+    const char* names[] = {"Loading", "Audio", "Analysis", "Import", "Discovery",
+            "Browsing", "Metadata", "Recording", "Copy/check"};
+    static_assert(sizeof(names) / sizeof(*names) == static_cast<std::size_t>(Producer::Count));
+    QStringList states;
+    if (snapshot.draining) {
+        states.append(QStringLiteral("Release requested"));
+    }
+    bool unresolved = false;
+    for (std::size_t index = 0; index < snapshot.users.size(); ++index) {
+        if (snapshot.users[index]) {
+            states.append(QString::fromLatin1(names[index]) + QStringLiteral(": ") +
+                    QString::number(static_cast<qulonglong>(snapshot.users[index])));
+        }
+        unresolved = unresolved || snapshot.unknown[index] != 0;
+    }
+    if (unresolved) {
+        states.append(QStringLiteral("Unresolved media use"));
+    }
+    return states.isEmpty() ? QStringLiteral("No tracked use; not eject clearance") :
+            states.join(QStringLiteral(" / "));
+}
+
+}
