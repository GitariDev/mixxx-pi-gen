+int WTrackTableViewHeader::stretchColumnIndex() {
+    auto* trackModel = getTrackModel();
+    if (!trackModel) {
+        return -1;
+    }
+    const int column = trackModel->fieldIndex(QStringLiteral("title"));
+    if (column >= 0) {
+        return column;
+    }
+    // Browse models have no SQL field names.
+    return trackModel->columnIndexFromSortColumnId(TrackModel::SortColumnId::Filename);
+}
+
+void WTrackTableViewHeader::updateStretchColumn() {
+    if (m_updatingStretch) {
+        // Resizing the column can resize this header (the table lays out
+        // again). Run once more with the new width instead of dropping it.
+        m_stretchPending = true;
+        return;
+    }
+    m_updatingStretch = true;
+    int passes = 0;
+    do {
+        m_stretchPending = false;
+        LibraryInterface::stretchColumn(this, stretchColumnIndex());
+    } while (m_stretchPending && ++passes < 4);
+    m_updatingStretch = false;
+}
+
+void WTrackTableViewHeader::updateGeometries() {
+    QHeaderView::updateGeometries();
+    updateStretchColumn();
 }
 
