 #include <QDoubleSpinBox>
 #include <QItemEditorCreatorBase>
 #include <QItemEditorFactory>
@@ -42,3 +43,33 @@ BPMDelegate::BPMDelegate(QTableView* pTableView)
 #endif
     setItemEditorFactory(m_pFactory);
