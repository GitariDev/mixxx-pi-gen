+bool Library::groupedSources() const {
+    return m_pSidebarWidget && m_pSidebarWidget->hasSourceScreen();
+}
+
+QStringList Library::sourceGroupOrder() const {
+    return SourceOrder::present(SourceOrder::decode(m_pConfig->getValueString(
+                                        ConfigKey(kConfigGroup, "SourceGroupOrder"))),
+            LibraryInterface::SourceGroups::defaultOrder());
+}
+
+bool Library::sourceGroupVisible(const QString& tile) const {
+    if (LibraryInterface::SourceGroups::hasOwnSetting(tile)) {
+        return m_pConfig->getValue(ConfigKey(kConfigGroup,
+                                           LibraryInterface::SourceGroups::settingName(tile)),
+                true);
+    }
+    // A tile that is one source: that source's own setting.
+    for (const auto& source : m_sidebarSources) {
+        if (source.id == tile) {
+            return m_pConfig->getValue(source.preference, true);
+        }
+    }
+    return false;
+}
+
+void Library::mapSourceGroups() {
+    namespace Groups = LibraryInterface::SourceGroups;
+    const ConfigKey mapped(kConfigGroup, "SourceGroupsMapped");
+    if (m_pConfig->getValue(mapped, false)) {
+        return;
+    }
+    // The owner's per-source choices, once: a tile whose sources are all
+    // hidden starts hidden.
+    auto shown = [this](const QStringList& ids) {
+        for (const auto& source : std::as_const(m_sidebarSources)) {
+            if (ids.contains(source.id) && m_pConfig->getValue(source.preference, true)) {
+                return true;
+            }
+        }
+        return false;
+    };
+    m_pConfig->setValue(ConfigKey(kConfigGroup, Groups::settingName(Groups::kDrives)),
+            shown({QStringLiteral("RekordboxFeature"), Groups::kFolders}));
+    m_pConfig->setValue(ConfigKey(kConfigGroup, Groups::settingName(Groups::kThisPi)),
+            shown(Groups::thisPi()));
+    m_pConfig->setValue(ConfigKey(kConfigGroup, Groups::settingName(Groups::kSamples)),
+            shown({Groups::kFolders}));
+    // More shows only while one of its sources is on.
+    m_pConfig->setValue(ConfigKey(kConfigGroup, Groups::settingName(Groups::kMore)), true);
+    m_pConfig->setValue(mapped, true);
+}
+
+void Library::moveSourceGroup(const QString& tile, int direction) {
+    QStringList order = sourceGroupOrder();
+    const int from = order.indexOf(tile);
+    const int to = from + direction;
+    if (from < 0 || to < 0 || to >= order.size()) {
+        return;
+    }
+    order.move(from, to);
+    m_pConfig->setValue(ConfigKey(kConfigGroup, "SourceGroupOrder"), SourceOrder::encode(order));
+    m_pSidebarWidget->sourcesChanged();
+    refreshSidebarSourceEdit();
+}
+
+QList<LibraryInterface::SourceTile> Library::sourceGroupTiles() {
+    namespace Groups = LibraryInterface::SourceGroups;
+    QList<LibraryInterface::SourceTile> tiles;
+    auto icon = [](const QModelIndex& index) {
+        return index.data(Qt::DecorationRole).value<QIcon>();
+    };
+    // Every tile hidden (by hand-edited settings): show them all.
+    for (int pass = 0; pass < 2 && tiles.isEmpty(); ++pass) {
+        const bool all = pass == 1;
+        for (const auto& tile : sourceGroupOrder()) {
+            if (!all && !sourceGroupVisible(tile)) {
+                continue;
+            }
+            if (tile == Groups::kDrives) {
+                // One tile per open drive, in plug-in order.
+                const QModelIndex rekordbox = sourceRow(QStringLiteral("RekordboxFeature"));
+                for (const auto& drive : driveRows()) {
+                    const bool export_ = rekordbox.isValid() && drive.parent() == rekordbox;
+                    const QVariant data = drive.data(SidebarModel::DataRole);
+                    const QString path = QDir::cleanPath(
+                            export_ ? data.toList().value(0).toString() : data.toString());
+                    tiles.append({QStringLiteral("drive:") + path,
+                            export_ ? drive.data().toString() : QFileInfo(path).fileName(),
+                            export_ ? tr("USB drive · rekordbox") : tr("USB drive"),
+                            icon(drive.parent()), drive, {}});
+                }
+            } else if (tile == Groups::kThisPi || tile == Groups::kMore) {
+                // A set of top-level sources, each still shown or hidden by
+                // its own switch.
+                QList<QPersistentModelIndex> rows;
+                QStringList names;
+                QStringList ids;
+                if (tile == Groups::kThisPi) {
+                    ids = Groups::thisPi();
+                } else {
+                    for (const auto& source : std::as_const(m_sidebarSources)) {
+                        if (Groups::inMore(source.id)) {
+                            ids.append(source.id);
+                        }
+                    }
+                }
+                for (const auto& id : std::as_const(ids)) {
+                    const QModelIndex row = sourceRow(id);
+                    if (row.isValid() && !m_pSidebarWidget->isSourceRowHidden(row.row())) {
+                        rows.append(row);
+                        names.append(row.data().toString());
+                    }
+                }
+                if (rows.isEmpty()) {
+                    continue;
+                }
+                tiles.append({tile, tile == Groups::kThisPi ? tr("This Pi") : tr("More"),
+                        names.join(QStringLiteral(" · ")), icon(rows.first()), {}, rows});
+            } else if (tile == Groups::kSamples) {
+                const QModelIndex samples = LibraryInterface::locatePlace(m_pSidebarModel,
+                        sampleSourcePlace(LibraryInterface::SampleBrowser::kSamples),
+                        SidebarModel::DataRole);
+                if (samples.isValid()) {
+                    tiles.append({tile, tr("Samples"), tr("Sounds for the pads"),
+                            icon(samples.parent()), samples, {}});
+                }
+            } else {
+                const QModelIndex row = sourceRow(tile);
+                if (!row.isValid()) {
+                    continue;
+                }
+                const QString name = tile == Groups::kFolders ? tr("Folders")
+                        : tile == Groups::kHistory           ? tr("History")
+                                                             : tr("Recordings");
+                const QString subline = tile == Groups::kFolders ? tr("Browse files and drives")
+                        : tile == Groups::kHistory              ? tr("Played tracks by date")
+                                                                : tr("Your recorded sets");
+                tiles.append({tile, name, subline, icon(row), row, {}});
+            }
+        }
+    }
+    return tiles;
+}
