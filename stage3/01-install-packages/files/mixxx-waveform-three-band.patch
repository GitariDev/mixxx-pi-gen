     return mainWaveform ? pregain * kMainWaveformGain : totalGain;
 }
 
+/// MixPi three-band waveforms (owner, 2026-11-23: A Overlay, Mixxx's
+/// all-shader Filtered renderer): whether that renderer asks
+/// WaveformWidgetRenderer::getGain for Mixxx's doubled height. Mixxx always
+/// does. On MixPi the three-band waveform does not, on a main row or in the
+/// Loop panel (owner, 2026-11-23: "Same height as RGB"): its tallest band
+/// draws at the height of the RGB outline there, kMainWaveformGain of the
+/// edge on a main row and total_gain in the Loop panel. Doubled, a band would
+/// sit on the edge in about a quarter of a typical track's columns on a main
+/// row. The Stacked type (the same renderer class) and every other renderer
+/// are as in Mixxx.
+inline bool filteredHeightCompensation(bool rgbStacked) {
+    return rgbStacked;
+}
+
 } // namespace mixpi
