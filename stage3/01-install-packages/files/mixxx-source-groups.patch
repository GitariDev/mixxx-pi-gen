+const LibraryInterface::SourceTile* WLibrarySidebar::selectedTile() const {
+    for (const auto& tile : m_groupedTiles) {
+        if (!m_selectedTile.isEmpty() && tile.id == m_selectedTile) {
+            return &tile;
+        }
+    }
+    return nullptr;
