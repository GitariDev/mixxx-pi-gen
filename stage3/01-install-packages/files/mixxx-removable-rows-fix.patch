     // Removable Devices drops the drives no longer mounted.
+    // J11: only rows that were a drive's mount point; a plain folder stays.
     QString releaseGoneFolder();
 
   public slots:
@@ -100,4 +101,8 @@ class BrowseFeature : public LibraryFeature {
     // held it then.
     QString m_shownFolder;
     QString m_shownMount;
+    // J11: the mount points when the mount table was last read
+    // (releaseGoneFolder). Removable Devices drops a row only when it was one
+    // of them and is not mounted now.
+    QStringList m_seenMounts;
 };
