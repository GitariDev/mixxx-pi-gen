+// Where the track menu opens when the Actions control (the skin's
+// LibraryActionsButton) asks for it: just under the nearest visible button.
+inline QPoint actionsMenuPosition(QWidget* view, QPoint fallback) {
+    for (auto* ancestor = view->parentWidget(); ancestor; ancestor = ancestor->parentWidget()) {
+        const auto buttons = ancestor->findChildren<QWidget*>(
+                QStringLiteral("LibraryActionsButton"));
+        for (auto* button : buttons) {
+            if (button->isVisible()) {
+                return button->mapToGlobal(QPoint(0, button->height()));
+            }
+        }
+    }
+    return fallback;
+}
