+
+void WLibrarySidebar::edgeShownDriveTracks() {
+    // Acceptance M 38-menu: ☰ opened inside "GANDER1 › rekordbox" with no row
+    // edged. The place (the root, m_menuInside) is kept apart from the current
+    // row, and the current row can go while the place stays: a focus-in
+    // (clearCurrentIndex), or a model reset (rebuildSourceRail enters the
+    // drive again with nothing current). Only selectShownDriveTracks set it.
+    // Now, on ☰ at the drive's own level, when no row of that level is
+    // current (and no row of another source), the drive's Tracks row is: the
+    // row J5 edges. The table is not changed (nothing is activated).
+    if (!m_sourceScreen || !m_menuInside || !groupedTiles || !m_touchNavigation ||
+            m_sourcesEditing || !model() || !selectionModel()) {
+        return;
+    }
+    const auto* pTile = selectedTile();
+    if (!pTile || !pTile->id.startsWith(QStringLiteral("drive:")) || !pTile->node.isValid() ||
+            rootIndex() != pTile->node) {
+        return;
+    }
+    const QModelIndex current = currentIndex();
+    if (current.isValid() && current.parent() == rootIndex() &&
+            !isRowHidden(current.row(), rootIndex())) {
+        // A row in view has the edge.
+        return;
+    }
+    if (current.isValid() && tileOf(current) != pTile->id) {
+        // Tracks shows another source's list.
+        return;
+    }
+    // The drive's Tracks row: the child with the drive's own path first in
+    // its data list (RekordboxFeature's driveTracksRow). A folder drive's
+    // rows hold a plain path (Qt would read a string as a list of its
+    // characters), and it has no such row.
+    auto pathOf = [](const QModelIndex& index) {
+        const QVariant data = index.data(SidebarModel::DataRole);
+        return data.userType() == QMetaType::QString ? QString() : data.toList().value(0).toString();
+    };
+    const QModelIndex node = pTile->node;
+    const QString path = pathOf(node);
+    if (path.isEmpty()) {
+        return;
+    }
+    for (int row = 0; row < model()->rowCount(node); ++row) {
+        const QModelIndex child = model()->index(row, 0, node);
+        if (!isRowHidden(row, node) && pathOf(child) == path) {
+            selectionModel()->setCurrentIndex(child,
+                    QItemSelectionModel::ClearAndSelect | QItemSelectionModel::Rows);
+            updateSourceChrome();
+            return;
+        }
+    }
+}
