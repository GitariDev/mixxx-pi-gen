+        m_sourcesEditPanel->setGeometry(rect());
+    } else {
+        // Full width under the top bar (m-sources-edit.png).
+        const int top = LibraryInterface::kSourceEditTopBar;
+        m_sourcesEditPanel->setGeometry(0, top, pHost->width(), std::max(0, pHost->height() - top));
+    }
+    if (m_sourcesEditing) {
+        m_sourcesEditPanel->raise();
+    }
 }
 
