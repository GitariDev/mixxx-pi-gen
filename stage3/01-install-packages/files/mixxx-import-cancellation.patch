diff --git a/src/library/rekordbox/importoperation.h b/src/library/rekordbox/importoperation.h
new file mode 100644
--- /dev/null
+++ b/src/library/rekordbox/importoperation.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include <atomic>
+#include <stdexcept>
+
+namespace mixxx::rekordbox {
+
+class ImportOperation final {
+  public:
+    void cancel() { m_cancelled.store(true); }
+    bool cancelled() const { return m_cancelled.load(); }
+    void checkpoint() const {
+        if (cancelled()) {
+            throw std::runtime_error("Rekordbox import cancelled");
+        }
+    }
+
+    bool finished = false;
+    bool succeeded = false;
+    bool showOnFinish = true;
+
+  private:
+    std::atomic<bool> m_cancelled{false};
+};
+
+}
