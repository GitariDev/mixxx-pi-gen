+#include <sys/un.h>
+#include <unistd.h>
+#endif
+
+class MixpiControlledMedia final : public QObject {
+  public:
+    enum class State { Unavailable, Inventory, Waiting, Preparing, Ready, Committing,
+        Mounted, Cancelled, Safe, Unknown, Quarantined };
+
+    explicit MixpiControlledMedia(int descriptor, QObject* owner, int deadlineMs = 5000)
+            : QObject(owner), m_descriptor(descriptor), m_deadlineMs(deadlineMs) {
+#ifdef __linux__
+        if (descriptor < 0) {
+            return;
+        }
+        if (fcntl(descriptor, F_SETFL, fcntl(descriptor, F_GETFL) | O_NONBLOCK) < 0) {
+            ::close(m_descriptor);
+            m_descriptor = -1;
+            return;
+        }
+        m_reader = new QSocketNotifier(descriptor, QSocketNotifier::Read, this);
+        connect(m_reader, &QSocketNotifier::activated, this, [this] { receive(); });
+        m_deadline = new QTimer(this);
+        m_deadline->setSingleShot(true);
+        connect(m_deadline, &QTimer::timeout, this, [this] {
+            m_message = tr("Reply overdue; outcome pending. Keep drive connected. This does not interrupt kernel work.");
+        });
+        m_poll = new QTimer(this);
+        m_poll->setSingleShot(true);
+        connect(m_poll, &QTimer::timeout, this, [this] { send(m_cancelRequested ? "cancel" : "poll"); });
+        m_state = State::Inventory;
+        refresh();
+#endif
+    }
+
+    ~MixpiControlledMedia() override {
+#ifdef __linux__
+        if (m_descriptor >= 0) {
+            ::close(m_descriptor);
+        }
+#endif
+    }
+
+    static MixpiControlledMedia* openProduction() {
+        int descriptor = -1;
+#ifdef __linux__
+        bool trusted = true;
+        for (const char* path : {"/etc/mixpi/controlled-media", "/etc/mixpi/eject-reviewed"}) {
+            struct stat metadata{};
+            QFile file(QString::fromUtf8(path));
+            trusted = trusted && ::lstat(path, &metadata) == 0 && S_ISREG(metadata.st_mode) &&
+                    metadata.st_uid == 0 && !(metadata.st_mode & 0022) &&
+                    file.open(QIODevice::ReadOnly) && file.readAll() == "v1\n";
+        }
+        struct stat directory{};
+        trusted = trusted && ::lstat("/run/mixpi-mount", &directory) == 0 &&
+                S_ISDIR(directory.st_mode) && directory.st_uid == 0 && !(directory.st_mode & 0022);
+        if (trusted) {
+            descriptor = ::socket(AF_UNIX, SOCK_SEQPACKET | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+            sockaddr_un address{};
+            address.sun_family = AF_UNIX;
+            const QByteArray endpoint("/run/mixpi-mount/control");
+            std::copy(endpoint.begin(), endpoint.end(), address.sun_path);
+            struct ucred credentials{};
+            socklen_t size = sizeof(credentials);
+            if (descriptor >= 0 && (::connect(descriptor, reinterpret_cast<sockaddr*>(&address), sizeof(address)) != 0 ||
+                    ::getsockopt(descriptor, SOL_SOCKET, SO_PEERCRED, &credentials, &size) != 0 ||
+                    size != sizeof(credentials) || credentials.uid != 0)) {
+                ::close(descriptor);
+                descriptor = -1;
+            }
+        }
+#endif
+        return new MixpiControlledMedia(descriptor, QCoreApplication::instance());
+    }
+
+    static bool validToken(const QString& token) {
+        if (token.size() != 64) {
+            return false;
+        }
+        for (const auto character : token) {
+            if (!QStringLiteral("0123456789abcdef").contains(character)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    static QJsonObject resolve(const QJsonArray& drives, const QString& token) {
+        QJsonObject selected;
+        if (!validToken(token)) {
+            return {};
+        }
+        for (const auto& value : drives) {
+            const auto drive = value.toObject();
+            if (drive.value("token").toString() == token) {
+                if (!selected.isEmpty()) {
+                    return {};
+                }
+                selected = drive;
+            }
+        }
+        return selected;
+    }
+
+    static QString description(const QJsonObject& drive) {
+        QStringList volumes;
+        for (const auto& value : drive.value("volumes").toArray()) {
+            const auto volume = value.toObject();
+            volumes.append(volume.value("label").toString() + " — " + volume.value("discriminator").toString());
+        }
+        return tr("Physical USB %1 · generation %2\n%3")
+                .arg(drive.value("device").toString(), drive.value("diskseq").toString(),
+                        volumes.isEmpty() ? tr("No mounted volumes — controlled mount required") : volumes.join("\n"));
+    }
+
+    State state() const { return m_state; }
+    QString message() const { return m_message; }
+    QString selectedDescription() const { return m_selectedDescription; }
+    QJsonArray drives() const { return m_drives; }
+    bool pending() const { return !m_request.isEmpty(); }
+    void setCompletionHandler(QObject* owner, std::function<void()> callback) {
+        m_completionOwner = owner;
+        m_completionCallback = std::move(callback);
+    }
+    bool locked() const {
+        return m_started && m_state != State::Mounted && m_state != State::Cancelled && m_state != State::Safe;
+    }
+    bool canCancel() const {
+        return m_eject && locked() && !m_cutoff && m_state != State::Unknown && m_state != State::Quarantined;
+    }
+    void refresh() {
+        if (locked() || pending() || m_descriptor < 0 || m_state == State::Unknown) {
+            return;
+        }
+        m_drives = {};
+        m_started = false;
+        m_selectedDescription.clear();
+        send("list");
+    }
+    void begin(const QString& token, bool eject) {
+        if (m_state != State::Inventory || pending()) {
+            return;
+        }
+        const auto selected = resolve(m_drives, token);
+        if (selected.isEmpty() || (!eject && !selected.value("volumes").toArray().isEmpty())) {
+            m_message = tr("Selection invalidated; refresh and choose the physical disk again.");
+            return;
+        }
+        m_token = token;
+        m_selectedDescription = description(selected);
+        m_started = true;
+        m_eject = eject;
+        m_cutoff = false;
+        m_commitAcknowledged = false;
+        m_cancelRequested = false;
+        m_drives = {};
+        send(eject ? "eject" : "mount");
+    }
+    void cancel() {
+        if (!canCancel()) {
+            return;
+        }
+        m_cancelRequested = true;
+        m_message = tr("Cancellation requested; awaiting broker acknowledgement. Keep drive connected.");
+        if (!pending()) {
+            m_poll->stop();
+            send("cancel");
+        }
+    }
+    void commit() {
+        if (m_state != State::Ready || pending() || m_cancelRequested || m_cutoff) {
+            return;
+        }
+        m_cutoff = true;
+        send("commit");
+    }
+
+  private:
+    void notifyCompletion() {
+        if (m_completionOwner && m_completionCallback) {
+            QTimer::singleShot(0, m_completionOwner.data(), m_completionCallback);
+        }
+    }
+    void unknown(const QString& reason) {
+        m_state = State::Unknown;
+        m_message = reason + tr(" Outcome unknown; keep drive connected. Recovery review required.");
+        if (m_reader) {
+            m_reader->setEnabled(false);
+            m_deadline->stop();
+            m_poll->stop();
+        }
+    }
+    void send(const QString& operation) {
+#ifdef __linux__
+        if (pending() || m_descriptor < 0) {
+            return;
+        }
+        const auto bytes = QJsonDocument(QJsonObject{{"op", operation}, {"token", m_token}}).toJson(QJsonDocument::Compact);
+        m_request = operation;
+        m_state = operation == "commit" ? State::Committing : State::Waiting;
+        m_message = operation == "list" ? tr("Observing controlled physical USB disks…") :
+                operation == "mount" ? tr("Mount pending; keep drive connected.") :
+                operation == "commit" ? tr("Irreversible cutoff sent; cancellation is no longer guaranteed. Keep drive connected.") :
+                operation == "cancel" ? tr("Awaiting cancellation acknowledgement; keep drive connected.") :
+                m_cutoff ? tr("Past irreversible cutoff; unmount pending. Keep drive connected.") :
+                tr("Draining / busy; preparation remains cancellable. Keep drive connected.");
+        if (::send(m_descriptor, bytes.constData(), bytes.size(), MSG_NOSIGNAL | MSG_DONTWAIT) != bytes.size()) {
+            unknown(tr("Broker request could not be delivered."));
+            return;
+        }
+        m_deadline->start(m_deadlineMs);
+#else
+        Q_UNUSED(operation);
+#endif
+    }
+    void receive() {
+#ifdef __linux__
+        char buffer[65536];
+        const auto size = ::recv(m_descriptor, buffer, sizeof(buffer), MSG_DONTWAIT | MSG_TRUNC);
+        if (size < 0 && (errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR)) {
+            return;
+        }
+        if (size <= 0 || size >= static_cast<ssize_t>(sizeof(buffer)) || !pending()) {
+            unknown(tr("Broker disconnected or sent an unexpected reply."));
+            return;
+        }
+        const auto document = QJsonDocument::fromJson(QByteArray(buffer, size));
+        const auto answer = document.object();
+        const auto status = answer.value("status").toString();
+        const auto request = m_request;
+        m_request.clear();
+        m_deadline->stop();
+        if (!document.isObject() || !answer.value("safe").isBool()) {
+            unknown(tr("Invalid broker reply."));
+            return;
+        }
+        if (request == "poll" && m_eject && m_cutoff && m_commitAcknowledged &&
+                status == "unmounted" && answer.value("safe").toBool() &&
+                answer.contains("token") && answer.value("token").isNull() &&
+                answer.value("removed").isArray() && !answer.value("removed").toArray().isEmpty()) {
+            QSet<int> removed;
+            for (const auto& value : answer.value("removed").toArray()) {
+                const int mount = value.toInt(-1);
+                if (mount <= 0 || value.toDouble() != mount || removed.contains(mount)) {
+                    unknown(tr("Invalid completion proof."));
+                    return;
+                }
+                removed.insert(mount);
+            }
+            m_state = State::Safe;
+            m_message = tr("Broker verified safe to remove ONLY this selected physical drive.");
+            notifyCompletion();
+            return;
+        }
+        if (answer.value("safe").toBool()) {
+            unknown(tr("Unexpected safe-removal claim rejected."));
+            return;
+        }
+        if (request == "list" && status == "inventory" && answer.value("drives").isArray()) {
+            m_drives = answer.value("drives").toArray();
+            QSet<QString> tokens;
+            for (const auto& value : m_drives) {
+                const auto drive = value.toObject();
+                const auto token = drive.value("token").toString();
+                if (!validToken(token) || tokens.contains(token) || drive.value("device").toString().isEmpty() ||
+                        drive.value("diskseq").toString().isEmpty() || !drive.value("volumes").isArray()) {
+                    m_drives = {};
+                    unknown(tr("Ambiguous physical inventory."));
+                    return;
+                }
+                tokens.insert(token);
+            }
+            m_state = State::Inventory;
+            m_message = tr("Choose one physical disk explicitly. The broker revalidates its exact token.");
+        } else if (request == "mount" && status == "mounted" && validToken(answer.value("token").toString()) &&
+                answer.value("token").toString() != m_token) {
+            m_state = State::Mounted;
+            m_message = tr("Mounted. Refresh LOAD and explicitly choose a fresh volume; nothing was imported.");
+            notifyCompletion();
+        } else if (request == "cancel" && status == "cancelled" && !m_cutoff) {
+            m_state = State::Cancelled;
+            m_message = tr("Cancellation acknowledged. Drive remains mounted; NOT safe to remove.");
+        } else if (request == "commit" && status == "committing" && m_cutoff) {
+            m_commitAcknowledged = true;
+            m_state = State::Committing;
+            m_message = tr("Cutoff acknowledged. Unmount pending; keep drive connected.");
+            m_poll->start(0);
+        } else if ((request == "eject" && status == "draining") ||
+                (request == "poll" && status == "busy")) {
+            m_state = m_cutoff ? State::Committing : State::Preparing;
+            m_poll->start(250);
+        } else if (request == "poll" && status == "ready" && !m_cutoff && answer.value("cancellable").toBool()) {
+            m_state = State::Ready;
+            m_message = tr("Ready. Cancel preparation, or explicitly accept the irreversible cutoff to eject.");
+            if (m_cancelRequested) {
+                send("cancel");
+            }
+        } else if (status == "quarantined") {
+            m_state = State::Quarantined;
+            m_message = tr("Broker quarantined this operation. Keep drive connected; recovery review required.");
+        } else {
+            unknown(status == "too-late" ? tr("Cancellation too late.") :
+                    tr("Broker unavailable, refused, or incompatible: %1").arg(answer.value("error").toString()));
+        }
+#endif
+    }
+
+    int m_descriptor = -1;
+    int m_deadlineMs;
+    QSocketNotifier* m_reader = nullptr;
+    QTimer* m_deadline = nullptr;
+    QTimer* m_poll = nullptr;
+    State m_state = State::Unavailable;
+    QString m_message = tr("Controlled media unavailable: reviewed profile/service required. Keep drive connected.");
+    QString m_request;
+    QString m_token;
+    QString m_selectedDescription;
+    QJsonArray m_drives;
+    QPointer<QObject> m_completionOwner;
+    std::function<void()> m_completionCallback;
+    bool m_started = false;
+    bool m_eject = false;
+    bool m_cutoff = false;
+    bool m_commitAcknowledged = false;
+    bool m_cancelRequested = false;
+};
diff --git a/src/library/mixpicontrolleddialog.h b/src/library/mixpicontrolleddialog.h
new file mode 100644
--- /dev/null
+++ b/src/library/mixpicontrolleddialog.h
@@ -0,0 +1,118 @@
+#pragma once
+
+#include <QDialog>
+#include <QHBoxLayout>
+#include <QLabel>
+#include <QListWidget>
+#include <QPointer>
+#include <QPushButton>
+#include <QVBoxLayout>
+
+#include "library/mixpicontrolledmedia.h"
+
+class MixpiControlledDialog final : public QDialog {
+  public:
+    MixpiControlledDialog(MixpiControlledMedia* operation, bool mount, QWidget* parent)
+            : QDialog(parent), m_operation(operation), m_mount(mount) {
+        setAttribute(Qt::WA_DeleteOnClose);
+        setWindowModality(Qt::WindowModal);
+        setWindowTitle(mount ? tr("LOAD — mount a physical USB disk") : tr("EJECT — one physical USB disk"));
+        resize(740, 380);
+        auto* layout = new QVBoxLayout(this);
+        m_status = new QLabel(this);
+        m_status->setTextFormat(Qt::PlainText);
+        m_status->setWordWrap(true);
+        layout->addWidget(m_status);
+        m_list = new QListWidget(this);
+        m_list->setObjectName("physicalDisks");
+        layout->addWidget(m_list);
+        auto* actions = new QHBoxLayout;
+        m_refresh = new QPushButton(tr("Refresh"), this);
+        m_begin = new QPushButton(mount ? tr("Mount selected disk") : tr("Prepare selected disk"), this);
+        m_cancel = new QPushButton(tr("Cancel preparation"), this);
+        m_commit = new QPushButton(tr("Eject irreversibly"), this);
+        m_volumes = new QPushButton(tr("Choose fresh volume"), this);
+        auto* close = new QPushButton(tr("Close"), this);
+        for (auto* button : {m_refresh, m_begin, m_cancel, m_commit, m_volumes, close}) {
+            button->setAutoDefault(false);
+            button->setMinimumHeight(44);
+            actions->addWidget(button);
+        }
+        layout->addLayout(actions);
+        connect(close, &QPushButton::clicked, this, &QDialog::reject);
+        connect(m_refresh, &QPushButton::clicked, this, [this] {
+            m_list->clear();
+            m_inventory = {};
+            m_operation->refresh();
+            update();
+        });
+        connect(m_begin, &QPushButton::clicked, this, [this] {
+            if (m_list->currentItem()) {
+                const auto token = m_list->currentItem()->data(Qt::UserRole).toString();
+                m_list->clear();
+                m_operation->begin(token, !m_mount);
+                update();
+            }
+        });
+        connect(m_cancel, &QPushButton::clicked, this, [this] { m_operation->cancel(); update(); });
+        connect(m_commit, &QPushButton::clicked, this, [this] { m_operation->commit(); update(); });
+        connect(m_volumes, &QPushButton::clicked, this, &QDialog::accept);
+        connect(m_list, &QListWidget::currentItemChanged, this, [this] { updateActions(); });
+        auto* timer = new QTimer(this);
+        connect(timer, &QTimer::timeout, this, [this] { update(); });
+        timer->start(50);
+        update();
+    }
+
+  private:
+    void updateActions() {
+        const bool inventory = m_operation->state() == MixpiControlledMedia::State::Inventory && !m_operation->pending();
+        m_begin->setEnabled(inventory && m_list->currentItem());
+        m_begin->setVisible(!m_operation->locked());
+        m_list->setEnabled(inventory);
+        m_refresh->setEnabled(!m_operation->locked() && !m_operation->pending() &&
+                m_operation->state() != MixpiControlledMedia::State::Unknown &&
+                m_operation->state() != MixpiControlledMedia::State::Unavailable);
+        m_cancel->setVisible(m_operation->canCancel());
+        m_cancel->setEnabled(m_operation->canCancel());
+        m_commit->setVisible(m_operation->state() == MixpiControlledMedia::State::Ready);
+        m_commit->setEnabled(m_operation->state() == MixpiControlledMedia::State::Ready && !m_operation->pending());
+        m_volumes->setVisible(m_operation->state() == MixpiControlledMedia::State::Mounted);
+    }
+    void update() {
+        auto message = m_operation->message();
+        if (!m_operation->selectedDescription().isEmpty()) {
+            message = m_operation->selectedDescription() + "\n" + message;
+        }
+        if (m_operation->locked()) {
+            message += tr("\nClosing this window does NOT cancel. Reopen LOAD/EJECT to check the retained operation.");
+        }
+        m_status->setText(message);
+        const auto inventory = m_operation->drives();
+        if (inventory != m_inventory) {
+            m_inventory = inventory;
+            m_list->clear();
+            for (const auto& value : inventory) {
+                const auto drive = value.toObject();
+                if (m_mount && !drive.value("volumes").toArray().isEmpty()) {
+                    continue;
+                }
+                auto* item = new QListWidgetItem(MixpiControlledMedia::description(drive), m_list);
+                item->setData(Qt::UserRole, drive.value("token").toString());
+            }
+            m_list->setCurrentRow(-1);
+            m_list->clearSelection();
+        }
+        updateActions();
+    }
+    MixpiControlledMedia* m_operation;
+    bool m_mount;
+    QJsonArray m_inventory;
+    QLabel* m_status;
+    QListWidget* m_list;
+    QPushButton* m_refresh;
+    QPushButton* m_begin;
+    QPushButton* m_cancel;
+    QPushButton* m_commit;
+    QPushButton* m_volumes;
+};
