+void WLibrarySidebar::enableTouchNavigation() {
+    if (m_touchNavigation || !model()) {
+        return;
+    }
+    auto* sourceBack = ControlObject::getControl(ConfigKey("[Library]", "sidebar_back"));
+    m_sourceCanGoBack = ControlObject::getControl(ConfigKey("[Library]", "sidebar_can_go_back"));
+    VERIFY_OR_DEBUG_ASSERT(sourceBack && m_sourceCanGoBack) {
+        return;
+    }
+    m_sourceCanGoBack->set(0);
+    m_touchNavigation = new TouchSourceNavigation(this);
+    m_touchNavigation->requestChildren = [this](const QModelIndex& index) {
+        emit expanded(index);
+    };
+    m_touchNavigation->changed = [this](bool canGoBack) {
+        m_sourceCanGoBack->set(canGoBack ? 1 : 0);
+    };
+    sourceBack->connectValueChangeRequest(this, [this](double value) {
+        if (value > 0) {
+            m_touchNavigation->back();
+        }
+    });
+}
+
+void WLibrarySidebar::returnToSourceRoot() {
+    if (m_touchNavigation) {
+        m_touchNavigation->home();
+    }
+}
