+
+namespace {
+
+// Set by WLibrarySidebar::enableTouchNavigation() for the skin's lifetime.
+bool touchSkin() {
+    return QCoreApplication::instance() &&
+            QCoreApplication::instance()->property("mixpiTouchNavigation").toBool();
+}
+
+} // namespace
+
+bool BPMDelegate::editorEvent(QEvent* event,
+        QAbstractItemModel* model,
+        const QStyleOptionViewItem& option,
+        const QModelIndex& index) {
+    // QStyledItemDelegate::editorEvent() toggles the check state (bpm_lock)
+    // on a release inside the check indicator, hit-tested with the table's
+    // style, and on Space/Select. Hiding the indicator in QSS cannot stop it.
+    if (touchSkin()) {
+        return false;
+    }
+    return CheckboxDelegate::editorEvent(event, model, option, index);
+}
+
+void BPMDelegate::initStyleOption(QStyleOptionViewItem* option, const QModelIndex& index) const {
+    CheckboxDelegate::initStyleOption(option, index);
+    if (touchSkin()) {
+        option->features &= ~QStyleOptionViewItem::HasCheckIndicator;
+    }
+}
