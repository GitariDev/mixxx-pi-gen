         return Drain(m_state, generation, ++entry.epoch);
     }
 
+    // Spec 2h: OPEN on the drive's SAFE TO REMOVE row mounted the same
+    // physical drive again (no re-plug), so its retired generation takes
+    // reads again, as a new round. Only a retired generation that is not
+    // draining reopens; every other generation is left alone.
+    bool reopen(const std::string& generation) {
+        if (generation.empty()) {
+            return false;
+        }
+        std::lock_guard<std::mutex> lock(m_state->mutex);
+        const auto entry = m_state->entries.find(generation);
+        if (entry == m_state->entries.end() || !entry->second.retired || entry->second.draining) {
+            return false;
+        }
+        entry->second.retired = false;
+        ++entry->second.round;
+        return true;
+    }
+
+    bool retired(const std::string& generation) const {
+        std::lock_guard<std::mutex> lock(m_state->mutex);
+        const auto entry = m_state->entries.find(generation);
+        return entry != m_state->entries.end() && entry->second.retired;
+    }
+
+    std::uint64_t round(const std::string& generation) const {
+        std::lock_guard<std::mutex> lock(m_state->mutex);
+        const auto entry = m_state->entries.find(generation);
+        return entry == m_state->entries.end() ? 0 : entry->second.round;
+    }
+
   private:
     std::shared_ptr<State> m_state = std::make_shared<State>();
 };
