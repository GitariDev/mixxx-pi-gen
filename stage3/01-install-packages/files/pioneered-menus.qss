
/* MixxxPi: readable menus, including widgets inside the column selector.
 * QMenu::item alone does not style embedded QCheckBox/QLabel widgets. */
QMenuBar, QMenuBar::item, QMenu, QMenu::item {
    background-color: #17191f;
    color: #ffffff;
    font-size: 17px;
}
QMenu QWidget, QMenu QCheckBox, QMenu QLabel {
    background-color: #17191f;
    color: #ffffff;
    font-size: 17px;
}
/* Touch rows: content plus padding is at least 48 px for menu items and
 * for the checkbox rows inside choosers. */
QMenu::item { min-height: 32px; padding: 8px 28px 8px 12px; }
QMenu QCheckBox { min-height: 36px; padding: 6px; spacing: 8px; }
QMenuBar::item:selected, QMenuBar::item:pressed,
QMenu::item:selected, QMenu::item:pressed,
QMenu QCheckBox:hover, QMenu QCheckBox:focus {
    background-color: #285a88;
    color: #ffffff;
}
QMenu::item:disabled, QMenu QCheckBox:disabled, QMenu QLabel:disabled {
    color: #b5bac5;
}
QMenu::separator { height: 1px; background-color: #596171; margin: 4px; }
QMenu QCheckBox::indicator { width: 22px; height: 22px; }
QMenu QCheckBox::indicator:unchecked {
    background-color: #17191f;
    border: 2px solid #e5e6ea;
    border-radius: 3px;
}
QMenu QCheckBox::indicator:checked {
    background-color: #ffffff;
    border: 2px solid #68baff;
    border-radius: 3px;
}
/* Arrange columns dialog (#MixpiColumnArrangement): dark, 17 px text,
 * list rows and buttons at least 48 px, 28 px check boxes. The rules name
 * the dialog, its list and its buttons only, so the list's scroll bar keeps
 * the library scroll bar style. */
#MixpiColumnArrangement {
    background-color: #17191f;
    color: #ffffff;
    font-size: 17px;
}
#MixpiColumnArrangement QListWidget {
    background-color: #17191f;
    color: #ffffff;
    font-size: 17px;
    border: 1px solid #596171;
    outline: none;
}
/* The background makes the item rule drawable for every row. Without it,
 * Qt hands unselected rows to the base style, which lays the text out for
 * its own small indicator, so the 28 px box covered the first letters
 * (qstylesheetstyle.cpp CE_ItemViewItem, hasDrawable() branch; F-9). */
#MixpiColumnArrangement QListWidget::item {
    background-color: #17191f;
    min-height: 48px;
    padding: 0px 8px;
}
#MixpiColumnArrangement QListWidget::item:selected {
    background-color: #285a88;
    color: #ffffff;
}
#MixpiColumnArrangement QListWidget::indicator { width: 28px; height: 28px; }
#MixpiColumnArrangement QListWidget::indicator:unchecked {
    background-color: #17191f;
    border: 2px solid #e5e6ea;
    border-radius: 3px;
}
/* Checked: a white tick on blue. ic_checkmark.svg is Mixxx's own image,
 * built into the program (res/mixxx.qrc), so no file is added (F-9). */
#MixpiColumnArrangement QListWidget::indicator:checked {
    background-color: #1f7fd8;
    border: 2px solid #ffffff;
    border-radius: 3px;
    image: url(:/images/ic_checkmark.svg);
}
#MixpiColumnArrangement QPushButton {
    color: #ffffff;
    font-size: 17px;
    min-height: 48px;
    min-width: 96px;
    background-color: #2b3038;
    border: 1px solid #596171;
    border-radius: 4px;
    padding: 0px 12px;
}
#MixpiColumnArrangement QPushButton:pressed { background-color: #285a88; }
/* Sources screen (R-9): the rail of sources (264 px, 64 px tiles), Back
 * and the crumb above the list. The colours are the redesign prototype's. */
#MixpiSourceRail, #MixpiSourceTiles {
    background-color: #121821;
    border: 0px;
}
#MixpiSourceRail {
    border-right: 1px solid #2b3646;
}
#MixpiSourceRail QPushButton#MixpiSourceTile {
    background-color: #121821;
    border: 0px;
    border-bottom: 1px solid #2b3646;
    border-radius: 0px;
    padding: 0px;
}
#MixpiSourceRail QPushButton#MixpiSourceTile:checked {
    background-color: #1f2a17;
    border-left: 4px solid #b5e15c;
}
#MixpiSourceRail QPushButton#MixpiSourceTile:pressed { background-color: #19212d; }
#MixpiSourceTile QLabel { background-color: transparent; }
#MixpiSourceTile QLabel#MixpiSourceTileName {
    color: #eef2f7;
    font-size: 17px;
    font-weight: bold;
}
#MixpiSourceTile QLabel#MixpiSourceTileSub {
    color: #8c9ab0;
    font-size: 13px;
}
#MixpiSourceBar {
    background-color: #0a0d12;
    border-bottom: 1px solid #2b3646;
}
#MixpiSourceBar QPushButton#MixpiSourceBack {
    background-color: #19212d;
    border: 1px solid #2b3646;
    border-radius: 6px;
    color: #eef2f7;
    font-size: 16px;
    font-weight: bold;
}
#MixpiSourceBar QPushButton#MixpiSourceBack:pressed { background-color: #285a88; }
#MixpiSourceBar QPushButton#MixpiSourceBack:disabled {
    color: #596171;
    background-color: #0a0d12;
    border-color: #19212d;
}
#MixpiSourceBar QLabel#MixpiSourceCrumb {
    color: #eef2f7;
    font-size: 15px;
}
/* Sources edit (R-10): one list. 56 px rows; Up, Down and Start here are
 * 48 px; the on/off switch is 64x48 with a 56x32 track. */
#MixpiSourceEdit, #MixpiSourceEdit QScrollArea, #MixpiSourceEditRows,
#MixpiSourceEditFooter {
    background-color: #0a0d12;
    border: 0px;
}
#MixpiSourceEdit QLabel#MixpiSourceEditHint {
    background-color: #0a0d12;
    color: #8c9ab0;
    font-size: 13px;
    font-weight: bold;
    padding: 0px 12px;
    border-bottom: 1px solid #2b3646;
}
#MixpiSourceEdit #MixpiSourceEditRow {
    background-color: #0a0d12;
    border-bottom: 1px solid #1c2531;
}
#MixpiSourceEdit QPushButton {
    background-color: #19212d;
    border: 1px solid #2b3646;
    border-radius: 6px;
    color: #eef2f7;
    font-size: 15px;
    font-weight: bold;
}
#MixpiSourceEdit QPushButton:pressed { background-color: #285a88; }
#MixpiSourceEdit QPushButton:disabled {
    color: #596171;
    background-color: #0a0d12;
    border-color: #19212d;
}
#MixpiSourceEdit QPushButton#MixpiSourceEditName {
    background-color: #0a0d12;
    border: 0px;
    font-size: 17px;
    text-align: left;
    padding: 0px 14px;
}
#MixpiSourceEdit QPushButton#MixpiSourceEditName:checked {
    background-color: #1f2a17;
    border-left: 4px solid #b5e15c;
}
#MixpiSourceEdit QPushButton#MixpiSourceStartHere {
    font-size: 16px;
}
#MixpiSourceEdit QCheckBox#MixpiSourceEditSwitch {
    background-color: transparent;
    spacing: 0px;
    padding-left: 4px;
}
#MixpiSourceEditSwitch::indicator {
    width: 56px;
    height: 32px;
    border-radius: 16px;
    background-color: #222c3a;
    border: 1px solid #2b3646;
}
#MixpiSourceEditSwitch::indicator:checked {
    background-color: #b5e15c;
    border: 1px solid #b5e15c;
}
#MixpiSourceEditSwitch::indicator:disabled {
    background-color: #5a6e34;
    border-color: #5a6e34;
}
/* Media page (R-2, R-4): a full-screen native page under the top bar.
 * Palette of the redesign: page #0a0d12, panels #121821/#19212d, lines
 * #2b3646, text #eef2f7, dim #8c9ab0, accent lime #b5e15c, safe green
 * #43d17a, warning #ffb020. No text under 13 px; every button 48 px or more. */
#MixpiPage, #MixpiPageContent, #MixpiMediaDrives, #MixpiMediaDriveList {
    background-color: #0a0d12;
    color: #eef2f7;
    font-size: 16px;
}
#MixpiPageHeader {
    background-color: #121821;
    border-bottom: 1px solid #2b3646;
}
#MixpiPage QPushButton#MixpiPageClose {
    background-color: #19212d;
    color: #eef2f7;
    border: 1px solid #2b3646;
    border-radius: 0px;
    font-size: 22px;
}
#MixpiPage QLabel#MixpiPageTitle {
    color: #eef2f7;
    font-size: 21px;
    font-weight: bold;
}
#MixpiPage QLabel#MixpiPageHint { color: #8c9ab0; font-size: 14px; }
#MixpiMediaHandover {
    background-color: #121821;
    border-left: 1px solid #2b3646;
}
/* The handover column and the eject sheet's list scroll (council round 1). */
#MixpiMediaHandoverScroll { background-color: #121821; border: 0px; }
#MixpiEjectUsers, #MixpiEjectUserList { background-color: #121821; border: 0px; }
/* 24 px scroll bars on every Media page list, as in the library (R-9). */
#MixpiPage QScrollBar {
    background-color: #121821;
    border: 0px;
    margin: 0px;
}
#MixpiPage QScrollBar:vertical {
    width: 24px;
    border-left: 1px solid #2b3646;
}
#MixpiPage QScrollBar:horizontal { height: 24px; }
#MixpiPage QScrollBar::handle {
    background-color: #5d6b80;
    border: 5px solid #121821;
    border-radius: 8px;
}
#MixpiPage QScrollBar::handle:vertical { min-height: 56px; }
#MixpiPage QScrollBar::handle:pressed { background-color: #b5e15c; }
#MixpiPage QScrollBar::add-line, #MixpiPage QScrollBar::sub-line { height: 0px; width: 0px; }
#MixpiPage QScrollBar::add-page, #MixpiPage QScrollBar::sub-page { background-color: #121821; }
#MixpiPage QFrame#MixpiMediaCard {
    background-color: #121821;
    border: 1px solid #2b3646;
    border-radius: 10px;
}
#MixpiPage QLabel { background-color: transparent; color: #eef2f7; font-size: 15px; }
#MixpiPage QLabel#MixpiMediaName { font-size: 24px; font-weight: bold; }
#MixpiPage QLabel#MixpiMediaDetail, #MixpiPage QLabel#MixpiMediaNote,
#MixpiPage QLabel#MixpiMediaUse, #MixpiPage QLabel#MixpiMediaCleaned,
#MixpiPage QLabel#MixpiMediaGate, #MixpiPage QLabel#MixpiEjectHint {
    color: #8c9ab0;
    font-size: 14px;
}
#MixpiPage QLabel#MixpiMediaUse[block="true"] { color: #ffb020; }
#MixpiPage QLabel#MixpiMediaSafe { color: #b9f5d2; font-size: 16px; }
#MixpiPage QLabel#MixpiMediaHeading {
    color: #8c9ab0;
    font-size: 13px;
    font-weight: bold;
}
#MixpiPage QLabel#MixpiMediaPill {
    min-height: 26px;
    padding: 0px 8px;
    border: 1px solid #43d17a;
    border-radius: 4px;
    color: #43d17a;
    font-size: 13px;
    font-weight: bold;
}
#MixpiPage QLabel#MixpiMediaPill[state="2"] { color: #9fd0ff; border-color: #4aa8ff; }
#MixpiPage QLabel#MixpiMediaPill[state="3"] { color: #ffb020; border-color: #ffb020; }
#MixpiPage QLabel#MixpiMediaPill[state="4"] { color: #0b1a10; background-color: #43d17a; }
#MixpiPage QFrame#MixpiMediaOnPiRow { border-bottom: 1px solid #1c2531; }
#MixpiPage QLabel#MixpiOnPiChip, #MixpiPage QLabel#MixpiMediaPlayer {
    padding: 2px 6px;
    border-radius: 4px;
    font-size: 13px;
    font-weight: bold;
}
#MixpiPage QLabel#MixpiOnPiChip { color: #0b1a10; background-color: #43d17a; }
#MixpiPage QLabel#MixpiMediaPlayer { color: #8c9ab0; border: 1px solid #2b3646; }
#MixpiPage QPushButton, #MixpiBottomStrip QPushButton {
    min-height: 48px;
    background-color: #19212d;
    color: #eef2f7;
    border: 1px solid #2b3646;
    border-radius: 6px;
    font-size: 17px;
    font-weight: bold;
    padding: 0px 12px;
}
#MixpiPage QPushButton[primary="true"], #MixpiBottomStrip QPushButton[primary="true"] {
    background-color: #b5e15c;
    color: #10140a;
    border-color: #b5e15c;
}
#MixpiPage QPushButton:pressed, #MixpiBottomStrip QPushButton:pressed { background-color: #285a88; }
#MixpiPage QPushButton:disabled, #MixpiBottomStrip QPushButton:disabled {
    background-color: #121821;
    color: #6f7b8c;
    border-color: #222c3a;
}
#MixpiPage QFrame#MixpiMediaScrim { background-color: rgba(3, 5, 8, 158); }
#MixpiPage QFrame#MixpiEjectSheet {
    background-color: #121821;
    border: 1px solid #3a4759;
    border-radius: 12px;
}
#MixpiPage QLabel#MixpiEjectTitle { font-size: 24px; font-weight: bold; }
#MixpiPage QLabel#MixpiEjectUser { font-size: 16px; }
#MixpiPage QLabel#MixpiEjectFate { color: #43d17a; font-size: 15px; }
#MixpiPage QLabel#MixpiEjectFate[fate="2"] { color: #8c9ab0; }
#MixpiPage QLabel#MixpiEjectFate[fate="3"] { color: #ffb020; }
#MixpiPage QLabel#MixpiEjectStep { color: #8c9ab0; font-size: 15px; }
#MixpiPage QLabel#MixpiEjectStep[step="done"] { color: #eef2f7; }
#MixpiPage QLabel#MixpiEjectDot {
    border: 2px solid #2b3646;
    border-radius: 13px;
    font-size: 13px;
}
#MixpiPage QLabel#MixpiEjectDot[step="done"] { background-color: #43d17a; border-color: #43d17a; color: #06150c; }
#MixpiPage QLabel#MixpiEjectDot[step="now"] { border-color: #ffb020; color: #ffb020; }
/* Insert ping and Safe to remove strip (Q1, Q2): 56 px over the bottom row. */
#MixpiBottomStrip {
    background-color: #19212d;
    border-top: 2px solid #43d17a;
}
#MixpiBottomStrip[kind="safe"] { background-color: #1d7a4a; }
#MixpiBottomStrip[kind="safe"][flash="true"] { background-color: #2fae68; }
#MixpiBottomStrip QLabel { background-color: transparent; color: #eef2f7; }
#MixpiBottomStrip QLabel#MixpiStripTitle { font-size: 18px; font-weight: bold; }
#MixpiBottomStrip QLabel#MixpiStripDetail { color: #8c9ab0; font-size: 13px; }
#MixpiBottomStrip[kind="safe"] QLabel#MixpiStripDetail { color: #e6fff0; }
#MixpiBottomStrip[kind="safe"] QPushButton#MixpiStripOk {
    background-color: rgba(0, 0, 0, 64);
    border-color: rgba(255, 255, 255, 128);
    color: #ffffff;
}
