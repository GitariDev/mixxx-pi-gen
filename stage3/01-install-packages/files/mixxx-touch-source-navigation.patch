diff --git a/src/widget/touchsourcenavigation.h b/src/widget/touchsourcenavigation.h
new file mode 100644
index 0000000..1aa08cf
--- /dev/null
+++ b/src/widget/touchsourcenavigation.h
@@ -0,0 +1,110 @@
+#pragma once
+
+#include <functional>
+
+#include <QAbstractItemModel>
+#include <QPersistentModelIndex>
+#include <QTreeView>
+
+// Flat, one-level-at-a-time navigation over the existing library tree. The
+// model still owns imports, track selection and removable-device discovery.
+// No cached raw TreeItem pointers survive a model reset or device removal.
+class TouchSourceNavigation final : public QObject {
+  public:
+    explicit TouchSourceNavigation(QTreeView* view)
+            : QObject(view), m_view(view) {
+        view->setRootIsDecorated(false);
+        view->setItemsExpandable(false);
+        view->setExpandsOnDoubleClick(false);
+        view->setIndentation(0);
+        connect(view, &QTreeView::clicked, this,
+                [this](const QModelIndex& index) { enter(index); });
+        auto* model = view->model();
+        connect(model, &QAbstractItemModel::rowsInserted, this,
+                [this] { enterPending(); });
+        connect(model, &QAbstractItemModel::rowsRemoved, this,
+                [this] {
+                    if (!m_root.isValid()) {
+                        home();
+                    }
+                });
+        connect(model, &QAbstractItemModel::modelAboutToBeReset, this,
+                [this] { home(); });
+    }
+
+    // Installed by WLibrarySidebar: uses the same lazy-population path as the
+    // old disclosure arrow. Keep this separate from track/playlist activation.
+    std::function<void(const QModelIndex&)> requestChildren;
+    std::function<void(bool)> changed;
+
+    bool canGoBack() const {
+        return m_root.isValid();
+    }
+
+    void enter(const QModelIndex& index) {
+        m_pending = QPersistentModelIndex();
+        if (!index.isValid() || index.model() != m_view->model() ||
+                index.parent() != m_view->rootIndex() ||
+                m_view->isRowHidden(index.row(), index.parent())) {
+            return;
+        }
+        m_pending = index;
+        if (requestChildren) {
+            requestChildren(index);
+        }
+        enterPending();
+    }
+
+    void back() {
+        m_pending = QPersistentModelIndex();
+        if (!m_root.isValid()) {
+            home();
+            return;
+        }
+        const QPersistentModelIndex previous = m_root;
+        setRoot(previous.parent());
+        // Highlight the folder we just left without reactivating its track
+        // model. Back and Show/Hide preserve the current playlist and search.
+        m_view->selectionModel()->setCurrentIndex(previous,
+                QItemSelectionModel::ClearAndSelect | QItemSelectionModel::Rows);
+        m_view->scrollTo(previous);
+    }
+
+    void home() {
+        m_pending = QPersistentModelIndex();
+        setRoot(QModelIndex());
+    }
+
+    void reveal(const QModelIndex& index) {
+        if (index.isValid() && index.model() == m_view->model() &&
+                index != m_view->rootIndex() && index.parent() != m_view->rootIndex()) {
+            m_pending = QPersistentModelIndex();
+            setRoot(index.parent());
+        }
+    }
+
+  private:
+    void setRoot(const QModelIndex& index) {
+        m_root = index;
+        m_view->setRootIndex(index);
+        if (changed) {
+            changed(canGoBack());
+        }
+    }
+
+    void enterPending() {
+        if (!m_pending.isValid() || m_pending.parent() != m_view->rootIndex() ||
+                m_view->isRowHidden(m_pending.row(), m_pending.parent()) ||
+                m_view->model()->rowCount(m_pending) == 0) {
+            return;
+        }
+        const QPersistentModelIndex next = m_pending;
+        m_pending = QPersistentModelIndex();
+        setRoot(next);
+        m_view->collapseAll();
+    }
+
+    QTreeView* const m_view;
+    QPersistentModelIndex m_root;
+    QPersistentModelIndex m_pending;
+};
