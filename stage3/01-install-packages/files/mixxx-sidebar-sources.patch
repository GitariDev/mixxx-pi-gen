+void Library::addOptionalSidebarSource(const QString& id,
+        const QString& title,
+        const QString& preference,
+        std::function<LibraryFeature*()> create) {
+    const ConfigKey key(kConfigGroup, preference);
+    m_sidebarSources.push_back({id, title, key, nullptr, create});
+    if (m_pConfig->getValue(key, true)) {
+        addFeature(create());
+    }
+}
+
+void Library::applySidebarSourceVisibility() {
+    if (!m_pSidebarWidget) {
+        return;
+    }
+    QModelIndex firstVisible;
+    for (const auto& source : std::as_const(m_sidebarSources)) {
+        const int row = m_features.indexOf(source.feature);
+        if (row < 0) {
+            continue;
+        }
+        const bool visible = m_pConfig->getValue(source.preference, true);
+        m_pSidebarWidget->setRowHidden(row, QModelIndex(), !visible);
+        if (visible && !firstVisible.isValid()) {
+            firstVisible = m_pSidebarModel->index(row, 0);
+        }
+    }
+    // Recover from hand-edited settings which hide every source.
+    if (!firstVisible.isValid() && !m_sidebarSources.isEmpty()) {
+        m_pConfig->setValue(m_sidebarSources.first().preference, true);
+        applySidebarSourceVisibility();
+        return;
+    }
+    const auto defaultIndex = m_pSidebarModel->getDefaultSelection();
+    if (firstVisible.isValid() && defaultIndex.isValid() &&
+            m_pSidebarWidget->isRowHidden(defaultIndex.row(), QModelIndex())) {
+        m_pSidebarModel->setDefaultSelection(firstVisible.row());
+    }
+    // Never leave keyboard/controller navigation pointing at a hidden source.
+    QModelIndex selected = m_pSidebarWidget->currentIndex();
+    while (selected.parent().isValid()) {
+        selected = selected.parent();
+    }
+    if (selected.isValid() &&
+            m_pSidebarWidget->isRowHidden(selected.row(), QModelIndex()) &&
+            firstVisible.isValid()) {
+        m_pSidebarWidget->selectIndex(firstVisible);
+        m_pSidebarModel->clicked(firstVisible);
+    }
+}
+
+void Library::showSidebarSourcesMenu() {
+    if (!m_pSidebarWidget || !m_pLibraryWidget) {
+        return;
+    }
+    auto* menu = new QMenu(tr("Sources"), m_pSidebarWidget);
+    menu->setAttribute(Qt::WA_DeleteOnClose);
+    int visibleCount = 0;
+    for (const auto& source : std::as_const(m_sidebarSources)) {
+        if (m_pConfig->getValue(source.preference, true)) {
+            ++visibleCount;
+        }
+    }
+    for (int i = 0; i < m_sidebarSources.size(); ++i) {
+        const auto& source = m_sidebarSources[i];
+        auto* action = menu->addAction(source.title);
+        action->setCheckable(true);
+        const bool visible = m_pConfig->getValue(source.preference, true);
+        action->setChecked(visible);
+        // Keep one source available; the menu itself remains reachable even
+        // when the sidebar has been hidden with the Show/Hide button.
+        action->setEnabled(!visible || visibleCount > 1);
+        connect(action, &QAction::triggered, this, [this, i](bool enabled) {
+            // Copy the factory before addFeature, which may grow the list.
+            const auto source = m_sidebarSources.at(i);
+            m_pConfig->setValue(source.preference, enabled);
+            if (enabled && !source.feature && source.create) {
+                auto* feature = source.create();
+                addFeature(feature);
+                feature->bindLibraryWidget(m_pLibraryWidget, m_pSidebarKeyboard);
+                feature->bindSidebarWidget(m_pSidebarWidget);
+                emit setTrackTableFont(m_trackTableFont);
+                emit setTrackTableRowHeight(m_iTrackTableRowHeight);
+                emit setSelectedClick(m_editMetadataSelectedClick);
+            }
+            applySidebarSourceVisibility();
+        });
+    }
+    menu->popup(m_pLibraryWidget->mapToGlobal(QPoint(0, 0)));
+}
