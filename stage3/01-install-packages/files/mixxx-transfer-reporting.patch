diff --git a/src/library/media/transferstatus.h b/src/library/media/transferstatus.h
new file mode 100644
--- /dev/null
+++ b/src/library/media/transferstatus.h
@@ -0,0 +1,128 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <deque>
+#include <mutex>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace mixxx::media {
+
+enum class TransferPhase { Unknown, Copying, Verifying };
+enum class TransferOutcome { Unknown, Running, Verified, Failed, Cancelled, Interrupted };
+
+struct TransferSnapshot {
+    // Unknown/evicted bindings have valid=false. Interrupted progress is not current.
+    bool valid = false;
+    bool progressValid = false;
+    std::uint64_t job = 0;
+    TransferPhase phase = TransferPhase::Unknown;
+    TransferOutcome status = TransferOutcome::Unknown;
+    int progress = 0;
+    std::size_t activeJobs = 0;
+};
+
+class TransferHistory final {
+  public:
+    using Key = std::pair<std::string, std::string>;
+    static constexpr std::size_t Capacity = 64;
+
+    std::uint64_t begin(std::vector<Key> bindings) {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (bindings.empty() || bindings.size() > 6 || m_next == UINT64_MAX) return 0;
+        std::size_t bytes = 0;
+        for (const auto& binding : bindings) {
+            if (binding.first.empty() || binding.second.empty() ||
+                    binding.first.size() > 8192 || binding.second.size() > 8192) return 0;
+            bytes += binding.first.size() + binding.second.size();
+            if (bytes > 8192) return 0;
+        }
+        if (m_jobs.size() == Capacity) {
+            const auto terminal = std::find_if(m_jobs.begin(), m_jobs.end(), [](const Job& job) {
+                return job.snapshot.status != TransferOutcome::Running;
+            });
+            if (terminal == m_jobs.end()) return 0;
+            m_jobs.erase(terminal);
+        }
+        const auto identifier = ++m_next;
+        m_jobs.push_back({std::move(bindings), {true, true, identifier,
+                TransferPhase::Copying, TransferOutcome::Running, 0, 0}});
+        return identifier;
+    }
+
+    bool update(std::uint64_t identifier, const std::string& phase, const std::string& value) {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        auto* job = running(identifier);
+        if (!job || (phase != "copying" && phase != "verifying") || value.empty() || value.size() > 2 ||
+                (value.size() > 1 && value.front() == '0')) return false;
+        int progress = 0;
+        for (const char character : value) {
+            if (character < '0' || character > '9') return false;
+            progress = progress * 10 + character - '0';
+        }
+        if (progress < job->snapshot.progress || progress > 99) return false;
+        job->snapshot.phase = phase == "copying" ? TransferPhase::Copying : TransferPhase::Verifying;
+        job->snapshot.progress = progress;
+        return true;
+    }
+
+    bool finish(std::uint64_t identifier, const std::string& outcome) {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        auto* job = running(identifier);
+        if (!job) return false;
+        if (outcome == "verified") {
+            if (job->snapshot.phase != TransferPhase::Verifying || job->snapshot.progress != 99) return false;
+            job->snapshot.status = TransferOutcome::Verified;
+            job->snapshot.progress = 100;
+        } else if (outcome == "failed") {
+            job->snapshot.status = TransferOutcome::Failed;
+        } else if (outcome == "cancelled") {
+            job->snapshot.status = TransferOutcome::Cancelled;
+        } else {
+            return false;
+        }
+        return true;
+    }
+
+    void interrupt(std::uint64_t identifier) {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        auto* job = running(identifier);
+        if (!job) return;
+        job->snapshot.status = TransferOutcome::Interrupted;
+        job->snapshot.progressValid = false;
+    }
+
+    TransferSnapshot snapshot(const Key& binding) const {
+        // Select the newest running job before terminal history; do not hide active work.
+        std::lock_guard<std::mutex> lock(m_mutex);
+        TransferSnapshot result;
+        for (const auto& job : m_jobs) {
+            if (std::find(job.bindings.begin(), job.bindings.end(), binding) == job.bindings.end()) continue;
+            const auto active = result.activeJobs + (job.snapshot.status == TransferOutcome::Running ? 1 : 0);
+            if (!result.valid || job.snapshot.status == TransferOutcome::Running || result.activeJobs == 0) {
+                result = job.snapshot;
+            }
+            result.activeJobs = active;
+        }
+        return result;
+    }
+
+  private:
+    struct Job {
+        std::vector<Key> bindings;
+        TransferSnapshot snapshot;
+    };
+    Job* running(std::uint64_t identifier) {
+        for (auto& job : m_jobs) {
+            if (job.snapshot.job == identifier && job.snapshot.status == TransferOutcome::Running) return &job;
+        }
+        return nullptr;
+    }
+    mutable std::mutex m_mutex;
+    std::deque<Job> m_jobs;
+    std::uint64_t m_next = 0;
+};
+
+}
