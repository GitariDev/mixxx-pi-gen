/* Browse is the only Pioneered page with a LibraryWrapper. Keep the decks
 * and Overview/Samples at their existing sizes on the 800x444 display. */
#LibraryWrapper QTableView,
#LibraryWrapper WLibraryTextBrowser,
#LibraryWrapper WLibrarySidebar {
    font-size: 17px;
}

#LibraryWrapper WTrackTableViewHeader::section {
    font-size: 16px;
    min-height: 34px;
    padding: 0px 7px;
    margin: 0px;
    border-right: 1px solid #596171;
}

/* Sources is a full screen (R-9): 56 px rows across the whole width. */
#LibraryWrapper WLibrarySidebar {
    background-color: #0a0d12;
    color: #eef2f7;
    border: 0px;
    selection-background-color: #1f2a17;
    selection-color: #ffffff;
}
#LibraryWrapper WLibrarySidebar::item {
    min-height: 56px;
    padding: 0px 14px;
    border-bottom: 1px solid #1c2531;
}
#LibraryWrapper WLibrarySidebar::item:selected {
    background-color: #1f2a17;
    color: #ffffff;
}

/* 24 px scroll bars on lists (R-9, PROTO .sc). */
#LibraryWrapper QScrollBar {
    background-color: #121821;
    border: 0px;
    margin: 0px;
}
#LibraryWrapper QScrollBar:horizontal {
    height: 24px;
}
#LibraryWrapper QScrollBar:vertical {
    width: 24px;
    border-left: 1px solid #2b3646;
}
#LibraryWrapper QScrollBar::handle {
    background-color: #5d6b80;
    border: 5px solid #121821;
    border-radius: 8px;
}
#LibraryWrapper QScrollBar::handle:horizontal {
    min-width: 56px;
    border: 5px solid #121821;
}
#LibraryWrapper QScrollBar::handle:vertical {
    min-height: 56px;
}
#LibraryWrapper QScrollBar::handle:pressed {
    background-color: #b5e15c;
}
#LibraryWrapper QScrollBar::add-page,
#LibraryWrapper QScrollBar::sub-page {
    background-color: #121821;
}

/* ☰ and ✎ are 48 px icon buttons (R-11); EDIT LIST and BACK keep text. */
#LibraryActionsButton, #LibrarySourcesButton, #LibraryBackButton, #SidebarButton {
    background-color: #19212d;
    border: 1px solid #2b3646;
    border-radius: 6px;
    color: #eef2f7;
    font-family: "Ubuntu Condensed", "Ubuntu";
    font-size: 17px;
    font-weight: bold;
    margin: 0px;
}
#LibraryActionsButton[value="1"], #SidebarButton[value="1"] {
    background-color: #2a3a1a;
    border-color: #b5e15c;
}

#LibraryBackButton:disabled {
    color: #56627a;
    background-color: #10151c;
    border-color: #1f2834;
}

#LibraryWrapper #SearchBox {
    background-color: #19212d;
    border: 1px solid #2b3646;
    border-radius: 8px;
    color: #eef2f7;
    font-size: 17px;
    margin: 0px 6px;
}

/* The BPM lock is not a touch control. Draw no indicator in the BPM column. */
#LibraryWrapper #LibraryBPMButton::indicator {
    width: 0px;
    height: 0px;
    image: none;
    border: 0px;
}

/* One dark selection bar, as the performance pages use; the current-cell
 * outline takes the same colour, so the selected row has no second frame. */
#LibraryWrapper WTrackTableView {
    selection-background-color: #27577d;
    selection-color: #ffffff;
    qproperty-focusBorderColor: #27577d;
}
