--- a/src/widget/libraryinterface.h
+++ b/src/widget/libraryinterface.h
@@ -188,6 +188,22 @@ inline void stretchColumn(QHeaderView* header, int column) {
     }
 }
 
+// A hidden column the user shows (Arrange or the header menu) gets a readable
+// width, with the same floor as the stretch column. A hidden column that was
+// never shown has a saved width of 0, which restores to the minimum section
+// size (about 26 px: only "A" of Artist is left). A column that was shown
+// wider keeps its width. Visible columns are not touched, and restoreState()
+// still restores saved widths.
+inline void showColumnReadable(QHeaderView* header, int column) {
+    if (!header->isSectionHidden(column)) {
+        return;
+    }
+    header->setSectionHidden(column, false);
+    if (header->sectionSize(column) < kStretchColumnMinimumWidth) {
+        header->resizeSection(column, kStretchColumnMinimumWidth);
+    }
+}
+
 inline void rememberColumnWidths(QHeaderView* header, QMap<int, int>* widths) {
     QObject::connect(header, &QHeaderView::sectionResized, header,
             [widths](int column, int, int width) {
@@ -242,7 +258,11 @@ inline QDialog* arrangeColumns(QHeaderView* header, const QList<int>& available,
             auto* item = list->item(row);
             const int column = item->data(Qt::UserRole).toInt();
             header->moveSection(header->visualIndex(column), row);
-            header->setSectionHidden(column, item->checkState() != Qt::Checked);
+            if (item->checkState() != Qt::Checked) {
+                header->setSectionHidden(column, true);
+            } else {
+                showColumnReadable(header, column);
+            }
         }
         save();
     };
