diff --git a/src/library/rekordbox/sourcecache.h b/src/library/rekordbox/sourcecache.h
new file mode 100644
--- /dev/null
+++ b/src/library/rekordbox/sourcecache.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include "library/treeitem.h"
+#include "sourceidentity.h"
+
+namespace mixxx::rekordbox {
+
+inline bool matchesCachedSource(const TreeItem* item, const QString& path, const QString& revision) {
+    const auto data = item->getData().toList();
+    return sameSourceRevision(data.value(0).toString().toStdString(),
+            data.value(2).toString().toStdString(), path.toStdString(), revision.toStdString());
+}
+
+inline int cachedSourceRow(const TreeItem* root, const QString& path, const QString& revision) {
+    for (int row = 0; row < root->childRows(); ++row) {
+        if (matchesCachedSource(root->child(row), path, revision)) {
+            return row;
+        }
+    }
+    return -1;
+}
+
+}
diff --git a/src/library/rekordbox/sourceidentity.h b/src/library/rekordbox/sourceidentity.h
new file mode 100644
--- /dev/null
+++ b/src/library/rekordbox/sourceidentity.h
@@ -0,0 +1,239 @@
+#pragma once
+
+#include <algorithm>
+#include <fstream>
+#include <functional>
+#include <memory>
+#include <sstream>
+#include <string>
+#include <vector>
+
+#include "removablemounts.h"
+
+#ifdef __linux__
+#include <cerrno>
+#include <filesystem>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <sys/sysmacros.h>
+#include <unistd.h>
+#endif
+
+namespace mixxx::rekordbox {
+
+struct SourceMount {
+    std::string id;
+    std::string device;
+    std::string root;
+    std::string path;
+};
+
+struct PhysicalGeneration {
+    std::string boot;
+    std::string nameSpace;
+    std::string sysfs;
+    std::string device;
+    std::string diskseq;
+};
+
+inline bool positiveNumber(const std::string& value) {
+    return !value.empty() && value.find_first_not_of("0123456789") == std::string::npos &&
+            value.find_first_not_of('0') != std::string::npos;
+}
+
+inline std::string identityFields(const std::vector<std::string>& fields) {
+    std::string result;
+    for (const auto& field : fields) {
+        result += std::to_string(field.size()) + ":" + field;
+    }
+    return result;
+}
+
+inline std::string generationRevision(const PhysicalGeneration& generation) {
+    if (generation.boot.empty() || generation.nameSpace.empty() || generation.sysfs.empty() ||
+            generation.device.empty() || !positiveNumber(generation.diskseq)) {
+        return {};
+    }
+    return identityFields({generation.boot, generation.nameSpace, generation.sysfs,
+            generation.device, generation.diskseq});
+}
+
+inline std::string sourceRevision(const SourceMount& mount, const PhysicalGeneration& generation) {
+    const auto physical = generationRevision(generation);
+    if (physical.empty() || !positiveNumber(mount.id) || mount.device.empty() ||
+            mount.root.empty() || mount.path.empty()) {
+        return {};
+    }
+    return identityFields({physical, mount.id, mount.device, mount.root, mount.path});
+}
+
+inline std::string databaseRevision(const std::string& source, const std::string& metadata) {
+    return source.empty() || metadata.empty() ? std::string() : identityFields({source, metadata});
+}
+
+inline bool sameSourceRevision(const std::string& oldPath, const std::string& oldRevision,
+        const std::string& newPath, const std::string& newRevision) {
+    return !newRevision.empty() && oldPath == newPath && oldRevision == newRevision;
+}
+
+inline bool resolvedOnMount(const SourceMount& mount, const std::string& device,
+        const std::string& mountId) {
+    return positiveNumber(mountId) && mount.id == mountId && mount.device == device;
+}
+
+inline std::string descriptorMountId(std::istream& input) {
+    std::string line;
+    std::string result;
+    while (std::getline(input, line)) {
+        if (line.rfind("mnt_id:", 0) != 0) {
+            continue;
+        }
+        std::istringstream fields(line.substr(7));
+        std::string value, extra;
+        if (!result.empty() || !(fields >> value) || fields >> extra || !positiveNumber(value)) {
+            return {};
+        }
+        result = value;
+    }
+    return input.eof() ? result : std::string();
+}
+
+inline SourceMount containingMount(const std::string& path, std::istream& input) {
+    SourceMount result;
+    std::string line;
+    bool ambiguous = false;
+    while (std::getline(input, line)) {
+        SourceMount mount;
+        std::string parent;
+        std::istringstream fields(line);
+        if (!(fields >> mount.id >> parent >> mount.device >> mount.root >> mount.path)) {
+            return {};
+        }
+        mount.root = decodeMountPath(mount.root);
+        mount.path = decodeMountPath(mount.path);
+        if (mount.path != "/" && path != mount.path && path.rfind(mount.path + "/", 0) != 0) {
+            continue;
+        }
+        if (mount.path.size() > result.path.size()) {
+            result = mount;
+            ambiguous = false;
+        } else if (mount.path == result.path) {
+            ambiguous = true;
+        }
+    }
+    return input.eof() && !ambiguous ? result : SourceMount{};
+}
+
+class SourceDescriptor {
+  public:
+    explicit SourceDescriptor(int descriptor) : value(descriptor) {}
+    ~SourceDescriptor() {
+#ifdef __linux__
+        if (value >= 0) {
+            ::close(value);
+        }
+#endif
+    }
+    SourceDescriptor(const SourceDescriptor&) = delete;
+    SourceDescriptor& operator=(const SourceDescriptor&) = delete;
+    const int value;
+};
+
+struct SourceObservation {
+    SourceMount mount;
+    PhysicalGeneration generation;
+    std::string revision;
+    std::string database;
+    std::shared_ptr<SourceDescriptor> directoryDescriptor;
+    std::shared_ptr<SourceDescriptor> databaseDescriptor;
+};
+
+#ifdef __linux__
+inline std::string readIdentityFile(const std::filesystem::path& path) {
+    std::ifstream input(path);
+    std::string value;
+    std::getline(input, value);
+    return input.bad() ? std::string() : value;
+}
+
+inline PhysicalGeneration physicalGeneration(const std::string& device) {
+    std::error_code error;
+    auto sysfs = std::filesystem::canonical("/sys/dev/block/" + device, error);
+    if (error) {
+        return {};
+    }
+    if (std::filesystem::exists(sysfs / "partition", error)) {
+        sysfs = sysfs.parent_path();
+    }
+    if (error) {
+        return {};
+    }
+    const auto nameSpace = std::filesystem::read_symlink("/proc/self/ns/mnt", error);
+    if (error) {
+        return {};
+    }
+    return {readIdentityFile("/proc/sys/kernel/random/boot_id"), nameSpace.string(),
+            sysfs.string(), readIdentityFile(sysfs / "dev"), readIdentityFile(sysfs / "diskseq")};
+}
+
+inline bool descriptorOnMount(int descriptor, const SourceMount& mount, bool directory,
+        std::string* metadata = nullptr) {
+    struct stat status {};
+    if (::fstat(descriptor, &status) != 0 ||
+            (directory ? !S_ISDIR(status.st_mode) : !S_ISREG(status.st_mode))) {
+        return false;
+    }
+    std::ifstream info("/proc/self/fdinfo/" + std::to_string(descriptor));
+    const auto device = std::to_string(major(status.st_dev)) + ":" + std::to_string(minor(status.st_dev));
+    if (!resolvedOnMount(mount, device, descriptorMountId(info))) {
+        return false;
+    }
+    if (metadata) {
+        *metadata = identityFields({std::to_string(status.st_size), std::to_string(status.st_mtim.tv_sec),
+                std::to_string(status.st_mtim.tv_nsec), std::to_string(status.st_ino)});
+    }
+    return true;
+}
+#endif
+
+inline SourceObservation inspectSource(const std::string& path) {
+#ifdef __linux__
+    if (path.empty() || path.front() != '/' || std::filesystem::path(path).lexically_normal() != path) {
+        return {};
+    }
+    SourceObservation result;
+    result.directoryDescriptor = std::make_shared<SourceDescriptor>(
+            ::open(path.c_str(), O_PATH | O_DIRECTORY | O_CLOEXEC));
+    std::ifstream mounts("/proc/self/mountinfo");
+    result.mount = containingMount(path, mounts);
+    if (!descriptorOnMount(result.directoryDescriptor->value, result.mount, true)) {
+        return {};
+    }
+    result.generation = physicalGeneration(result.mount.device);
+    result.revision = sourceRevision(result.mount, result.generation);
+    if (result.revision.empty()) {
+        return {};
+    }
+    const int database = ::openat(result.directoryDescriptor->value,
+            "PIONEER/rekordbox/export.pdb", O_PATH | O_CLOEXEC);
+    if (database >= 0) {
+        result.databaseDescriptor = std::make_shared<SourceDescriptor>(database);
+        std::string metadata;
+        if (!descriptorOnMount(database, result.mount, false, &metadata)) {
+            return {};
+        }
+        result.database = databaseRevision(result.revision, metadata);
+    } else if (errno != ENOENT) {
+        return {};
+    }
+    if (generationRevision(result.generation) != generationRevision(physicalGeneration(result.mount.device))) {
+        return {};
+    }
+    return result;
+#else
+    (void)path;
+    return {};
+#endif
+}
+
+}
