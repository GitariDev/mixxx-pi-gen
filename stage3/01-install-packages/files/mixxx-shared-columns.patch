+++ b/src/widget/mixpisharedcolumns.h
@@ -0,0 +1,138 @@
+#pragma once
+
+#include <QByteArray>
+#include <QList>
+#include <QSet>
+#include <QString>
+#include <QStringList>
+
+#include "proto/headers.pb.h"
+
+// Build F (spec 2c, plan 12.7): one column setup for every track table.
+// Which columns show, their order and their widths are shared by This Pi,
+// playlists and crates, Auto DJ, History, folders, each drive's rekordbox
+// lists and the Samples table in Load sample. The setup is a list of named
+// columns in their order; a table shows the ones it has, in that order. A
+// column a table does not have is skipped there and keeps its place in the
+// list for the tables that have it. A column only a table has (Filename in
+// a folder) keeps that table's own default place and state until it is
+// changed there. Sorting is not part of it: it stays per list.
+//
+// The list is stored as a mixxx.library.HeaderViewState (the same message
+// as each list's own header_state_pb, without the sort), Base64 encoded.
+namespace MixpiSharedColumns {
+
+struct Column {
+    QString name;
+    bool hidden = false;
+    int size = 0;
+};
+
+inline QList<Column> parse(const QString& base64) {
+    QList<Column> columns;
+    if (base64.isEmpty()) {
+        return columns;
+    }
+    mixxx::library::HeaderViewState state;
+    const QByteArray bytes = QByteArray::fromBase64(base64.toLatin1());
+    if (!state.ParseFromArray(bytes.constData(), static_cast<int>(bytes.size()))) {
+        return columns;
+    }
+    QSet<QString> seen;
+    for (int i = 0; i < state.header_state_size(); ++i) {
+        const auto& entry = state.header_state(i);
+        const QString name = QString::fromStdString(entry.column_name());
+        if (name.isEmpty() || seen.contains(name)) {
+            continue;
+        }
+        seen.insert(name);
+        columns.append({name, entry.hidden(), entry.size()});
+    }
+    return columns;
+}
+
+inline QString serialize(const QList<Column>& columns) {
+    mixxx::library::HeaderViewState state;
+    int position = 0;
+    for (const auto& column : columns) {
+        auto* entry = state.add_header_state();
+        entry->set_column_name(column.name.toStdString());
+        entry->set_hidden(column.hidden);
+        entry->set_size(column.size);
+        entry->set_visual_index(position++);
+    }
+#if GOOGLE_PROTOBUF_VERSION >= 3001000
+    const int size = static_cast<int>(state.ByteSizeLong());
+#else
+    const int size = state.ByteSize();
+#endif
+    QByteArray bytes(size, '\0');
+    state.SerializeToArray(bytes.data(), size);
+    return QString::fromLatin1(bytes.toBase64());
+}
+
+inline bool anyShown(const QList<Column>& columns) {
+    for (const auto& column : columns) {
+        if (!column.hidden) {
+            return true;
+        }
+    }
+    return false;
+}
+
+inline QSet<QString> names(const QList<Column>& columns) {
+    QSet<QString> result;
+    for (const auto& column : columns) {
+        result.insert(column.name);
+    }
+    return result;
+}
+
+// A table's columns (in its order, with its states) merged into the shared
+// list. The places the table's columns hold in the list are filled with
+// them in the table's order; the other columns keep their places. A column
+// new to the list goes just before the table column that follows it.
+inline QList<Column> merge(const QList<Column>& shared, const QList<Column>& table) {
+    const QSet<QString> sharedNames = names(shared);
+    const QSet<QString> tableNames = names(table);
+    QList<Column> result;
+    int next = 0;
+    for (const auto& column : shared) {
+        if (!tableNames.contains(column.name)) {
+            result.append(column);
+            continue;
+        }
+        while (next < table.size()) {
+            const Column& own = table.at(next++);
+            result.append(own);
+            if (sharedNames.contains(own.name)) {
+                break;
+            }
+        }
+    }
+    while (next < table.size()) {
+        result.append(table.at(next++));
+    }
+    return result;
+}
+
+// The order a table shows its columns in: its own order (its defaults),
+// with the places of the shared columns filled in the shared order.
+inline QStringList arrange(const QStringList& tableOrder, const QList<Column>& shared) {
+    const QSet<QString> own(tableOrder.cbegin(), tableOrder.cend());
+    QStringList sharedOrder;
+    for (const auto& column : shared) {
+        if (own.contains(column.name)) {
+            sharedOrder.append(column.name);
+        }
+    }
+    const QSet<QString> sharedNames(sharedOrder.cbegin(), sharedOrder.cend());
+    QStringList result;
+    int next = 0;
+    for (const auto& name : tableOrder) {
+        result.append(sharedNames.contains(name) ? sharedOrder.at(next++) : name);
+    }
+    return result;
+}
+
+} // namespace MixpiSharedColumns
