+// MixPi J6: a sort query failed. The rows stay, in the order they had: the
+// tracks the filter keeps (the previous result if that query fails as well),
+// first those of the previous result in its order, then the others.
+void BaseTrackCache::keepPreviousOrder(const QString& filter,
+        const QSet<TrackId>& trackIds,
+        QHash<TrackId, int>* trackToIndex) {
+    QVector<TrackId> kept;
+    QSqlQuery query(m_database);
+    query.setForwardOnly(true);
+    if (query.prepare(QStringLiteral("SELECT %1 FROM %2 %3")
+                              .arg(m_idColumn, m_tableName, filter)) &&
+            query.exec()) {
+        const int idColumn = query.record().indexOf(m_idColumn);
+        while (query.next()) {
+            kept.append(TrackId(query.value(idColumn)));
+        }
+    } else {
+        LOG_FAILED_QUERY(query);
+        if (m_trackOrder.isEmpty()) {
+            for (const auto& trackId : trackIds) {
+                kept.append(trackId);
+            }
+        } else {
+            kept = m_trackOrder;
+        }
+    }
+    QHash<TrackId, int> previous;
+    for (int i = 0; i < m_trackOrder.size(); ++i) {
+        previous.insert(m_trackOrder[i], i);
+    }
+    std::stable_sort(kept.begin(),
+            kept.end(),
+            [&previous](const TrackId& first, const TrackId& second) {
+                return previous.value(first, INT_MAX) < previous.value(second, INT_MAX);
+            });
+    m_trackOrder = kept;
+    trackToIndex->clear();
+    trackToIndex->reserve(m_trackOrder.size());
+    for (int i = 0; i < m_trackOrder.size(); ++i) {
+        trackToIndex->insert(m_trackOrder[i], i);
+    }
+    qWarning() << this << "sort failed on" << m_tableName << "- kept"
+               << m_trackOrder.size() << "rows in their previous order";
+}
