+// MixPi scan progress. The folders under the music directories are counted
+// once, on the scanner thread, before the scan queues its work. The percent
+// is folders done / folders counted, capped at 99 until the scan finishes,
+// and it never goes down.
+int countScanFolders(const QStringList& roots);
+
+class ScanPercent {
+  public:
+    void start(int folders) {
+        m_folders = folders;
+        m_done = 0;
+        m_value = 0;
+    }
+    // One folder is done. Returns true when the percent changed.
+    bool folderDone() {
+        ++m_done;
+        const int next = m_folders > 0
+                ? static_cast<int>(qMin<qint64>(99, static_cast<qint64>(m_done) * 100 / m_folders))
+                : 0;
+        if (next <= m_value) {
+            return false;
+        }
+        m_value = next;
+        return true;
+    }
+    int value() const {
+        return m_value;
+    }
+
+  private:
+    int m_folders = 0;
+    int m_done = 0;
+    int m_value = 0;
+};
+
+// The file or folder name only, without the path in front of it.
+QString scanItemName(const QString& path);
+
