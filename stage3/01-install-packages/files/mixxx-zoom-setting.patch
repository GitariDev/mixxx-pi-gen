@@ -0,0 +1,152 @@
+#pragma once
+
+#include <QObject>
+#include <QString>
+#include <QTimer>
+#include <algorithm>
+#include <cmath>
+#include <functional>
+#include <utility>
+
+#include "control/controlobject.h"
+#include "control/controlpushbutton.h"
+#include "preferences/usersettings.h"
+
+/// MixPi Settings › Interface, Zoom (spec 2f).
+///
+/// - [MixPi],waveform_zoom_in (+) and [MixPi],waveform_zoom_out (−) are push
+///   buttons; a press steps the saved zoom by one and sets both decks' main
+///   waveforms to it. The step and its ends are those of the Loop panel's −
+///   and + ([ChannelN],waveform_zoom_up/_down: ±1 between 1 and 10). A
+///   smaller number is a closer view, so + takes one off.
+/// - [MixPi],waveform_zoom_position (0-1) sets the saved zoom from a knob's
+///   position, in the same ten steps: 0 (fully left) is zoom 10 (30%), 1
+///   (fully right) is zoom 1 (300%). For the Starlight's SHIFT + knob.
+/// - [MixPi],waveform_zoom_percent (read-only) is the saved zoom as the row's
+///   readout shows it: 3 ÷ zoom, rounded (zoom 3, the default, is 100%).
+/// - [MixPi],waveform_zoom_changing (read-only) is 1 from a change of the
+///   saved zoom until kChangingMs after the last one (the Decks page's brief
+///   indicator). The Loop panel's own buttons do not touch it.
+/// - The setting is Mixxx's own [Waveform],DefaultZoom: the zoom every deck
+///   waveform starts at (WaveformWidgetFactory reads it at start). It is
+///   written to mixxx.cfg by the save on change (R-13), within a second.
+/// - Each change sets both decks to the new setting, so a deck zoomed on its
+///   own with the Loop panel joins the other again. The Loop panel's buttons
+///   stay per deck and are not saved, as in stock Mixxx.
+/// - applyDefault, when given, is called with the new setting after the
+///   decks: Mixxx passes WaveformWidgetFactory::setDefaultZoom, which keeps
+///   the factory's copy (new waveforms, the Preferences dialog) in step.
+class MixpiZoomSetting : public QObject {
+  public:
+    // WaveformWidgetRenderer::s_waveformMinZoom, s_waveformMaxZoom and
+    // s_waveformDefaultZoom; BaseTrackPlayerImpl::slotWaveformZoomUp/Down.
+    static constexpr double kMinZoom = 1.0;
+    static constexpr double kMaxZoom = 10.0;
+    static constexpr double kDefaultZoom = 3.0;
+    static constexpr double kStep = 1.0;
+    static constexpr int kChangingMs = 1000;
+
+    explicit MixpiZoomSetting(UserSettingsPointer pSettings,
+            std::function<void(double)> applyDefault = {},
+            QObject* pParent = nullptr)
+            : QObject(pParent),
+              m_pSettings(std::move(pSettings)),
+              m_applyDefault(std::move(applyDefault)) {
+        m_pZoomIn = button("waveform_zoom_in");
+        connect(m_pZoomIn, &ControlObject::valueChanged, this, [this](double value) {
+            if (value > 0) {
+                setZoom(zoom() - kStep);
+            }
+        });
+        m_pZoomOut = button("waveform_zoom_out");
+        connect(m_pZoomOut, &ControlObject::valueChanged, this, [this](double value) {
+            if (value > 0) {
+                setZoom(zoom() + kStep);
+            }
+        });
+        // Every knob message counts, the same value too (bIgnoreNops false):
+        // the first one may be 0, the control's start value.
+        m_pPosition = new ControlObject(
+                ConfigKey(QStringLiteral("[MixPi]"), QStringLiteral("waveform_zoom_position")), false);
+        m_pPosition->setParent(this);
+        connect(m_pPosition, &ControlObject::valueChanged, this, [this](double value) {
+            if (!std::isfinite(value)) {
+                return;
+            }
+            const double position = std::clamp(value, 0.0, 1.0);
+            setZoom(kMaxZoom - std::round(position * (kMaxZoom - kMinZoom)));
+        });
+        m_pPercent = control("waveform_zoom_percent");
+        m_pPercent->setReadOnly();
+        m_pPercent->forceSet(percent(zoom()));
+        m_pChanging = control("waveform_zoom_changing");
+        m_pChanging->setReadOnly();
+        m_changingTimer.setSingleShot(true);
+        m_changingTimer.setInterval(kChangingMs);
+        connect(&m_changingTimer, &QTimer::timeout, this, [this] {
+            m_pChanging->forceSet(0);
+        });
+    }
+
+    /// The saved zoom, read as WaveformWidgetFactory::setConfig reads it.
+    double zoom() const {
+        bool ok = false;
+        const double value = m_pSettings->getValueString(kDefaultZoomKey).toDouble(&ok);
+        if (!ok || !std::isfinite(value)) {
+            return kDefaultZoom;
+        }
+        return std::clamp(value, kMinZoom, kMaxZoom);
+    }
+
+    /// The readout: 3 ÷ zoom as a rounded percentage.
+    static double percent(double zoom) {
+        return static_cast<double>(std::lround(kDefaultZoom / zoom * 100.0));
+    }
+
+  private:
+    static inline const ConfigKey kDefaultZoomKey =
+            ConfigKey(QStringLiteral("[Waveform]"), QStringLiteral("DefaultZoom"));
+
+    ControlObject* control(const char* item) {
+        auto* pControl = new ControlObject(
+                ConfigKey(QStringLiteral("[MixPi]"), QString::fromLatin1(item)));
+        pControl->setParent(this);
+        return pControl;
+    }
+
+    ControlPushButton* button(const char* item) {
+        auto* pButton = new ControlPushButton(
+                ConfigKey(QStringLiteral("[MixPi]"), QString::fromLatin1(item)));
+        pButton->setParent(this);
+        return pButton;
+    }
+
+    void setZoom(double value) {
+        const double zoom = std::clamp(value, kMinZoom, kMaxZoom);
+        const bool changed = zoom != this->zoom();
+        m_pSettings->setValue(kDefaultZoomKey, zoom);
+        for (const auto* group : {"[Channel1]", "[Channel2]"}) {
+            const ConfigKey key(QString::fromLatin1(group), QStringLiteral("waveform_zoom"));
+            if (ControlObject::exists(key)) {
+                ControlObject::set(key, zoom);
+            }
+        }
+        if (m_applyDefault) {
+            m_applyDefault(zoom);
+        }
+        m_pPercent->forceSet(percent(zoom));
+        if (changed) {
+            m_pChanging->forceSet(1);
+            m_changingTimer.start();
+        }
+    }
+
+    UserSettingsPointer m_pSettings;
+    std::function<void(double)> m_applyDefault;
+    ControlPushButton* m_pZoomIn;
+    ControlPushButton* m_pZoomOut;
+    ControlObject* m_pPosition;
+    ControlObject* m_pPercent;
+    ControlObject* m_pChanging;
+    QTimer m_changingTimer;
+};
