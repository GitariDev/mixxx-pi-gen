+void RekordboxFeature::releaseRemovedDrives(const QModelIndex& parent, int first, int last) {
+    // Spec 2e (owner: "Let just land on the top menu instead"): a drive's row
+    // goes (an eject, or pulled out; onRekordboxDevicesFound). When the list
+    // in Tracks is one of that drive's, the table stops showing its rows; the
+    // menu lands on its top level (WLibrarySidebar::rowsAboutToBeRemoved).
+    // Another drive's list, or a list of This Pi in Tracks, stays. Nothing is
+    // read from or written to the drive.
+    if (parent.isValid()) {
+        return;
+    }
+    const TreeItem* root = m_pSidebarModel->getRootItem();
+    for (int row = first; row <= last && row < root->childRows(); ++row) {
+        if (showsDriveList(m_pRekordboxPlaylistModel->playlist(), *root->child(row))) {
+            m_pRekordboxPlaylistModel->releasePlaylist();
+        }
+    }
+}
