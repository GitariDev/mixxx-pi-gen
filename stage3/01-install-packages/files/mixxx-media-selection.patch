+namespace mixxx::media {
+
+class CopyService final {
+  public:
+    using Observer = std::function<Binding(const std::string&)>;
+    explicit CopyService(std::string directory, std::vector<std::string> roots,
+            Observer observer = observePath)
+            : m_directory(std::move(directory)), m_roots(std::move(roots)),
+              m_observer(std::move(observer)), m_startup(acquireUnknown(Producer::Copy)) {
+        struct stat status {};
+        if (!m_startup || (::mkdir(m_directory.c_str(), 0700) != 0 && errno != EEXIST)) {
+            return;
+        }
+        if (::lstat(m_directory.c_str(), &status) || !S_ISDIR(status.st_mode) ||
+                status.st_uid != ::getuid() || (status.st_mode & 0777) != 0700) {
+            return;
+        }
+        const auto parent = std::filesystem::path(m_directory).parent_path();
+        if (::lstat(parent.c_str(), &status) || !S_ISDIR(status.st_mode) ||
+                status.st_uid != ::getuid() || (status.st_mode & 0777) != 0700) {
+            return;
+        }
+        m_owner = secureFile("owner.lock");
+        m_guard = secureFile("sessions.lock");
+        if (m_owner < 0 || m_guard < 0 || ::flock(m_owner, LOCK_EX | LOCK_NB)) {
+            return;
+        }
+        m_socket = ::socket(AF_UNIX, SOCK_SEQPACKET | SOCK_NONBLOCK | SOCK_CLOEXEC, 0);
+        sockaddr_un address {};
+        address.sun_family = AF_UNIX;
+        const auto path = m_directory + "/control";
+        if (m_socket < 0 || path.size() >= sizeof(address.sun_path)) {
+            if (m_socket >= 0) ::close(m_socket);
+            m_socket = -1;
+            return;
+        }
+        std::copy(path.begin(), path.end(), address.sun_path);
+        ::unlink(path.c_str());
+        if (::bind(m_socket, reinterpret_cast<sockaddr*>(&address), sizeof(address)) ||
+                ::chmod(path.c_str(), 0600) || ::listen(m_socket, 16)) {
+            ::close(m_socket);
+            m_socket = -1;
+        }
+    }
+    ~CopyService() {
+        for (auto& client : m_clients) {
+            ::close(client.socket);
+            ::close(client.process);
+        }
+        if (m_socket >= 0) ::close(m_socket);
+        if (m_guard >= 0) ::close(m_guard);
+        if (m_owner >= 0) ::close(m_owner);
+    }
+    bool ready() const { return m_socket >= 0; }
+    void tick() {
+        if (!ready()) return;
+        if (m_startup && ::flock(m_guard, LOCK_EX | LOCK_NB) == 0) {
+            m_startup.reset();
+            ::flock(m_guard, LOCK_UN);
+        }
+        for (int count = 0; count < 8 && m_clients.size() < 32; ++count) {
+            const int socket = ::accept4(m_socket, nullptr, nullptr, SOCK_NONBLOCK | SOCK_CLOEXEC);
+            if (socket < 0) break;
+            ucred credentials {};
+            socklen_t length = sizeof(credentials);
+            int process = -1;
+            socklen_t processLength = sizeof(process);
+            struct stat ownNamespace {}, peerNamespace {};
+            if (::getsockopt(socket, SOL_SOCKET, SO_PEERCRED, &credentials, &length) ||
+                    (credentials.uid != ::getuid() && credentials.uid != 0) ||
+                    ::getsockopt(socket, SOL_SOCKET, 77, &process, &processLength) ||
+                    (credentials.uid != 0 && (::stat("/proc/self/ns/mnt", &ownNamespace) ||
+                    ::stat(("/proc/" + std::to_string(credentials.pid) + "/ns/mnt").c_str(), &peerNamespace) ||
+                    ownNamespace.st_dev != peerNamespace.st_dev || ownNamespace.st_ino != peerNamespace.st_ino)) ||
+                    exited(process)) {
+                ::close(socket);
+                if (process >= 0) ::close(process);
+                continue;
+            }
+            m_clients.push_back({socket, process, false, {}, {}, std::chrono::steady_clock::now(), credentials.uid == 0, {}, credentials.uid != 0});
+        }
+        for (auto iterator = m_clients.begin(); iterator != m_clients.end();) {
+            auto& client = *iterator;
+            if (!client.begun && std::chrono::steady_clock::now() - client.connected > std::chrono::seconds(2)) {
+                ::close(client.socket);
+                client.socket = -1;
+            }
+            if (exited(client.process)) {
+                if (client.drain) m_orphanDrains.push_back(std::move(client.drain));
+                ::close(client.socket);
+                ::close(client.process);
+                iterator = m_clients.erase(iterator);
+                continue;
+            }
+            if (client.socket >= 0) {
+                char buffer[16384];
+                alignas(cmsghdr) char control[CMSG_SPACE(sizeof(int) * 8)] {};
+                iovec payload {buffer, sizeof(buffer)};
+                msghdr packet {};
+                packet.msg_iov = &payload;
+                packet.msg_iovlen = 1;
+                packet.msg_control = control;
+                packet.msg_controllen = sizeof(control);
+                const auto size = ::recvmsg(client.socket, &packet, MSG_DONTWAIT | MSG_TRUNC | MSG_CMSG_CLOEXEC);
+                std::vector<int> descriptors;
+                for (auto* ancillary = CMSG_FIRSTHDR(&packet); size >= 0 && ancillary;
+                        ancillary = CMSG_NXTHDR(&packet, ancillary)) {
+                    if (ancillary->cmsg_level != SOL_SOCKET || ancillary->cmsg_type != SCM_RIGHTS) continue;
+                    const auto count = (ancillary->cmsg_len - CMSG_LEN(0)) / sizeof(int);
+                    const auto* values = reinterpret_cast<const int*>(CMSG_DATA(ancillary));
+                    descriptors.insert(descriptors.end(), values, values + count);
+                }
+                const bool truncated = packet.msg_flags & (MSG_TRUNC | MSG_CTRUNC);
+                std::string response = "DENIED";
+                if (size > 0 && size < static_cast<ssize_t>(sizeof(buffer)) && !truncated) {
+                    const std::string message(buffer, size);
+                    if (!client.namespaceVerified && client.privileged && message == "NAMESPACE" && descriptors.size() == 1) {
+                        struct stat ownNamespace {}, peerNamespace {};
+                        if (!::stat("/proc/self/ns/mnt", &ownNamespace) &&
+                                !::fstat(descriptors.front(), &peerNamespace) &&
+                                ::ioctl(descriptors.front(), NS_GET_NSTYPE) == CLONE_NEWNS &&
+                                ownNamespace.st_dev == peerNamespace.st_dev && ownNamespace.st_ino == peerNamespace.st_ino &&
+                                !exited(client.process)) {
+                            client.namespaceVerified = true;
+                            response = "OK";
+                        }
+                    } else if (client.namespaceVerified && descriptors.empty()) {
+                        response = request(client, message);
+                    }
+                }
+                for (const int descriptor : descriptors) ::close(descriptor);
+                if (size == 0 || size >= static_cast<ssize_t>(sizeof(buffer)) ||
+                        (size < 0 && errno != EAGAIN && errno != EWOULDBLOCK)) {
+                    ::close(client.socket);
+                    client.socket = -1;
+                } else if (size > 0) {
+                    if (::send(client.socket, response.data(), response.size(), MSG_NOSIGNAL) !=
+                            static_cast<ssize_t>(response.size()) || response == "DENIED") {
+                        ::close(client.socket);
+                        client.socket = -1;
+                    }
+                }
+            }
+            if (client.socket < 0 && client.leases.empty() && !client.drain) {
+                ::close(client.process);
+                iterator = m_clients.erase(iterator);
+            } else {
+                ++iterator;
+            }
+        }
+    }
+  private:
+    struct Path {
+        std::string name;
+        bool create;
+        std::string anchor;
+        dev_t device;
+        ino_t inode;
+    };
+    struct Client {
+        int socket;
+        int process;
+        bool begun;
+        std::vector<Path> paths;
+        std::vector<Lease> leases;
+        std::chrono::steady_clock::time_point connected;
+        bool privileged;
+        std::unique_ptr<MediaUseRegistry::Drain> drain;
+        bool namespaceVerified;
+    };
+    static bool exited(int process) {
+        pollfd descriptor {process, POLLIN, 0};
+        return process >= 0 && ::poll(&descriptor, 1, 0) > 0 && (descriptor.revents & POLLIN);
+    }
+    int secureFile(const std::string& name) {
+        const int descriptor = ::open((m_directory + "/" + name).c_str(),
+                O_CREAT | O_RDWR | O_NOFOLLOW | O_CLOEXEC, 0600);
+        struct stat status {};
+        if (descriptor < 0) return -1;
+        if (::fstat(descriptor, &status) || !S_ISREG(status.st_mode) || status.st_uid != ::getuid() ||
+                status.st_nlink != 1 || (status.st_mode & 0777) != 0600) {
+            ::close(descriptor);
+            return -1;
+        }
+        return descriptor;
+    }
+    Binding resolve(Path& path, bool initial) {
+        const std::filesystem::path requested(path.name);
+        if (path.name.size() > 4096 || !requested.is_absolute() ||
+                requested.lexically_normal() != requested ||
+                std::any_of(path.name.begin(), path.name.end(), [](unsigned char byte) { return byte < 32; }) ||
+                std::none_of(m_roots.begin(), m_roots.end(), [&](const auto& root) {
+                    return path.name == root || path.name.compare(0, root.size() + 1, root + "/") == 0;
+                })) return {};
+        std::filesystem::path current("/");
+        struct stat status {};
+        bool missing = false;
+        std::string ancestor;
+        for (const auto& part : requested.relative_path()) {
+            current /= part;
+            if (missing) continue;
+            if (::lstat(current.c_str(), &status)) {
+                if (errno != ENOENT || !path.create || ancestor.empty()) return {};
+                missing = true;
+            } else {
+                if (!S_ISDIR(status.st_mode) && !(current == requested && S_ISREG(status.st_mode))) return {};
+                ancestor = current.string();
+            }
+        }
+        if (ancestor.empty() || std::none_of(m_roots.begin(), m_roots.end(), [&](const auto& root) {
+                    return ancestor == root || ancestor.compare(0, root.size() + 1, root + "/") == 0;
+                })) return {};
+        if (initial) {
+            path.anchor = ancestor;
+            if (::lstat(ancestor.c_str(), &status)) return {};
+            path.device = status.st_dev;
+            path.inode = status.st_ino;
+        } else if (::lstat(path.anchor.c_str(), &status) ||
+                status.st_dev != path.device || status.st_ino != path.inode) {
+            return {};
+        }
+        auto binding = m_observer(ancestor);
+        if (binding.generation.empty() || binding.source.empty() || !binding.descriptor) return {};
+        return binding;
+    }
+    static std::string hex(const std::string& value) {
+        std::string output;
+        for (unsigned char byte : value) {
+            output += "0123456789abcdef"[byte >> 4];
+            output += "0123456789abcdef"[byte & 15];
+        }
+        return output;
+    }
+    std::string request(Client& client, const std::string& message) {
+        if (client.privileged && message.compare(0, 6, "DRAIN\n") == 0 && !client.begun && !m_startup) {
+            const auto generation = message.substr(6);
+            if (generation.empty() || generation.size() > 4096 || generation.find('\n') != std::string::npos ||
+                    generation.find('\0') != std::string::npos) return "DENIED";
+            auto drain = registry().beginDrain(generation);
+            if (!drain) return "DENIED";
+            client.drain = std::make_unique<MediaUseRegistry::Drain>(std::move(drain));
+            client.begun = true;
+            return client.drain->snapshot().locallyIdle() ? "IDLE" : "BUSY";
+        }
+        if (client.drain) {
+            if (message == "DRAIN_STATUS") return client.drain->snapshot().locallyIdle() ? "IDLE" : "BUSY";
+            if (message == "DRAIN_COMMIT") {
+                if (!client.drain->retire()) return "DENIED";
+                client.drain.reset();
+                return "OK";
+            }
+            if (message == "DRAIN_CANCEL") {
+                client.drain.reset();
+                return "OK";
+            }
+            return "DENIED";
+        }
+        if (client.privileged && ::getuid() != 0) return "DENIED";
+        if (!client.begun && message.compare(0, 6, "BEGIN\n") == 0 && !m_startup) {
+            std::istringstream input(message.substr(6));
+            std::string line, response = "OK";
+            std::vector<Path> paths;
+            std::vector<Lease> leases;
+            while (std::getline(input, line)) {
+                if (paths.size() >= 6 || line.size() < 3 || (line[0] != 'R' && line[0] != 'W')) return "DENIED";
+                Path path {line.substr(1), line[0] == 'W', {}, 0, 0};
+                auto binding = resolve(path, true);
+                if (binding.generation.empty()) return "DENIED";
+                auto lease = registry().acquire(binding, Producer::Copy);
+                if (!lease || !lease->matches(resolve(path, false))) return "DENIED";
+                response += "\n" + hex(binding.generation) + ":" + hex(binding.source);
+                paths.push_back(std::move(path));
+                leases.push_back(std::move(lease));
+            }
+            if (paths.empty() || response.size() >= 16384) return "DENIED";
+            client.paths = std::move(paths);
+            client.leases = std::move(leases);
+            client.begun = true;
+            return response;
+        }
+        if (!client.begun || client.leases.empty()) return "DENIED";
+        if (message == "FINISH" || message == "CANCEL") {
+            client.leases.clear();
+            return "OK";
+        }
+        if (message != "CHECK" && message.compare(0, 6, "CHECK\n") != 0) return "DENIED";
+        for (std::size_t index = 0; index < client.paths.size(); ++index) {
+            if (!client.leases[index]->matches(resolve(client.paths[index], false))) return "DENIED";
+        }
+        if (message != "CHECK") {
+            const auto requested = message.substr(6);
+            bool matched = false;
+            for (std::size_t index = 0; index < client.paths.size(); ++index) {
+                const auto& parent = client.paths[index];
+                if (requested != parent.name && requested.compare(0, parent.name.size() + 1, parent.name + "/") != 0) continue;
+                Path path {requested, parent.create, {}, 0, 0};
+                if (client.leases[index]->matches(resolve(path, true))) matched = true;
+            }
+            if (!matched) return "DENIED";
+        }
+        return "OK";
+    }
+    std::string m_directory;
+    std::vector<std::string> m_roots;
+    Observer m_observer;
+    Lease m_startup;
+    int m_owner = -1;
+    int m_guard = -1;
+    int m_socket = -1;
+    std::vector<Client> m_clients;
+    std::vector<std::unique_ptr<MediaUseRegistry::Drain>> m_orphanDrains;
+};
+
+inline CopyService& copyService() {
+    static auto* service = [] {
+        const auto* user = ::getpwuid(::getuid());
+        const std::string name = user ? user->pw_name : "";
+        const std::string home = user ? user->pw_dir : "";
+        return new CopyService("/run/user/" + std::to_string(::getuid()) + "/mixpi-copy",
+                name.empty() ? std::vector<std::string>{} :
+                        std::vector<std::string>{home, "/media/" + name, "/run/media/" + name});
+    }();
+    return *service;
+}
+
+}
+#endif
