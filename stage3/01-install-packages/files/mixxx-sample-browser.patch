+void Library::setupSampleBrowser() {
+    // [MixPi],sample_load: the skin's Load sample screen (R-8). Made here,
+    // before the skin, so every write (the skin's buttons, a drive opened
+    // from the media screen) comes through the request below.
+    m_pShownPlace = std::make_unique<LibraryInterface::BrowsePlace>();
+    m_pSampleBrowser = std::make_unique<LibraryInterface::SampleBrowser>();
+    m_pSampleLoad.reset(new ControlObject(ConfigKey("[MixPi]", "sample_load")));
+    m_pSampleSource.reset(new ControlObject(ConfigKey("[MixPi]", "sample_source")));
+    // The skin shows its source buttons once this says they work.
+    m_pSampleSourceAvailable.reset(new ControlObject(
+            ConfigKey("[MixPi]", "sample_source_available")));
+    m_pSampleSourceAvailable->set(1);
+    m_pSampleSourceAvailable->setReadOnly();
+    // 1 while a drive is open: the skin shows its USB source button.
+    m_pSampleDriveAvailable.reset(new ControlObject(
+            ConfigKey("[MixPi]", "sample_drive_available")));
+    m_pSampleDriveAvailable->setReadOnly();
+    auto* browser = m_pSampleBrowser.get();
+    browser->capture = [this] {
+        LibraryInterface::BrowsePlace place = *m_pShownPlace;
+        place.search = browseSearch();
+        place.scroll = browseScroll();
+        return place;
+    };
+    browser->show = [this](const LibraryInterface::BrowsePlace& place) {
+        showBrowsePlace(place);
+    };
+    browser->locate = [this](const LibraryInterface::BrowsePlace& place) {
+        return LibraryInterface::locatePlace(m_pSidebarModel, place, SidebarModel::DataRole);
+    };
+    browser->sourcePlace = [this](int source) {
+        return sampleSourcePlace(source);
+    };
+    browser->sourceChanged = [this](int source) {
+        m_pSampleSource->setAndConfirm(source);
+    };
+    m_pSampleLoad->connectValueChangeRequest(this, [this](double value) {
+        const bool on = value > 0;
+        m_pSampleLoad->setAndConfirm(on ? 1 : 0);
+        m_pSampleBrowser->setActive(on);
+    });
+    m_pSampleSource->connectValueChangeRequest(this, [this](double value) {
+        // A push button also writes 0 on release: that changes nothing.
+        if (value > 0) {
+            m_pSampleBrowser->choose(static_cast<int>(value));
+        }
+    });
+    // A drive pulled out (its rows go) while sample mode shows it: back to
+    // the Samples folder, once the model has settled.
+    auto changed = [this] {
+        QTimer::singleShot(0, this, [this] {
+            if (m_pSampleBrowser) {
+                m_pSampleBrowser->sourcesChanged();
+            }
+            if (m_pSampleDriveAvailable) {
+                m_pSampleDriveAvailable->setAndConfirm(driveRows().isEmpty() ? 0 : 1);
+            }
+        });
+    };
+    connect(m_pSidebarModel, &QAbstractItemModel::rowsInserted, this, changed);
+    connect(m_pSidebarModel, &QAbstractItemModel::rowsRemoved, this, changed);
+    connect(m_pSidebarModel, &QAbstractItemModel::modelReset, this, changed);
+}
+
+void Library::leaveSampleMode(bool restoreTracks) {
+    if (m_pSampleBrowser) {
+        m_pSampleBrowser->leave(restoreTracks);
+    }
+    if (m_pSampleLoad) {
+        m_pSampleLoad->setAndConfirm(0);
+    }
+}
+
+void Library::noteBrowsePlaceShown() {
+    if (!m_pSidebarWidget || !m_pShownPlace) {
+        return;
+    }
+    // The row that was just activated is the current one.
+    *m_pShownPlace = LibraryInterface::browsePlace(
+            m_pSidebarWidget->currentIndex(), SidebarModel::DataRole);
+    if (m_pSampleBrowser) {
+        m_pSampleBrowser->shown(*m_pShownPlace);
+    }
+}
+
+QModelIndex Library::sourceRow(const QString& id) const {
+    for (const auto& source : m_sidebarSources) {
+        if (source.id == id && source.feature) {
+            const int row = m_features.indexOf(source.feature);
+            return row < 0 ? QModelIndex() : m_pSidebarModel->index(row, 0);
+        }
+    }
+    return {};
+}
+
+QList<QModelIndex> Library::driveRows() {
+    QStringList keys;
+    QList<QModelIndex> rows;
+    auto add = [&keys, &rows](const QString& path, const QModelIndex& index) {
+        const QString key = QDir::cleanPath(path);
+        if (!path.isEmpty() && !keys.contains(key)) {
+            keys.append(key);
+            rows.append(index);
+        }
+    };
+    // A rekordbox drive: one row per drive under Rekordbox; its data starts
+    // with the mount path.
+    const QModelIndex rekordbox = sourceRow(QStringLiteral("RekordboxFeature"));
+    for (int row = 0; rekordbox.isValid() && row < m_pSidebarModel->rowCount(rekordbox); ++row) {
+        const QModelIndex index = m_pSidebarModel->index(row, 0, rekordbox);
+        add(index.data(SidebarModel::DataRole).toList().value(0).toString(), index);
+    }
+    // Any other drive: the Computer row it was opened in. The fixed rows
+    // (Quick Links, Removable Devices, /, Samples) are not drives.
+    const QModelIndex computer = sourceRow(QStringLiteral("BrowseFeature"));
+    const QStringList fixed{QStringLiteral(QUICK_LINK_NODE), QStringLiteral(DEVICE_NODE),
+            QDir::cleanPath(QDir::rootPath()), QDir::cleanPath(m_samplesPath)};
+    for (int row = 0; computer.isValid() && row < m_pSidebarModel->rowCount(computer); ++row) {
+        const QModelIndex index = m_pSidebarModel->index(row, 0, computer);
+        const QVariant data = index.data(SidebarModel::DataRole);
+        const QString path = data.userType() == QMetaType::QString ? data.toString() : QString();
+        if (!path.isEmpty() && !fixed.contains(QDir::cleanPath(path)) &&
+                !path.startsWith(QStringLiteral("::")) && QFileInfo(path).isDir()) {
+            add(path, index);
+        }
+    }
+    // Plug-in order: the order in which they were first seen.
+    for (int position = m_driveOrder.size() - 1; position >= 0; --position) {
+        if (!keys.contains(m_driveOrder.at(position))) {
+            m_driveOrder.removeAt(position);
+        }
+    }
+    for (const auto& key : std::as_const(keys)) {
+        if (!m_driveOrder.contains(key)) {
+            m_driveOrder.append(key);
+        }
+    }
+    QList<QModelIndex> ordered;
+    for (const auto& key : std::as_const(m_driveOrder)) {
+        ordered.append(rows.at(keys.indexOf(key)));
+    }
+    return ordered;
+}
+
+LibraryInterface::BrowsePlace Library::sampleSourcePlace(int source) {
+    QModelIndex index;
+    switch (source) {
+    case LibraryInterface::SampleBrowser::kSamples: {
+        // The Samples folder's row under Computer.
+        const QModelIndex computer = sourceRow(QStringLiteral("BrowseFeature"));
+        for (int row = 0; computer.isValid() && row < m_pSidebarModel->rowCount(computer); ++row) {
+            const QModelIndex child = m_pSidebarModel->index(row, 0, computer);
+            const QVariant data = child.data(SidebarModel::DataRole);
+            if (data.userType() == QMetaType::QString &&
+                    QDir::cleanPath(data.toString()) == QDir::cleanPath(m_samplesPath)) {
+                index = child;
+                break;
+            }
+        }
+        break;
+    }
+    case LibraryInterface::SampleBrowser::kCollection:
+        index = sourceRow(QStringLiteral("MixxxLibraryFeature"));
+        break;
+    case LibraryInterface::SampleBrowser::kDrive: {
+        const auto drives = driveRows();
+        if (!drives.isEmpty()) {
+            index = drives.first();
+        }
+        break;
+    }
+    case LibraryInterface::SampleBrowser::kRecordings:
+        index = sourceRow(QStringLiteral("RecordingFeature"));
+        break;
+    default:
+        break;
+    }
+    return index.isValid() ? LibraryInterface::browsePlace(index, SidebarModel::DataRole)
+                           : LibraryInterface::BrowsePlace{};
+}
+
+void Library::showBrowsePlace(const LibraryInterface::BrowsePlace& place) {
+    if (!m_pSidebarWidget) {
+        return;
+    }
+    const QModelIndex index = LibraryInterface::locatePlace(
+            m_pSidebarModel, place, SidebarModel::DataRole);
+    if (index.isValid()) {
+        m_pSidebarWidget->selectIndex(index);
+        m_pSidebarModel->clicked(index);
+        *m_pShownPlace = LibraryInterface::browsePlace(index, SidebarModel::DataRole);
+    } else {
+        // The place is gone (a drive pulled out): the start source.
+        m_pSidebarModel->activateDefaultSelection();
+    }
+    // Each place has its own search text: the box and the list.
+    emit restoreSearch(place.search);
+    emit search(place.search);
+    // The list has its rows after this event.
+    const int scroll = place.scroll;
+    setBrowseScroll(scroll);
+    QTimer::singleShot(0, this, [this, scroll] { setBrowseScroll(scroll); });
+}
+
+QString Library::browseSearch() const {
+    auto* pView = m_pLibraryWidget ? m_pLibraryWidget->getCurrentTrackTableView() : nullptr;
+    auto* pModel = pView ? dynamic_cast<TrackModel*>(pView->model()) : nullptr;
+    return pModel ? pModel->currentSearch() : QString();
+}
+
+int Library::browseScroll() const {
+    auto* pView = m_pLibraryWidget ? m_pLibraryWidget->getCurrentTrackTableView() : nullptr;
+    return pView ? pView->verticalScrollBar()->value() : 0;
+}
+
+void Library::setBrowseScroll(int scroll) {
+    auto* pView = m_pLibraryWidget ? m_pLibraryWidget->getCurrentTrackTableView() : nullptr;
+    if (pView) {
+        pView->verticalScrollBar()->setValue(scroll);
+    }
+}
