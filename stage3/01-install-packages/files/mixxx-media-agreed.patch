+// The close control of every MixPi view (agreed UI, section 1): a square on
+// --mx-surface-2 with a red ✕ drawn as two 20 x 2.5 px strokes, no outline at
+// rest. The stylesheet paints the square and its pressed state; the strokes
+// take the button's text colour (QSS color), so the colour stays in the QSS.
+class MixpiCloseButton : public QPushButton {
+  public:
+    static constexpr double kStroke = 20.0;
+    static constexpr double kWidth = 2.5;
+    explicit MixpiCloseButton(QWidget* parent)
+            : QPushButton(parent) {
+        setObjectName(QStringLiteral("MixpiPageClose"));
+        setAccessibleName(QStringLiteral("Close"));
+        setFocusPolicy(Qt::NoFocus);
+    }
+
+  protected:
+    void paintEvent(QPaintEvent*) override {
+        QStylePainter painter(this);
+        QStyleOptionButton option;
+        initStyleOption(&option);
+        option.text.clear();
+        painter.drawControl(QStyle::CE_PushButton, option);
+        painter.setRenderHint(QPainter::Antialiasing);
+        painter.setPen(Qt::NoPen);
+        painter.setBrush(palette().color(QPalette::ButtonText));
+        painter.translate(width() / 2.0, height() / 2.0);
+        for (const double angle : {45.0, -45.0}) {
+            painter.save();
+            painter.rotate(angle);
+            painter.drawRoundedRect(QRectF(-kStroke / 2, -kWidth / 2, kStroke, kWidth), 1, 1);
+            painter.restore();
+        }
+    }
+};
