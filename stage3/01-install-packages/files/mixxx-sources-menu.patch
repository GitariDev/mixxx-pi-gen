+    };
+    return paths.value(name);
+}
 
+// NAME in COLOUR, SIZE px square (null for an unknown name, or without
+// Qt's SVG image reader).
+inline QPixmap pixmap(const QString& name, const QColor& colour, int size, qreal ratio = 1.0) {
+    const QString body = svg(name);
+    if (body.isEmpty()) {
+        return {};
+    }
+    const int pixels = qRound(size * ratio);
+    const QString document = QStringLiteral(
+            "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"%1\" height=\"%1\" viewBox=\"0 0 24 24\" "
+            "fill=\"none\" stroke=\"%2\" stroke-width=\"1.8\" stroke-linecap=\"round\" "
+            "stroke-linejoin=\"round\">%3</svg>")
+                                     .arg(QString::number(pixels), colour.name(QColor::HexRgb), body);
+    QPixmap result;
+    if (!result.loadFromData(document.toUtf8(), "SVG")) {
+        return {};
+    }
+    result.setDevicePixelRatio(ratio);
+    return result;
+}
+
+// An icon from the library (a source's own icon) in one colour.
+inline QPixmap tinted(const QIcon& icon, const QColor& colour, int size, qreal ratio = 1.0) {
+    QPixmap shape = icon.pixmap(QSize(size, size), ratio);
+    if (shape.isNull()) {
+        return {};
+    }
+    QPainter painter(&shape);
+    painter.setCompositionMode(QPainter::CompositionMode_SourceIn);
+    painter.fillRect(shape.rect(), colour);
+    return shape;
+}
