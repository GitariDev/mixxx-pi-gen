+// Spec 2e, as 2g applies it: the mount table. The mount point is the fifth
+// field, with a space written \040 (octal).
+const QString kMountTable = QStringLiteral("/proc/self/mountinfo");
+
+QStringList mountPoints() {
+    QStringList points;
+    QFile table(kMountTable);
+    if (!table.open(QIODevice::ReadOnly)) {
+        return points;
+    }
+    const QList<QByteArray> lines = table.readAll().split('\n');
+    for (const QByteArray& line : lines) {
+        const QList<QByteArray> fields = line.split(' ');
+        if (fields.size() < 5) {
+            continue;
+        }
+        const QByteArray& escaped = fields.at(4);
+        QByteArray point;
+        for (int at = 0; at < escaped.size(); ++at) {
+            bool octal = false;
+            const int value = escaped.at(at) == '\\' && at + 3 < escaped.size()
+                    ? escaped.mid(at + 1, 3).toInt(&octal, 8)
+                    : 0;
+            if (octal) {
+                point.append(static_cast<char>(value));
+                at += 3;
+            } else {
+                point.append(escaped.at(at));
+            }
+        }
+        points.append(QFile::decodeName(point));
+    }
+    return points;
+}
+
+// The mount that holds a folder: the longest mount point it lies in.
+QString mountOf(const QString& folder) {
+    const QString path = QDir::cleanPath(folder);
+    QString found;
+    for (const QString& point : mountPoints()) {
+        const bool holds = path == point ||
+                path.startsWith(point.endsWith(QChar('/')) ? point : point + QChar('/'));
+        if (holds && point.size() > found.size()) {
+            found = point;
+        }
+    }
+    return found;
+}
