+void LibraryScannerDlg::slotPercent(int percent) {
+    if (!m_bActive) {
+        return;
     }
+    // Capped at 99 until the scan has finished, and never going down.
+    const int value = qBound(m_percent, percent, 99);
+    if (value == m_percent && m_pPercent && m_pPercent->get() == value) {
+        return;
+    }
+    m_percent = value;
+    if (m_pPercent) {
+        m_pPercent->setAndConfirm(value);
+    }
+    m_pProgress->setValue(value);
+    m_pPercentLabel->setText(QStringLiteral("%1%").arg(value));
 }
 
+void LibraryScannerDlg::slotHide() {
+    // The scan goes on; the USB chip carries the percent.
+    setBarHidden(true);
+}
+
