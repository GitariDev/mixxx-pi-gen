+// A source icon: a mockup glyph (or else the source's own icon) drawn in the
+// widget's text colour, which the style sheet sets (the source colour).
+class SourceGlyph final : public QWidget {
+  public:
+    explicit SourceGlyph(QWidget* parent)
+            : QWidget(parent) {
+        setAttribute(Qt::WA_TransparentForMouseEvents);
+        setFixedSize(kSourceGlyphSize, kSourceGlyphSize);
+    }
+    void setGlyph(const QString& name, const QIcon& fallback = {}) {
+        m_name = name;
+        m_fallback = fallback;
+        update();
+    }
+    QString glyph() const {
+        return m_name;
+    }
+    // What is drawn now (for checks): the glyph, else the tinted icon.
+    QPixmap drawn() const {
+        const QColor colour = palette().color(QPalette::WindowText);
+        QPixmap pixmap = SourceGlyphs::pixmap(m_name, colour, kSourceGlyphSize, devicePixelRatioF());
+        return pixmap.isNull() ? SourceGlyphs::tinted(m_fallback, colour, kSourceGlyphSize,
+                                         devicePixelRatioF())
+                               : pixmap;
+    }
+
+  protected:
+    void paintEvent(QPaintEvent*) override {
+        const QPixmap pixmap = drawn();
+        if (!pixmap.isNull()) {
+            QPainter(this).drawPixmap(0, 0, pixmap);
+        }
+    }
+
+  private:
+    QString m_name;
+    QIcon m_fallback;
+};
