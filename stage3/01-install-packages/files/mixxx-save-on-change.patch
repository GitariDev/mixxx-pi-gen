+
+struct ConfigAutosaveTiming {
+    // A change is seen within pollMs and written quietMs after it was seen,
+    // so a single change is on disk 1.0 to about 1.3 s after it was made.
+    int pollMs = 250;
+    int quietMs = 1000;
+    int maxDelayMs = 5000;
+    int retryMs = 5000;
+    int savedPulseMs = 2000;
+    // The list of persist controls is rebuilt every 10 s.
+    int persistentRefreshPolls = 40;
+};
+
+/// MixPi save on change: writes mixxx.cfg shortly after a setting changes,
+/// so a power cut or a killed process does not lose it.
+///
+/// Runs on the GUI thread. Every poll it copies the current values of all
+/// controls marked "persist" into the config (the values the quit-time save
+/// would write) and then, when the config holds unsaved changes, it saves
+/// once no change has been seen for quietMs, or at the latest maxDelayMs
+/// after the first unsaved change. The write itself runs on a worker
+/// thread, never on the GUI or the audio thread. Nothing is written while
+/// nothing changes. After each successful write [MixPi],saved is 1 for
+/// savedPulseMs.
+class ConfigAutosave final {
+  public:
+    using Timing = ConfigAutosaveTiming;
+
+    explicit ConfigAutosave(QSharedPointer<ConfigObject<ConfigValue>> pConfig,
+            Timing timing = Timing());
+    ~ConfigAutosave();
+    ConfigAutosave(const ConfigAutosave&) = delete;
+    ConfigAutosave& operator=(const ConfigAutosave&) = delete;
+
+    void start();
+    /// Stops polling and waits for a write in progress. Call it before the
+    /// quit-time save.
+    void stop();
+
+    /// Copies the current value of every live persist control into pConfig,
+    /// in the format ~ControlDoublePrivate writes at quit.
+    static void copyPersistentControls(ConfigObject<ConfigValue>* pConfig);
+
+    /// Sets [MixPi],saved to 1; the ConfigAutosave that owns the control
+    /// sets it back to 0 after savedPulseMs. Used by the sampler bank too.
+    static void pulseSaved();
+    static ConfigKey savedKey();
+
+  private:
+    void poll();
+    void copyPersistentControlsCached();
+    void writeFinished(bool ok);
+
+    const QSharedPointer<ConfigObject<ConfigValue>> m_pConfig;
+    const Timing m_timing;
+    std::unique_ptr<QObject> m_pContext;
+    std::unique_ptr<QTimer> m_pPollTimer;
+    std::unique_ptr<QTimer> m_pPulseTimer;
+    std::unique_ptr<QThreadPool> m_pWorker;
+    std::unique_ptr<ControlObject> m_pSaved;
+    QList<QWeakPointer<ControlDoublePrivate>> m_persistentControls;
+    int m_pollsSinceRefresh;
+    bool m_writing;
+    quint64 m_lastSeenChangeCount;
+    QElapsedTimer m_sinceChange;
+    QElapsedTimer m_sinceFirstUnsaved;
+    QElapsedTimer m_sinceFailure;
+};
