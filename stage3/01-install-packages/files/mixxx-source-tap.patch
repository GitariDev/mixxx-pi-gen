diff --git a/src/widget/wlibrarysidebar.cpp b/src/widget/wlibrarysidebar.cpp
index 1765266..9129187 100644
--- a/src/widget/wlibrarysidebar.cpp
+++ b/src/widget/wlibrarysidebar.cpp
@@ -382,9 +382,65 @@ void WLibrarySidebar::mousePressEvent(QMouseEvent* event) {
     if (event->buttons().testFlag(Qt::RightButton)) {
         return;
     }
+    if (m_touchNavigation && event->button() == Qt::LeftButton) {
+        // QAbstractItemView would emit pressed() here, and SidebarModel opens
+        // a pressed row after 300 ms even when no click follows (a drag).
+        // Remember the row; mouseReleaseEvent() opens it on a tap only.
+#if QT_VERSION >= QT_VERSION_CHECK(6, 0, 0)
+        m_touchPressIndex = indexAt(event->position().toPoint());
+#else
+        m_touchPressIndex = indexAt(event->pos());
+#endif
+        event->accept();
+        return;
+    }
     QTreeView::mousePressEvent(event);
 }
 
+void WLibrarySidebar::mouseMoveEvent(QMouseEvent* event) {
+    if (m_touchNavigation && event->buttons().testFlag(Qt::LeftButton)) {
+        // No drag selection: the highlight stays on the source that is shown.
+        // The scroll bar is a separate widget and still scrolls the list.
+        event->accept();
+        return;
+    }
+    QTreeView::mouseMoveEvent(event);
+}
+
+void WLibrarySidebar::mouseReleaseEvent(QMouseEvent* event) {
+    if (!m_touchNavigation || event->button() != Qt::LeftButton) {
+        QTreeView::mouseReleaseEvent(event);
+        return;
+    }
+    event->accept();
+#if QT_VERSION >= QT_VERSION_CHECK(6, 0, 0)
+    const QModelIndex index = indexAt(event->position().toPoint());
+#else
+    const QModelIndex index = indexAt(event->pos());
+#endif
+    const QPersistentModelIndex pressed = m_touchPressIndex;
+    m_touchPressIndex = QPersistentModelIndex();
+    if (!index.isValid() || index != pressed) {
+        // Released on another row, or the rows changed under the finger
+        // (for example a USB hot-plug): open nothing.
+        return;
+    }
+    selectionModel()->setCurrentIndex(index,
+            QItemSelectionModel::ClearAndSelect | QItemSelectionModel::Rows);
+    // The same signal a mouse click emits: SidebarModel::clicked() opens the
+    // source at once and TouchSourceNavigation enters it.
+    emit clicked(index);
+}
+
+void WLibrarySidebar::mouseDoubleClickEvent(QMouseEvent* event) {
+    if (m_touchNavigation && event->button() == Qt::LeftButton) {
+        // A second quick tap is a new tap, not a double-click.
+        mousePressEvent(event);
+        return;
+    }
+    QTreeView::mouseDoubleClickEvent(event);
+}
+
 void WLibrarySidebar::focusInEvent(QFocusEvent* event) {
     // Clear the current index, i.e. remove the focus indicator
     selectionModel()->clearCurrentIndex();
