+// Spec 2e (build J): the list shown (RekordboxPlaylistModel::playlist) is one
+// of this drive's: its Tracks row (the drive's path) or a playlist below it.
+bool showsDriveList(const QString& shown, const TreeItem& device) {
+    const QString path = device.getData().toList().value(0).toString();
+    return !path.isEmpty() && !shown.isEmpty() &&
+            (shown == path || shown.startsWith(path + kPLaylistPathDelimiter));
+}
