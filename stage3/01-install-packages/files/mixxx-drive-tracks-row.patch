+void RekordboxFeature::addDriveTracksRows() {
+    if (m_trackImportActive) {
+        return;
+    }
+    // On the GUI thread, through the model: the row is announced like any
+    // other. A failed or cancelled import has its retry marker back.
+    TreeItem* root = m_pSidebarModel->getRootItem();
+    for (int row = 0; row < root->childRows(); ++row) {
+        const TreeItem* device = root->child(row);
+        if (device->getData().toList().value(1).toString() != IS_NOT_RECORDBOX_DEVICE ||
+                (device->childRows() > 0 && isDriveTracksRow(*device, *device->child(0)))) {
+            continue;
+        }
+        std::vector<std::unique_ptr<TreeItem>> rows;
+        rows.push_back(driveTracksRow(*device));
+        m_pSidebarModel->insertTreeItemRows(std::move(rows), 0, m_pSidebarModel->index(row, 0));
+    }
+}
+
+void RekordboxFeature::selectShownDriveTracks() {
+    const QString shown = m_pRekordboxPlaylistModel->playlist();
+    const TreeItem* root = m_pSidebarModel->getRootItem();
+    for (int row = 0; row < root->childRows(); ++row) {
+        const TreeItem* device = root->child(row);
+        if (device->getData().toList().value(0).toString() == shown && device->childRows() > 0 &&
+                isDriveTracksRow(*device, *device->child(0))) {
+            emit featureSelect(this, m_pSidebarModel->index(0, 0, m_pSidebarModel->index(row, 0)));
+            return;
+        }
+    }
+}
