+// R-6 gate: eject (engine A) is available only when this file is a regular
+// file (not a link) owned by root (owner), not writable by group or others,
+// and holds exactly "v1\n". Nothing in Mixxx writes it: the image writes it
+// only for MIXPI_MEDIA_EJECT=1, and artifact mode requires it absent.
+inline bool mixpiEjectGateOpen(const QString& path = QStringLiteral("/etc/mixpi/media-eject"), uint owner = 0) {
+    const QByteArray native = QFile::encodeName(path);
+    struct stat metadata {};
+    if (::lstat(native.constData(), &metadata) != 0 || !S_ISREG(metadata.st_mode) ||
+            metadata.st_uid != owner || (metadata.st_mode & 0022) || metadata.st_size > 16) {
+        return false;
+    }
+    QFile file(path);
+    return file.open(QIODevice::ReadOnly) && file.readAll() == "v1\n";
+}
+
+// R-5 handover: the decks and pads that keep playing from their Pi copy after
+// an eject. Sets [ChannelN],mixpi_on_pi / [SamplerN],mixpi_on_pi through the
+// callback, and clears them on that player's next load or unload.
+class MixpiHandover {
+  public:
+    using SetOnPi = std::function<void(const QString& group, double value)>;
+    explicit MixpiHandover(SetOnPi setOnPi)
+            : m_setOnPi(std::move(setOnPi)) {
+    }
+
+    // The unmount is confirmed: every user on a copy is now "on Pi".
+    void ejected(const QList<MixpiMediaUser>& users) {
+        for (const auto& user : users) {
+            if (!user.onCopy) {
+                continue;
+            }
+            m_items.removeIf([&](const MixpiHandoverItem& item) { return item.group == user.group; });
+            m_items.append({user.group, user.title});
+            if (m_setOnPi) {
+                m_setOnPi(user.group, 1);
+            }
+        }
+    }
+
+    // The player loaded something else or was unloaded: its copy goes.
+    void trackChanged(const QString& group) {
+        for (int index = 0; index < m_items.size(); ++index) {
+            if (m_items[index].group != group) {
+                continue;
+            }
+            m_cleaned.prepend(m_items[index].title);
+            while (m_cleaned.size() > 3) {
+                m_cleaned.removeLast();
+            }
+            m_items.removeAt(index);
+            if (m_setOnPi) {
+                m_setOnPi(group, 0);
+            }
+            return;
+        }
+    }
+
+    QList<MixpiHandoverItem> items() const {
+        return m_items;
+    }
+    QStringList cleaned() const {
+        return m_cleaned;
+    }
+
+  private:
+    SetOnPi m_setOnPi;
+    QList<MixpiHandoverItem> m_items;
+    QStringList m_cleaned;
+};
