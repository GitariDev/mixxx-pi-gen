#!/usr/bin/python3
"""Run a command in the logged-in user's Sway session, including over SSH."""
import glob
import os
from pathlib import Path
import stat
import subprocess
import sys

if len(sys.argv) < 2:
    sys.exit("Usage: mixpi-session COMMAND [ARG ...] (run as the desktop user)")

env = os.environ.copy()
env["XDG_RUNTIME_DIR"] = f"/run/user/{os.getuid()}"
env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={env['XDG_RUNTIME_DIR']}/bus"
result = subprocess.run(["systemctl", "--user", "show-environment"],
    env=env, text=True, capture_output=True)
for line in result.stdout.splitlines():
    key, sep, value = line.partition("=")
    if sep and key in {"WAYLAND_DISPLAY", "SWAYSOCK", "DISPLAY", "XDG_CURRENT_DESKTOP"}:
        env[key] = value

def socket_path(path):
    try:
        return stat.S_ISSOCK(Path(path).stat().st_mode)
    except OSError:
        return False

if not socket_path(env.get("SWAYSOCK", "")):
    sockets = [p for p in glob.glob(f"{env['XDG_RUNTIME_DIR']}/sway-ipc.{os.getuid()}.*.sock")
               if socket_path(p)]
    if len(sockets) != 1:
        sys.exit("No unique Sway session found. Log in on the Pi display first.")
    env["SWAYSOCK"] = sockets[0]
if not socket_path(str(Path(env["XDG_RUNTIME_DIR"]) / env.get("WAYLAND_DISPLAY", ""))):
    displays = [p for p in glob.glob(f"{env['XDG_RUNTIME_DIR']}/wayland-*") if socket_path(p)]
    if len(displays) != 1:
        sys.exit("No unique Wayland display found.")
    env["WAYLAND_DISPLAY"] = Path(displays[0]).name
os.execvpe(sys.argv[1], sys.argv[1:], env)
