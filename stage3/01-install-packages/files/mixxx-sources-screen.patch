+            {QStringLiteral("RecordingFeature"), QT_TRANSLATE_NOOP("Sources", "Your recordings")},
+            {QStringLiteral("SetlogFeature"), QT_TRANSLATE_NOOP("Sources", "Past sessions")},
+            {QStringLiteral("AnalysisFeature"), QT_TRANSLATE_NOOP("Sources", "Analyse tracks")},
+            {QStringLiteral("RekordboxFeature"), QT_TRANSLATE_NOOP("Sources", "Rekordbox USB drives")},
