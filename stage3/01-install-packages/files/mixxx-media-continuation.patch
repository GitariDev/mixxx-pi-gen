+class MixpiMediaDialog final : public QDialog {
+  public:
+    using Receive = std::function<void(QJsonObject)>;
+    using Observe = std::function<void(Receive)>;
+    using Cancel = std::function<void()>;
+    using OpenSource = std::function<Cancel(const QJsonObject&, QObject*, std::function<void(QString)>)>;
+    using Controlled = std::function<void(bool, QString)>;
+
+    static void configure(QDialog* dialog) {
+        dialog->setObjectName("MixpiMediaDialog");
+        auto font = dialog->font();
+        font.setPixelSize(17);
+        dialog->setFont(font);
+        dialog->setStyleSheet("QDialog#MixpiMediaDialog { background:#111923; color:#e6edf4; }"
+                "#MixpiMediaDialog QLabel { color:#e6edf4; }"
+                "#MixpiMediaDialog QListWidget, #MixpiMediaDialog QComboBox { background:#182535; color:#e6edf4; border:1px solid #47586b; }"
+                "#MixpiMediaDialog QListWidget::item { min-height:56px; }"
+                "#MixpiMediaDialog QListWidget::item:selected { background:#234d70; }"
+                "#MixpiMediaDialog QComboBox QAbstractItemView { background:#182535; color:#e6edf4; selection-background-color:#234d70; }"
+                "#MixpiMediaDialog QPushButton { background:#253344; color:#edf3fa; border:1px solid #68798c; border-radius:2px; padding:6px 12px; }"
+                "#MixpiMediaDialog QPushButton:disabled { color:#7d8996; border-color:#394656; }"
+                "#MixpiMediaDialog QPushButton:focus { border:2px solid #b9dd64; }");
+    }
+
+    MixpiMediaDialog(QWidget* parent, Observe observe, OpenSource open,
+            Controlled controlled, std::shared_ptr<QSet<QString>> opened)
+            : QDialog(parent), m_observe(std::move(observe)), m_open(std::move(open)),
+              m_controlled(std::move(controlled)), m_opened(std::move(opened)) {
+        configure(this);
+        setAttribute(Qt::WA_DeleteOnClose);
+        setWindowTitle(tr("Load / Eject"));
+        setWindowModality(Qt::WindowModal);
+        setMinimumSize(650, 320);
+        resize(740, 380);
+        auto* layout = new QVBoxLayout(this);
+        m_list = new QListWidget(this);
+        m_list->setObjectName("mediaDrives");
+        m_list->setAccessibleName(tr("Connected USB drives"));
+        layout->addWidget(m_list);
+        m_volumes = new QComboBox(this);
+        m_volumes->setObjectName("mediaVolumes");
+        m_volumes->setAccessibleName(tr("Source volume"));
+        m_volumes->setMinimumHeight(44);
+        m_volumes->setPlaceholderText(tr("Choose a volume"));
+        layout->addWidget(m_volumes);
+        m_status = new QLabel(this);
+        m_status->setObjectName("mediaStatus");
+        m_status->setTextFormat(Qt::PlainText);
+        m_status->setWordWrap(true);
+        layout->addWidget(m_status);
+        auto* actions = new QHBoxLayout;
+        m_refresh = new QPushButton(tr("Refresh"), this);
+        m_load = new QPushButton(tr("Load"), this);
+        m_mount = new QPushButton(tr("Mount…"), this);
+        m_eject = new QPushButton(tr("Eject…"), this);
+        m_close = new QPushButton(tr("Close"), this);
+        m_load->setObjectName("mediaLoad");
+        m_mount->setObjectName("mediaMount");
+        m_eject->setObjectName("mediaEject");
+        m_refresh->setObjectName("mediaRefresh");
+        m_close->setObjectName("mediaClose");
+        for (auto* button : {m_refresh, m_load, m_mount, m_eject, m_close}) {
+            button->setAutoDefault(false);
+            button->setMinimumHeight(44);
+        }
+        for (auto* button : {m_refresh, m_load, m_mount, m_eject}) {
+            actions->addWidget(button);
+        }
+        actions->addStretch();
+        actions->addWidget(m_close);
+        layout->addLayout(actions);
+        connect(m_close, &QPushButton::clicked, this, &QDialog::reject);
+        connect(this, &QDialog::finished, this, [this] { cancelPending(); });
+        connect(m_refresh, &QPushButton::clicked, this, [this] { reload(); });
+        connect(m_list, &QListWidget::currentItemChanged, this, [this] { selectDrive(); });
+        connect(m_volumes, qOverload<int>(&QComboBox::currentIndexChanged), this, [this] {
+            cancelPending();
+            updateActions();
+        });
+        connect(m_load, &QPushButton::clicked, this, [this] { dispatch(false, false); });
+        connect(m_mount, &QPushButton::clicked, this, [this] { dispatch(true, false); });
+        connect(m_eject, &QPushButton::clicked, this, [this] { dispatch(false, true); });
+        reload();
+        m_close->setFocus(Qt::OtherFocusReason);
+    }
+
+    ~MixpiMediaDialog() override { cancelPending(); }
+
+    static QJsonObject findDrive(const QJsonObject& snapshot, const QString& token) {
+        if (token.isEmpty() || snapshot.contains("error") || snapshot.value("version").toInt() != 1 ||
+                !snapshot.value("drives").isArray()) {
+            return {};
+        }
+        QJsonObject found;
+        for (const auto& value : snapshot.value("drives").toArray()) {
+            const auto drive = value.toObject();
+            if (drive.value("token").toString() == token) {
+                if (!found.isEmpty() || !drive.value("volumes").isArray()) {
+                    return {};
+                }
+                found = drive;
+            }
+        }
+        return found;
+    }
+
+  private:
+    void cancelPending() {
+        ++m_generation;
+        m_loading = false;
+        if (m_cancel) {
+            auto cancel = std::move(m_cancel);
+            m_cancel = {};
+            cancel();
+        }
+    }
+
+    QString driveToken() const {
+        return m_list->currentItem() ? m_list->currentItem()->data(Qt::UserRole).toString() : QString();
+    }
+
+    void updateActions() {
+        const auto drive = findDrive(m_snapshot, driveToken());
+        const bool mounted = !drive.value("volumes").toArray().isEmpty();
+        m_volumes->setVisible(mounted && m_volumes->count() > 1);
+        m_load->setVisible(mounted);
+        m_load->setEnabled(mounted && m_volumes->currentIndex() >= 0 && !m_loading);
+        m_load->setText(m_opened->contains(m_volumes->currentData().toString()) ? tr("Open again") : tr("Load"));
+        m_mount->setVisible(!drive.isEmpty() && !mounted);
+        m_mount->setEnabled(!m_loading);
+        m_eject->setEnabled(!drive.isEmpty() && !m_loading);
+    }
+
+    void selectDrive() {
+        cancelPending();
+        m_volumes->clear();
+        const auto drive = findDrive(m_snapshot, driveToken());
+        for (const auto& value : drive.value("volumes").toArray()) {
+            const auto volume = value.toObject();
+            m_volumes->addItem(volume.value("label").toString() + " — " +
+                            volume.value("mount").toObject().value("path").toString(),
+                    volume.value("token").toString());
+        }
+        m_volumes->setCurrentIndex(m_volumes->count() == 1 ? 0 : -1);
+        m_status->setText(drive.isEmpty() ? tr("Select a drive.") :
+                tr("Load opens the native source. Eject requires the reviewed media service; keep the drive connected until confirmed."));
+        updateActions();
+    }
+
+    void reload() {
+        cancelPending();
+        m_snapshot = {};
+        m_list->clear();
+        m_volumes->clear();
+        updateActions();
+        m_refresh->setEnabled(false);
+        m_status->setText(tr("Checking connected USB drives…"));
+        const auto generation = m_generation;
+        const QPointer<MixpiMediaDialog> guard(this);
+        m_observe([guard, generation](QJsonObject snapshot) {
+            if (!guard || guard->m_generation != generation) {
+                return;
+            }
+            guard->m_refresh->setEnabled(true);
+            if (snapshot.contains("error") || snapshot.value("version").toInt() != 1 ||
+                    !snapshot.value("drives").isArray()) {
+                guard->m_status->setText(snapshot.value("error").toString(tr("Media inventory unavailable.")));
+                return;
+            }
+            guard->m_snapshot = snapshot;
+            for (const auto& value : snapshot.value("drives").toArray()) {
+                const auto drive = value.toObject();
+                const auto token = drive.value("token").toString();
+                if (findDrive(snapshot, token).isEmpty()) {
+                    continue;
+                }
+                QStringList names;
+                QStringList paths;
+                bool opened = false;
+                for (const auto& source : drive.value("volumes").toArray()) {
+                    const auto volume = source.toObject();
+                    names.append(volume.value("label").toString());
+                    paths.append(volume.value("mount").toObject().value("path").toString());
+                    opened = opened || guard->m_opened->contains(volume.value("token").toString());
+                }
+                const QString state = opened ? tr("Opened this session") :
+                        names.isEmpty() ? tr("Not mounted") : tr("Available");
+                const QString text = (names.isEmpty() ? tr("USB drive") : names.join(" / ")) +
+                        " · " + QString::number(drive.value("size").toDouble() / 1073741824.0, 'f', 1) +
+                        " GiB · " + state + "\n" +
+                        (paths.isEmpty() ? QString() : paths.join(" / ") + " · ") +
+                        drive.value("device").toString();
+                auto* item = new QListWidgetItem(text, guard->m_list);
+                item->setData(Qt::UserRole, token);
+            }
+            guard->m_list->setCurrentRow(-1);
+            guard->m_list->clearSelection();
+            guard->m_status->setText(guard->m_list->count() ? tr("Select a drive.") : tr("No eligible USB drives. Internal copies and system disks are excluded."));
+        });
+    }
+
+    void dispatch(bool mount, bool eject) {
+        const auto token = driveToken();
+        const auto volumeToken = m_volumes->currentData().toString();
+        if (token.isEmpty()) {
+            return;
+        }
+        cancelPending();
+        m_loading = true;
+        updateActions();
+        m_status->setText(tr("Rechecking the exact selected drive…"));
+        const auto generation = m_generation;
+        const QPointer<MixpiMediaDialog> guard(this);
+        m_observe([guard, generation, token, volumeToken, mount, eject](QJsonObject snapshot) {
+            if (!guard || guard->m_generation != generation || !guard->isVisible()) {
+                return;
+            }
+            const auto drive = findDrive(snapshot, token);
+            if (drive.isEmpty() || (mount && !drive.value("volumes").toArray().isEmpty())) {
+                guard->m_loading = false;
+                guard->m_status->setText(tr("Selected drive changed or observation failed. Refresh and choose again."));
+                guard->updateActions();
+                return;
+            }
+            if (mount || eject) {
+                const auto controlled = guard->m_controlled;
+                guard->reject();
+                controlled(mount, token);
+                return;
+            }
+            QJsonObject selected;
+            for (const auto& value : drive.value("volumes").toArray()) {
+                const auto volume = value.toObject();
+                if (volume.value("token").toString() == volumeToken && !volumeToken.isEmpty()) {
+                    if (!selected.isEmpty()) {
+                        guard->m_loading = false;
+                        guard->m_status->setText(tr("Ambiguous source identity. Refresh and choose again."));
+                        guard->updateActions();
+                        return;
+                    }
+                    selected = volume;
+                }
+            }
+            if (selected.isEmpty()) {
+                guard->m_loading = false;
+                guard->m_status->setText(tr("Selected volume changed. Refresh and choose again."));
+                guard->updateActions();
+                return;
+            }
+            guard->m_status->setText(tr("Opening the selected source… Close cancels pending discovery."));
+            guard->m_cancel = guard->m_open(selected, guard,
+                    [guard, generation, volumeToken](QString error) {
+                        if (!guard || guard->m_generation != generation || !guard->isVisible()) {
+                            return;
+                        }
+                        guard->m_cancel = {};
+                        guard->m_loading = false;
+                        if (!error.isEmpty()) {
+                            guard->m_status->setText(error);
+                            guard->updateActions();
+                            return;
+                        }
+                        guard->m_opened->insert(volumeToken);
+                        guard->accept();
+                    });
+        });
+    }
+
+    Observe m_observe;
+    OpenSource m_open;
+    Controlled m_controlled;
+    std::shared_ptr<QSet<QString>> m_opened;
+    Cancel m_cancel;
+    quint64 m_generation = 0;
+    bool m_loading = false;
+    QJsonObject m_snapshot;
+    QListWidget* m_list;
+    QComboBox* m_volumes;
+    QLabel* m_status;
+    QPushButton* m_refresh;
+    QPushButton* m_load;
+    QPushButton* m_mount;
+    QPushButton* m_eject;
+    QPushButton* m_close;
+};
diff --git a/src/library/rekordbox/pendingselection.h b/src/library/rekordbox/pendingselection.h
new file mode 100644
--- /dev/null
+++ b/src/library/rekordbox/pendingselection.h
@@ -0,0 +1,77 @@
+#pragma once
+
+#include <QElapsedTimer>
+#include <QObject>
+#include <QPointer>
+#include <QString>
+#include <QTimer>
+#include <functional>
+#include <optional>
+
+namespace mixxx::rekordbox {
+
+class PendingSelection final : public QObject {
+  public:
+    using Step = std::function<std::optional<QString>()>;
+    using Completion = std::function<void(QString)>;
+
+    PendingSelection(QObject* parent, QObject* receiver, Step step,
+            Completion completion, int timeoutMs = 15000)
+            : QObject(parent), m_receiver(receiver), m_step(std::move(step)),
+              m_completion(std::move(completion)), m_timeoutMs(timeoutMs) {
+        m_elapsed.start();
+        m_timer.setInterval(50);
+        connect(&m_timer, &QTimer::timeout, this, [this] { poll(); });
+        if (receiver) {
+            connect(receiver, &QObject::destroyed, this, [this] { cancel(); });
+        }
+        m_timer.start();
+        QTimer::singleShot(0, this, [this] { poll(); });
+    }
+
+    void cancel() {
+        m_timer.stop();
+        m_completion = {};
+        m_step = {};
+        deleteLater();
+    }
+
+  private:
+    void poll() {
+        if (!m_receiver || !m_step || !m_completion) {
+            cancel();
+            return;
+        }
+        const QPointer<PendingSelection> guard(this);
+        const auto step = m_step;
+        auto result = m_elapsed.elapsed() >= m_timeoutMs
+                ? std::optional<QString>(tr("Source discovery timed out. Refresh and choose again."))
+                : step();
+        if (!guard) {
+            return;
+        }
+        if (!m_receiver || !m_completion) {
+            cancel();
+            return;
+        }
+        if (!result) {
+            return;
+        }
+        auto completion = std::move(m_completion);
+        m_step = {};
+        m_timer.stop();
+        deleteLater();
+        if (m_receiver) {
+            completion(*result);
+        }
+    }
+
+    QPointer<QObject> m_receiver;
+    Step m_step;
+    Completion m_completion;
+    int m_timeoutMs;
+    QTimer m_timer;
+    QElapsedTimer m_elapsed;
+};
+
+}
