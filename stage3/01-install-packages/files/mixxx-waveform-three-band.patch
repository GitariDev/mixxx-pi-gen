diff --git a/src/util/mixpiwaveformcolours.h b/src/util/mixpiwaveformcolours.h
new file mode 100644
index 0000000..b31f8cd
--- /dev/null
+++ b/src/util/mixpiwaveformcolours.h
@@ -0,0 +1,84 @@
+#pragma once
+
+#include <QObject>
+#include <QString>
+#include <functional>
+#include <utility>
+
+#include "control/controlobject.h"
+#include "preferences/usersettings.h"
+
+/// MixPi Settings › Advanced, Waveform colours (three-band R&D; owner,
+/// 2026-11-23: direction A Overlay, as a setting, in Advanced).
+///
+/// - [MixPi],waveform_colours is 0 for RGB (Mixxx's all-shader RGB waveform,
+///   type 17: one mixed colour per column) or 1 for 3-BAND (the all-shader
+///   Filtered waveform, type 19: bass, mids and highs drawn over each other in
+///   the skin's SignalLowColor, SignalMidColor and SignalHighColor). Any other
+///   value is refused.
+/// - The setting is Mixxx's own [Waveform],WaveformType. A change asks
+///   applyType to switch every scrolling waveform at once (Mixxx passes
+///   WaveformWidgetFactory::setWidgetTypeFromHandle, which re-creates the
+///   waveforms with their tracks, zoom and play marker); only when that
+///   succeeds is the type written and the new value confirmed. The save on
+///   change (R-13) writes mixxx.cfg within a second. The overview strips have
+///   their own type and do not change.
+/// - At start the control shows the saved type: 19 is 3-BAND, anything else
+///   RGB. A type picked later in Mixxx's own Preferences is not followed.
+class MixpiWaveformColours : public QObject {
+  public:
+    static constexpr int kRgb = 0;
+    static constexpr int kThreeBand = 1;
+    // WaveformWidgetType::AllShaderRGBWaveform and AllShaderFilteredWaveform.
+    static constexpr int kRgbType = 17;
+    static constexpr int kThreeBandType = 19;
+
+    explicit MixpiWaveformColours(UserSettingsPointer pSettings,
+            std::function<bool(int)> applyType = {},
+            QObject* pParent = nullptr)
+            : QObject(pParent),
+              m_pSettings(std::move(pSettings)),
+              m_applyType(std::move(applyType)),
+              m_pColours(new ControlObject(ConfigKey(
+                      QStringLiteral("[MixPi]"), QStringLiteral("waveform_colours")))) {
+        m_pColours->setParent(this);
+        m_pColours->setAndConfirm(valueForType(savedType()));
+        m_pColours->connectValueChangeRequest(
+                this, [this](double value) { request(value); }, Qt::DirectConnection);
+    }
+
+    /// The saved [Waveform],WaveformType, or -1 when there is none.
+    int savedType() const {
+        bool ok = false;
+        const int type = m_pSettings->getValueString(kTypeKey).toInt(&ok);
+        return ok ? type : -1;
+    }
+
+    static int valueForType(int type) {
+        return type == kThreeBandType ? kThreeBand : kRgb;
+    }
+
+    static int typeForValue(int value) {
+        return value == kThreeBand ? kThreeBandType : kRgbType;
+    }
+
+  private:
+    void request(double value) {
+        if (value != kRgb && value != kThreeBand) {
+            return;
+        }
+        const int type = typeForValue(static_cast<int>(value));
+        if (!m_applyType || !m_applyType(type)) {
+            return;
+        }
+        m_pSettings->setValue(kTypeKey, type);
+        m_pColours->setAndConfirm(value);
+    }
+
+    static inline const ConfigKey kTypeKey =
+            ConfigKey(QStringLiteral("[Waveform]"), QStringLiteral("WaveformType"));
+
+    UserSettingsPointer m_pSettings;
+    std::function<bool(int)> m_applyType;
+    ControlObject* m_pColours;
+};
diff --git a/src/waveform/mixpiwaveformgain.h b/src/waveform/mixpiwaveformgain.h
index 9228e62..d4be164 100644
--- a/src/waveform/mixpiwaveformgain.h
+++ b/src/waveform/mixpiwaveformgain.h
@@ -46,4 +46,15 @@ inline double waveformHeightGain(bool mainWaveform, double pregain, double total
     return mainWaveform ? pregain * kMainWaveformGain : totalGain;
 }
 
+/// MixPi three-band waveforms (owner, 2026-11-23: A Overlay, the Filtered
+/// renderer): Mixxx doubles the height of the renderers that ask for
+/// WaveformWidgetRenderer::getGain(true) (Filtered and the textured ones).
+/// A main waveform skips that doubling, so the tallest band stops at
+/// kMainWaveformGain of the edge as the RGB outline does; doubled, a band
+/// would sit on the edge in about a quarter of a typical track's columns.
+/// Every other waveform keeps Mixxx's doubling.
+inline double heightCompensation(bool mainWaveform, bool applyCompensation) {
+    return applyCompensation && !mainWaveform ? 2.0 : 1.0;
+}
+
 } // namespace mixpi
