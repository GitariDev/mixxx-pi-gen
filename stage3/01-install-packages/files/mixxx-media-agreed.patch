+// The filter segments of the Media page (s13). EJECTING and SAFE TO REMOVE
+// drives show under every filter, so a drive never leaves the view in the
+// middle of its eject.
+enum class Filter { All = 0, Ready = 1, InUse = 2 };
+
+inline bool matches(Filter filter, MixpiMediaState state) {
+    switch (filter) {
+    case Filter::All:
+        return true;
+    case Filter::Ready:
+        return state != MixpiMediaState::InUse;
+    case Filter::InUse:
+        return state != MixpiMediaState::Ready;
+    }
+    return true;
+}
+
+// The footer line (s13): "N tracks playing from Pi memory", N tracks in bold.
