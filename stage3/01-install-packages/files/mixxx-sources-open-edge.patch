+void WLibrarySidebar::followShownSource() {
+    // The drive's row is current (featureSelect), but the menu still held
+    // the source picked before (This Pi): ☰ reopened inside it, and BACK
+    // made the drive's parent row current, so the edge fell back to This Pi.
+    // The source shown in Tracks is now the menu's source and place too; the
+    // menu keeps its level (inside or at the top). The saved start (★) is
+    // not touched.
+    if (!m_sourceScreen || !groupedTiles || !m_touchNavigation || m_sourcesEditing) {
+        return;
+    }
+    const QModelIndex shown = currentIndex();
+    const QString id = tileOf(shown);
+    if (id.isEmpty()) {
+        return;
+    }
+    if (id != m_selectedTile || !withinSelectedTile()) {
+        openGroupedTile(id, false);
+    }
+    // A list inside the source: its level.
+    m_touchNavigation->reveal(shown);
+    updateSourceChrome();
+}
