+// Council round 1, blocker 3: every scrolling list on the Media page has a
+// 24 px scroll bar (pioneered-menus.qss) and scrolls by a finger drag.
+// A press goes to the widget under the finger as usual. Once the finger has
+// moved the platform drag distance (QApplication::startDragDistance(), as the
+// Sources list uses for C-1), the press becomes a drag: the button is let go,
+// the list follows the finger, and neither the moves nor the release reach
+// the button, so a drag never taps it (C-1), even if it ends on the button.
+class MixpiDragScroll : public QObject {
+  public:
+    explicit MixpiDragScroll(QScrollArea* area)
+            : QObject(area), m_area(area) {
+        QCoreApplication::instance()->installEventFilter(this);
+    }
+
+  protected:
+    bool eventFilter(QObject* watched, QEvent* event) override {
+        const auto type = event->type();
+        // A quick second touch arrives as a double click: it starts a drag too.
+        const bool press = type == QEvent::MouseButtonPress || type == QEvent::MouseButtonDblClick;
+        if (!press && type != QEvent::MouseMove && type != QEvent::MouseButtonRelease) {
+            return false;
+        }
+        auto* widget = qobject_cast<QWidget*>(watched);
+        auto* viewport = m_area->viewport();
+        if (!widget || !(widget == viewport || viewport->isAncestorOf(widget))) {
+            return false;
+        }
+        const auto* mouse = static_cast<QMouseEvent*>(event);
+        const QPoint global = mouse->globalPosition().toPoint();
+        auto* bar = m_area->verticalScrollBar();
+        if (press) {
+            if (mouse->button() == Qt::LeftButton && !m_pressed) {
+                m_pressed = true;
+                m_dragging = false;
+                m_start = global;
+                m_value = bar->value();
+                m_target = widget;
+            }
+            return false;
+        }
+        if (type == QEvent::MouseMove) {
+            if (!m_pressed || !(mouse->buttons() & Qt::LeftButton)) {
+                return false;
+            }
+            const int moved = global.y() - m_start.y();
+            if (!m_dragging && qAbs(moved) < QApplication::startDragDistance()) {
+                return false;
+            }
+            if (!m_dragging) {
+                m_dragging = true;
+                if (auto* button = qobject_cast<QAbstractButton*>(m_target.data())) {
+                    button->setDown(false);
+                }
+            }
+            bar->setValue(m_value - moved);
+            return true;
+        }
+        if (mouse->button() != Qt::LeftButton) {
+            return false;
+        }
+        const bool dragged = m_dragging;
+        m_pressed = false;
+        m_dragging = false;
+        if (dragged) {
+            if (auto* button = qobject_cast<QAbstractButton*>(m_target.data())) {
+                button->setDown(false);
+            }
+            return true;
+        }
+        return false;
+    }
+
+  private:
+    QScrollArea* m_area;
+    QPointer<QWidget> m_target;
+    QPoint m_start;
+    int m_value = 0;
+    bool m_pressed = false;
+    bool m_dragging = false;
+};
+
+inline void touchScroll(QScrollArea* area) {
+    area->setVerticalScrollBarPolicy(Qt::ScrollBarAsNeeded);
+    area->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+    area->setFocusPolicy(Qt::NoFocus);
+    area->verticalScrollBar()->setFocusPolicy(Qt::NoFocus);
+    auto* drag = new MixpiDragScroll(area);
+    drag->setObjectName(QStringLiteral("MixpiDragScroll"));
+}
+
+// What the drive list shows: a refresh that changes none of it changes no widget.
+inline QString signature(const QList<MixpiMediaDrive>& drives) {
+    QStringList parts;
+    for (const auto& drive : drives) {
+        parts.append(drive.identity + '|' + drive.name + '|' + QString::number(drive.size) + '|' +
+                QString::number(drive.rekordbox) + QString::number(drive.opened) + QString::number(drive.busy) +
+                '|' + QString::number(static_cast<int>(drive.state)));
+        for (const auto& volume : drive.volumes) {
+            parts.append(QStringLiteral("v|") + volume.token + '|' + volume.label + '|' + volume.path + '|' +
+                    QString::number(volume.opened));
+        }
+        for (const auto& user : drive.users) {
+            parts.append(QStringLiteral("u|") + user.group + '|' + user.title + '|' + QString::number(user.playing) +
+                    QString::number(user.onCopy));
+        }
+    }
+    return parts.join(QLatin1Char('\n'));
+}
