+int countScanFolders(const QStringList& roots) {
+    // The same entries the recursive scan visits: no hidden folders.
+    constexpr int kMaximum = 1000000;
+    int folders = 0;
+    for (const QString& root : roots) {
+        if (!QFileInfo(root).isDir()) {
+            continue;
+        }
+        ++folders;
+        QDirIterator it(root,
+                QDir::Dirs | QDir::NoDotAndDotDot | QDir::System,
+                QDirIterator::Subdirectories);
+        while (it.hasNext() && folders < kMaximum) {
+            it.next();
+            ++folders;
+        }
+    }
+    return folders;
+}
+
+QString scanItemName(const QString& path) {
+    const QStringList parts = QDir::fromNativeSeparators(path).split(
+            QLatin1Char('/'), Qt::SkipEmptyParts);
+    return parts.isEmpty() ? path : parts.last();
+}
