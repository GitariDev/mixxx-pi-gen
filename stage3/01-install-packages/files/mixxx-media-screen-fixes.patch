+// The widget that carries the skin: the legacy skin parser sets the skin's
+// <Style> (style.qss) on the skin's root widget, and MixxxMainWindow makes
+// that root its central widget. Native MixPi views are its children so the
+// skin stylesheet styles them (Acceptance B, R-4).
+inline QWidget* mixpiSkinRoot(QWidget* anyWidget) {
+    QWidget* window = anyWidget ? anyWidget->window() : nullptr;
+    if (auto* main = qobject_cast<QMainWindow*>(window)) {
+        if (main->centralWidget()) {
+            return main->centralWidget();
+        }
+    }
+    return window;
+}
