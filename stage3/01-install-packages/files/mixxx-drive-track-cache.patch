index 4573e07..1ef6c01 100644
--- a/src/library/rekordbox/rekordboxfeature.cpp
+++ b/src/library/rekordbox/rekordboxfeature.cpp
@@ -1447,6 +1447,27 @@ RekordboxFeature::RekordboxFeature(
             &QFutureWatcher<QList<TreeItem*>>::finished,
             this,
             &RekordboxFeature::onRekordboxDevicesFound);
+    // The track cache mirrors the tables. A rekordbox row draws its columns
+    // (title, artist, location, ...) and LOAD reads its file from
+    // m_trackSource by the row's id, and with no drive left the tables are
+    // dropped and made again, so ids restart at 1: a cache kept from an
+    // ejected drive would show its tracks, and load its files, in another
+    // drive's lists. So the cache is built again whenever a drive's export
+    // has been read (connected before onTracksFound, which shows the list)
+    // and whenever drives leave the menu (after their tables are cleared).
+    connect(&m_tracksFutureWatcher,
+            &QFutureWatcher<QString>::finished,
+            this,
+            &RekordboxFeature::resetTrackCache);
+    connect(m_pSidebarModel,
+            &QAbstractItemModel::rowsRemoved,
+            this,
+            [this](const QModelIndex& parent) {
+                if (!parent.isValid()) {
+                    resetTrackCache();
+                    dropRemovedList();
+                }
+            });
     connect(&m_tracksFutureWatcher,
             &QFutureWatcher<QString>::finished,
             this,
@@ -1892,6 +1913,31 @@ void RekordboxFeature::releaseRemovedDrives(const QModelIndex& parent, int first
     }
 }
 
+void RekordboxFeature::resetTrackCache() {
+    // Reads the tables as they are now: the drives still in the menu.
+    m_trackSource->buildIndex();
+}
+
+void RekordboxFeature::dropRemovedList() {
+    // A list of a drive that left holds the ids of rows that are gone, and
+    // those ids may come back for the next drive. Select it again from the
+    // tables: it is empty now, so it never draws another drive's rows.
+    const QString shown = m_pRekordboxPlaylistModel->playlist();
+    if (shown.isEmpty()) {
+        return;
+    }
+    QSqlQuery query(m_pTrackCollection->database());
+    query.prepare("SELECT 1 FROM " + kRekordboxPlaylistsTable + " WHERE name=:name");
+    query.bindValue(":name", shown);
+    if (!query.exec()) {
+        LOG_FAILED_QUERY(query);
+        return;
+    }
+    if (!query.next()) {
+        m_pRekordboxPlaylistModel->select();
+    }
+}
