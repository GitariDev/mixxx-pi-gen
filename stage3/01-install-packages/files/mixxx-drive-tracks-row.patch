+// Agreed UI 2d (m-sources-sub.png): a drive's first row is "Tracks", with the
+// music-note icon of This Pi's Tracks row and no ›. parseDeviceDB already
+// fills the device's own playlist, named by the device path, with every track
+// row of export.pdb, whether or not a playlist holds it; the row opens that
+// playlist as a playlist row opens its own (activateChild), so the table,
+// its columns, its sort and LOAD are a rekordbox list's. Nothing is written
+// to the drive.
+bool isDriveTracksRow(const TreeItem& device, const TreeItem& row) {
+    const QVariantList data = row.getData().toList();
+    return data.value(1).toString() == IS_NOT_RECORDBOX_DEVICE &&
+            data.value(0).toString() == device.getData().toList().value(0).toString();
+}
+
+std::unique_ptr<TreeItem> driveTracksRow(const TreeItem& device) {
+    auto row = std::make_unique<TreeItem>(QObject::tr("Tracks"),
+            QVariant(QList<QString>{device.getData().toList().value(0).toString(),
+                    IS_NOT_RECORDBOX_DEVICE}));
+    row->setIcon(QIcon(QStringLiteral(":/images/library/ic_library_tracks.svg")));
+    return row;
+}
+
