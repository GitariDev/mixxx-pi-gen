diff --git a/src/library/media/mediause.h b/src/library/media/mediause.h
new file mode 100644
--- /dev/null
+++ b/src/library/media/mediause.h
@@ -0,0 +1,58 @@
+#pragma once
+
+#include "library/media/mediauseregistry.h"
+#include "library/rekordbox/sourceidentity.h"
+
+namespace mixxx::media {
+
+inline Binding observePath(const std::string& path) {
+#ifdef __linux__
+    if (path.empty() || path.front() != '/' || std::filesystem::path(path).lexically_normal() != path) {
+        return {};
+    }
+    std::ifstream mounts("/proc/self/mountinfo");
+    const auto mount = rekordbox::containingMount(path, mounts);
+    auto descriptor = std::make_shared<rekordbox::SourceDescriptor>(
+            ::open(path.c_str(), O_PATH | O_CLOEXEC));
+    struct stat status {};
+    if (::fstat(descriptor->value, &status) != 0 ||
+            (!S_ISDIR(status.st_mode) && !S_ISREG(status.st_mode)) ||
+            !rekordbox::descriptorOnMount(descriptor->value, mount, S_ISDIR(status.st_mode))) {
+        return {};
+    }
+    const auto generation = rekordbox::physicalGeneration(mount.device);
+    std::error_code error;
+    if (generation.sysfs.empty() || generation.sysfs.find("/virtual/") != std::string::npos ||
+            !std::filesystem::is_empty(generation.sysfs + "/slaves", error) || error ||
+            !std::filesystem::is_empty(generation.sysfs + "/holders", error) || error) {
+        return {};
+    }
+    const auto key = rekordbox::generationRevision(generation);
+    const auto source = rekordbox::sourceRevision(mount, generation);
+    if (key.empty() || source.empty() ||
+            key != rekordbox::generationRevision(rekordbox::physicalGeneration(mount.device))) {
+        return {};
+    }
+    return {key, source, std::move(descriptor)};
+#else
+    (void)path;
+    return {};
+#endif
+}
+
+inline Lease acquirePath(const std::string& path, Producer producer, Lease inherited = {}) {
+    if (!inherited) {
+        inherited = PathUseScope::inherited(path);
+    }
+    auto binding = observePath(path);
+    if (inherited) {
+        return inherited->matches(binding) ? inherited : Lease{};
+    }
+    auto lease = registry().acquire(binding, producer);
+    if (lease && !lease->matches(observePath(path))) {
+        return {};
+    }
+    return lease;
+}
+
+}
diff --git a/src/library/media/mediauseregistry.h b/src/library/media/mediauseregistry.h
new file mode 100644
--- /dev/null
+++ b/src/library/media/mediauseregistry.h
@@ -0,0 +1,228 @@
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <utility>
+
+namespace mixxx::media {
+
+enum class Producer { Load, Decoder, Analysis, Import, Discovery, Browser, Metadata, Recording, Copy, Count };
+using Counts = std::array<std::size_t, static_cast<std::size_t>(Producer::Count)>;
+
+struct Binding {
+    std::string generation;
+    std::string source;
+    std::shared_ptr<void> descriptor;
+};
+
+class MediaUseRegistry {
+    struct Entry {
+        Counts users{};
+        bool draining = false;
+        std::uint64_t epoch = 0;
+        bool retired = false;
+    };
+    struct State {
+        std::mutex mutex;
+        std::map<std::string, Entry> entries;
+        Counts unknown{};
+    };
+
+  public:
+    class Ownership {
+      public:
+        Ownership(const Ownership&) = delete;
+        Ownership& operator=(const Ownership&) = delete;
+        ~Ownership() {
+            if (!m_counted) {
+                return;
+            }
+            m_binding.descriptor.reset();
+            std::lock_guard<std::mutex> lock(m_state->mutex);
+            auto& counts = m_binding.generation.empty() ? m_state->unknown :
+                    m_state->entries.at(m_binding.generation).users;
+            --counts[static_cast<std::size_t>(m_producer)];
+        }
+        bool matches(const Binding& binding) const {
+            return m_binding.generation == binding.generation && m_binding.source == binding.source;
+        }
+      private:
+        friend class MediaUseRegistry;
+        Ownership(std::shared_ptr<State> state, Binding binding, Producer producer)
+                : m_state(std::move(state)), m_binding(std::move(binding)), m_producer(producer) {}
+        std::shared_ptr<State> m_state;
+        Binding m_binding;
+        Producer m_producer;
+        bool m_counted = false;
+    };
+    using Lease = std::shared_ptr<const Ownership>;
+
+    struct Snapshot {
+        bool draining = false;
+        Counts users{};
+        Counts unknown{};
+        bool locallyIdle() const {
+            if (!draining) {
+                return false;
+            }
+            for (std::size_t index = 0; index < users.size(); ++index) {
+                if (users[index] || unknown[index]) {
+                    return false;
+                }
+            }
+            return true;
+        }
+    };
+
+    class Drain {
+      public:
+        Drain() = default;
+        Drain(const Drain&) = delete;
+        Drain& operator=(const Drain&) = delete;
+        Drain(Drain&& other) noexcept
+                : m_state(std::move(other.m_state)), m_generation(std::move(other.m_generation)),
+                  m_epoch(other.m_epoch) {}
+        ~Drain() { cancel(); }
+        explicit operator bool() const { return bool(m_state); }
+        Snapshot snapshot() const {
+            if (!m_state) {
+                return {};
+            }
+            std::lock_guard<std::mutex> lock(m_state->mutex);
+            const auto& entry = m_state->entries.at(m_generation);
+            return {entry.draining && entry.epoch == m_epoch, entry.users, m_state->unknown};
+        }
+        void cancel() {
+            if (!m_state) {
+                return;
+            }
+            auto state = std::move(m_state);
+            std::lock_guard<std::mutex> lock(state->mutex);
+            auto& entry = state->entries.at(m_generation);
+            if (entry.epoch == m_epoch) {
+                entry.draining = false;
+            }
+        }
+        bool retire() {
+            if (!m_state) return false;
+            auto state = m_state;
+            std::lock_guard<std::mutex> lock(state->mutex);
+            auto& entry = state->entries.at(m_generation);
+            if (!entry.draining || entry.epoch != m_epoch) return false;
+            for (std::size_t index = 0; index < entry.users.size(); ++index) {
+                if (entry.users[index] || state->unknown[index]) return false;
+            }
+            entry.retired = true;
+            entry.draining = false;
+            m_state.reset();
+            return true;
+        }
+      private:
+        friend class MediaUseRegistry;
+        Drain(std::shared_ptr<State> state, std::string generation, std::uint64_t epoch)
+                : m_state(std::move(state)), m_generation(std::move(generation)), m_epoch(epoch) {}
+        std::shared_ptr<State> m_state;
+        std::string m_generation;
+        std::uint64_t m_epoch = 0;
+    };
+
+    Lease acquire(Binding binding, Producer producer) {
+        if (producer == Producer::Count || binding.generation.empty() != binding.source.empty()) {
+            return {};
+        }
+        auto result = std::shared_ptr<Ownership>(new Ownership(m_state, std::move(binding), producer));
+        const auto& generation = result->m_binding.generation;
+        std::lock_guard<std::mutex> lock(m_state->mutex);
+        if (generation.empty()) {
+            for (const auto& item : m_state->entries) {
+                if (item.second.draining) {
+                    return {};
+                }
+            }
+        } else if (m_state->entries[generation].draining || m_state->entries[generation].retired) {
+            return {};
+        }
+        auto& counts = generation.empty() ? m_state->unknown : m_state->entries[generation].users;
+        ++counts[static_cast<std::size_t>(producer)];
+        result->m_counted = true;
+        return result;
+    }
+
+    Drain beginDrain(const std::string& generation) {
+        if (generation.empty()) {
+            return {};
+        }
+        std::lock_guard<std::mutex> lock(m_state->mutex);
+        auto& entry = m_state->entries[generation];
+        if (entry.draining || entry.retired) {
+            return {};
+        }
+        entry.draining = true;
+        return Drain(m_state, generation, ++entry.epoch);
+    }
+
+  private:
+    std::shared_ptr<State> m_state = std::make_shared<State>();
+};
+
+using Lease = MediaUseRegistry::Lease;
+
+class PathUseScope final {
+  public:
+    PathUseScope(std::string path, Lease lease)
+            : m_path(std::move(path)), m_lease(std::move(lease)), m_previous(s_current) {
+        s_current = this;
+    }
+    ~PathUseScope() { s_current = m_previous; }
+    PathUseScope(const PathUseScope&) = delete;
+    PathUseScope& operator=(const PathUseScope&) = delete;
+    static Lease inherited(const std::string& path) {
+        for (auto* scope = s_current; scope; scope = scope->m_previous) {
+            if (scope->m_path == path) {
+                return scope->m_lease;
+            }
+        }
+        return {};
+    }
+  private:
+    const std::string m_path;
+    const Lease m_lease;
+    PathUseScope* const m_previous;
+    static inline thread_local PathUseScope* s_current = nullptr;
+};
+
+inline MediaUseRegistry& registry() {
+    static MediaUseRegistry instance;
+    return instance;
+}
+
+inline Lease acquireUnknown(Producer producer) {
+    return registry().acquire({}, producer);
+}
+
+class UnknownUseScope final {
+  public:
+    explicit UnknownUseScope(Producer producer)
+            : UnknownUseScope(s_current && s_current->m_lease
+                              ? s_current->m_lease : acquireUnknown(producer)) {}
+    explicit UnknownUseScope(Lease lease)
+            : m_lease(std::move(lease)), m_previous(s_current) {
+        s_current = this;
+    }
+    ~UnknownUseScope() { s_current = m_previous; }
+    UnknownUseScope(const UnknownUseScope&) = delete;
+    UnknownUseScope& operator=(const UnknownUseScope&) = delete;
+    explicit operator bool() const { return bool(m_lease); }
+    Lease lease() const { return m_lease; }
+
+  private:
+    const Lease m_lease;
+    UnknownUseScope* const m_previous;
+    static inline thread_local UnknownUseScope* s_current = nullptr;
+};
+
+}
