diff --git a/src/library/mixpimediaremount.h b/src/library/mixpimediaremount.h
new file mode 100644
index 0000000..5b06f1a
--- /dev/null
+++ b/src/library/mixpimediaremount.h
@@ -0,0 +1,182 @@
+#pragma once
+
+#include <QDebug>
+#include <QList>
+#include <QObject>
+#include <QPointer>
+#include <QProcess>
+#include <QString>
+#include <QTimer>
+#include <algorithm>
+#include <functional>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "library/mixpimediapage.h"
+
+// Spec 2h (owner: "You should be able to press open to mount again so the
+// safe to remove stays, but if you press open it goes back to a ready
+// state"). After a clean eject the drive's read generation is retired
+// (MediaUseRegistry), keyed by the physical drive (boot, namespace, sysfs
+// node, dev, diskseq), not by its mount: mounting it again by any other
+// means keeps it unreadable until it is pulled out. OPEN on its SAFE TO
+// REMOVE row mounts each volume the eject unmounted through udisks2, as the
+// system's automounter does (never a write to the drive), and only then
+// reopens the generations that eject retired, as a new round. A drive pulled
+// out in between is not mounted (pluggedIn is false); any failure leaves the
+// generations retired.
+class MixpiRemount : public QObject {
+  public:
+    using Volume = MixpiEjectEngine::Volume;
+    using Done = std::function<void(bool)>;
+    struct Hooks {
+        std::function<bool(const QString& device)> mounted;          // major:minor in the mount table
+        std::function<void(const QString& source, Done done)> mount; // udisks2, for one block device
+        std::function<bool(const std::string& generation)> reopen;   // MediaUseRegistry::reopen
+    };
+
+    explicit MixpiRemount(Hooks hooks, QObject* parent = nullptr)
+            : QObject(parent), m_hooks(std::move(hooks)) {}
+
+    // The eject's drain: the generations it will retire.
+    void drained(std::vector<std::string> generations) {
+        m_drained = std::move(generations);
+    }
+
+    // The eject retired them (ok) after unmounting these volumes: the drive
+    // can be mounted again from its SAFE TO REMOVE row. Build B keeps one
+    // safe drive at a time, so one record.
+    void retired(const QString& identity, const QList<Volume>& volumes, bool ok) {
+        if (!ok || identity.isEmpty() || volumes.isEmpty() || m_drained.empty()) {
+            m_drained.clear();
+            return;
+        }
+        m_identity = identity;
+        m_volumes = volumes;
+        m_generations = std::move(m_drained);
+        m_drained.clear();
+    }
+
+    bool remembers(const QString& identity) const {
+        return !identity.isEmpty() && identity == m_identity;
+    }
+
+    bool running() const {
+        return m_running;
+    }
+
+    // OPEN on the SAFE TO REMOVE row. done(true) once every volume is
+    // mounted and its generation reads again; done(false) otherwise.
+    bool start(const QString& identity, bool pluggedIn, Done done) {
+        if (m_running) {
+            return false;
+        }
+        if (!pluggedIn || !remembers(identity) || !m_hooks.mounted || !m_hooks.mount || !m_hooks.reopen) {
+            if (done) {
+                done(false);
+            }
+            return true;
+        }
+        m_running = true;
+        m_done = std::move(done);
+        mountNext(0);
+        return true;
+    }
+
+  private:
+    void mountNext(int index) {
+        if (index >= m_volumes.size()) {
+            finish();
+            return;
+        }
+        const auto& volume = m_volumes[index];
+        if (m_hooks.mounted(volume.device)) {
+            mountNext(index + 1); // mounted already (by hand): only the generation reopens
+            return;
+        }
+        const QPointer<MixpiRemount> guard(this);
+        m_hooks.mount(volume.source, [guard, index](bool ok) {
+            if (!guard || !guard->m_running) {
+                return;
+            }
+            if (!ok) {
+                guard->end(false);
+                return;
+            }
+            guard->mountNext(index + 1);
+        });
+    }
+
+    void finish() {
+        for (const auto& volume : std::as_const(m_volumes)) {
+            if (!m_hooks.mounted(volume.device)) {
+                end(false);
+                return;
+            }
+        }
+        std::vector<std::string> reopened;
+        bool ok = true;
+        for (const auto& generation : m_generations) {
+            if (std::find(reopened.begin(), reopened.end(), generation) != reopened.end()) {
+                continue;
+            }
+            reopened.push_back(generation);
+            ok = m_hooks.reopen(generation) && ok;
+        }
+        if (ok) {
+            m_identity.clear();
+            m_volumes.clear();
+            m_generations.clear();
+        }
+        end(ok);
+    }
+
+    void end(bool ok) {
+        m_running = false;
+        auto done = std::move(m_done);
+        m_done = {};
+        if (done) {
+            done(ok);
+        }
+    }
+
+    Hooks m_hooks;
+    std::vector<std::string> m_drained;
+    QString m_identity;
+    QList<Volume> m_volumes;
+    std::vector<std::string> m_generations;
+    bool m_running = false;
+    Done m_done;
+};
+
+// The system's mount, as udiskie (the automounter) asks udisks2 for it: the
+// block device's default options, no prompt. 10 s at most, as the unmount.
+inline void mixpiUdisksMount(QObject* owner, const QString& source, MixpiRemount::Done done) {
+    auto* process = new QProcess(owner);
+    auto* deadline = new QTimer(process);
+    deadline->setSingleShot(true);
+    auto answered = std::make_shared<bool>(false);
+    auto finish = [process, deadline, answered, done](bool ok) {
+        if (*answered) {
+            return;
+        }
+        *answered = true;
+        deadline->stop();
+        process->deleteLater();
+        done(ok);
+    };
+    QObject::connect(deadline, &QTimer::timeout, process, [process, finish] {
+        process->kill();
+        finish(false);
+    });
+    QObject::connect(process, &QProcess::errorOccurred, process, [finish](QProcess::ProcessError) { finish(false); });
+    QObject::connect(process, qOverload<int, QProcess::ExitStatus>(&QProcess::finished), process,
+            [process, finish](int code, QProcess::ExitStatus status) {
+                qInfo() << "MixPi open: mount" << code << process->readAllStandardError().trimmed();
+                finish(status == QProcess::NormalExit && code == 0);
+            });
+    deadline->start(10000);
+    process->start(QStringLiteral("/usr/bin/udisksctl"),
+            {QStringLiteral("mount"), QStringLiteral("-b"), source, QStringLiteral("--no-user-interaction")});
+}
