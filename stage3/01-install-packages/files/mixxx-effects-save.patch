+class EffectsManager;
+
+namespace mixxx {
+
+/// The effects.xml bytes for the current state of the effects: what the
+/// quit-time save writes (EffectsManager::saveEffectsXml uses it too).
+/// Empty if it can't be built. GUI thread only.
+QByteArray effectsXml(const EffectsManager& manager);
+
+/// Where Mixxx keeps effects.xml: in the settings folder.
+inline QString effectsXmlPath(const QString& settingsPath) {
+    return QDir(settingsPath).absoluteFilePath(QStringLiteral("effects.xml"));
+}
+
+/// MixPi: saves the effects state (effects.xml) within a second of a change,
+/// so the loaded effects survive a killed Mixxx or a power cut. Stock Mixxx
+/// writes the file only at a clean quit.
+///
+/// Runs on the GUI thread, where the effect chains live. Every pollMs it
+/// takes a snapshot (the bytes the quit-time save would write) and compares
+/// it with the bytes last written. A changed snapshot is written once it has
+/// stayed the same for quietMs, or at the latest maxDelayMs after the first
+/// unsaved change, so a burst of changes gives one write. The write runs on a
+/// worker thread (temporary file, sync, rename), never on the GUI or the audio
+/// thread. Nothing is written while nothing changes.
+class EffectsAutosave final {
+  public:
+    struct Timing {
+        // A single change is seen within pollMs and written once it has been
+        // the same for quietMs: on disk about 0.3 to 0.6 s after the change.
+        int pollMs = 200;
+        int quietMs = 300;
+        int maxDelayMs = 3000;
+        int retryMs = 5000;
+    };
+    using Snapshot = std::function<QByteArray()>;
+
+    EffectsAutosave(QString filePath, Snapshot snapshot, Timing timing)
+            : m_filePath(std::move(filePath)),
+              m_snapshot(std::move(snapshot)),
+              m_timing(timing),
+              m_pContext(std::make_unique<QObject>()),
+              m_pPollTimer(std::make_unique<QTimer>()),
+              m_pWorker(std::make_unique<QThreadPool>()) {
+        m_pWorker->setMaxThreadCount(1);
+        m_pPollTimer->setTimerType(Qt::PreciseTimer);
+        m_pPollTimer->setInterval(m_timing.pollMs);
+        QObject::connect(m_pPollTimer.get(), &QTimer::timeout, m_pContext.get(), [this] {
+            poll();
+        });
+    }
+    EffectsAutosave(QString filePath, Snapshot snapshot)
+            : EffectsAutosave(std::move(filePath), std::move(snapshot), Timing()) {
+    }
+    ~EffectsAutosave() {
+        stop();
+    }
+    EffectsAutosave(const EffectsAutosave&) = delete;
+    EffectsAutosave& operator=(const EffectsAutosave&) = delete;
+
+    /// Starts polling. What is on disk now counts as saved.
+    void start() {
+        QFile file(m_filePath);
+        m_lastSaved = file.open(QIODevice::ReadOnly) ? file.readAll() : QByteArray();
+        m_lastSeen = m_lastSaved;
+        m_pPollTimer->start();
+    }
+
+    /// Stops polling and waits for a write in progress. Call it before the
+    /// quit-time save, so that save is the last write.
+    void stop() {
+        m_pPollTimer->stop();
+        m_pWorker->waitForDone();
+    }
+
+  private:
+    void poll() {
+        if (m_writing) {
+            return;
+        }
+        const QByteArray snapshot = m_snapshot();
+        if (snapshot.isEmpty()) {
+            return;
+        }
+        if (snapshot == m_lastSaved) {
+            m_lastSeen = snapshot;
+            m_sinceFirstUnsaved.invalidate();
+            return;
+        }
+        if (!m_sinceFirstUnsaved.isValid()) {
+            m_sinceFirstUnsaved.start();
+        }
+        if (snapshot != m_lastSeen || !m_sinceChange.isValid()) {
+            m_lastSeen = snapshot;
+            m_sinceChange.start();
+        }
+        const bool quiet = m_sinceChange.elapsed() >= m_timing.quietMs;
+        const bool overdue = m_sinceFirstUnsaved.elapsed() >= m_timing.maxDelayMs;
+        if (!quiet && !overdue) {
+            return;
+        }
+        if (m_sinceFailure.isValid() && m_sinceFailure.elapsed() < m_timing.retryMs) {
+            return;
+        }
+        m_writing = true;
+        const QString filePath = m_filePath;
+        QObject* pContext = m_pContext.get();
+        m_pWorker->start([this, filePath, snapshot, pContext] {
+            const bool ok = writeFileAtomically(filePath, snapshot);
+            // Back on the GUI thread. stop() waits for this task, so pContext
+            // outlives the call; a result still queued when pContext is
+            // deleted is dropped with it.
+            QMetaObject::invokeMethod(
+                    pContext,
+                    [this, ok, snapshot] { writeFinished(ok, snapshot); },
+                    Qt::QueuedConnection);
+        });
+    }
+
+    void writeFinished(bool ok, const QByteArray& snapshot) {
+        m_writing = false;
+        if (!ok) {
+            // writeFileAtomically() has logged why; the old file is intact.
+            m_sinceFailure.start();
+            return;
+        }
+        m_sinceFailure.invalidate();
+        m_lastSaved = snapshot;
+        // Changes made while the file was written start a new window.
+        m_sinceFirstUnsaved.invalidate();
+        qDebug() << "EffectsAutosave: saved" << m_filePath;
+    }
+
+    const QString m_filePath;
+    const Snapshot m_snapshot;
+    const Timing m_timing;
+    std::unique_ptr<QObject> m_pContext;
+    std::unique_ptr<QTimer> m_pPollTimer;
+    std::unique_ptr<QThreadPool> m_pWorker;
+    QByteArray m_lastSaved;
+    QByteArray m_lastSeen;
+    bool m_writing = false;
+    QElapsedTimer m_sinceChange;
+    QElapsedTimer m_sinceFirstUnsaved;
+    QElapsedTimer m_sinceFailure;
+};
+
+} // namespace mixxx
