#!/usr/bin/python3
"""Seed missing touch defaults before Mixxx starts; retain every saved choice.

One exception, once: the three-band waveform default (three_band_once).
"""
import argparse
import os
from pathlib import Path
import re
import stat
import subprocess
import tempfile


def add_missing(source, section, defaults):
    sections = list(re.finditer(r"(?m)^\[([^\]\r\n]+)\][ \t]*\r?$", source))
    matches = [match for match in sections if match.group(1) == section]
    if len(matches) > 1:
        raise ValueError(f"Duplicate [{section}] sections; keep configuration unchanged")
    if not matches:
        return source.rstrip() + f"\n\n[{section}]\n" + "".join(
            f"{key} {value}\n" for key, value in defaults.items())
    match = matches[0]
    following = [item.start() for item in sections if item.start() > match.start()]
    end = following[0] if following else len(source)
    block = source[match.end():end]
    missing = [f"{key} {value}\n" for key, value in defaults.items()
               if not re.search(r"(?m)^" + re.escape(key) + r"(?:[ \t]|\r?$)", block)]
    if not missing:
        return source
    return source[:match.end()] + "\n" + "".join(missing) + block.lstrip("\r\n") + source[end:]


def set_value(source, section, key, value):
    """Set KEY in [SECTION] to VALUE, replacing a saved value."""
    sections = list(re.finditer(r"(?m)^\[([^\]\r\n]+)\][ \t]*\r?$", source))
    matches = [match for match in sections if match.group(1) == section]
    if len(matches) != 1:
        return add_missing(source, section, {key: value})
    match = matches[0]
    following = [item.start() for item in sections if item.start() > match.start()]
    end = following[0] if following else len(source)
    block = source[match.end():end]
    line = re.compile(r"(?m)^" + re.escape(key) + r"(?:[ \t][^\r\n]*)?$")
    if not line.search(block):
        return add_missing(source, section, {key: value})
    return source[:match.end()] + line.sub(f"{key} {value}", block, count=1) + source[end:]


def three_band_once(source):
    """Three-band waveforms (owner, 2026-11-23: three-band by default, a setting
    in Settings > Advanced). Once, the decks' waveforms are switched to 3-BAND,
    Mixxx's Filtered waveform ([Waveform] WaveformType 19); [MixPi]
    ThreeBandDefault 1 records that, so a later choice of RGB in Settings is kept."""
    if not re.search(r"(?m)^ThreeBandDefault(?:[ \t]|\r?$)", section_block(source, "MixPi")):
        source = set_value(source, "Waveform", "WaveformType", "19")
        source = add_missing(source, "MixPi", {"ThreeBandDefault": "1"})
    return source


def section_block(source, section):
    sections = list(re.finditer(r"(?m)^\[([^\]\r\n]+)\][ \t]*\r?$", source))
    matches = [match for match in sections if match.group(1) == section]
    if len(matches) > 1:
        raise ValueError(f"Duplicate [{section}] sections; keep configuration unchanged")
    if not matches:
        return ""
    following = [item.start() for item in sections if item.start() > matches[0].start()]
    return source[matches[0].end():following[0] if following else len(source)]


def seed(config):
    existed = os.path.lexists(config)
    source = config.read_text() if existed else ""
    result = add_missing(source, "Library", {
        "RowHeight": "34", "Font": "Sans Serif,-1,17,5,50,0,0,0,0,0"})
    if not existed:
        # Hide the menu bar without Mixxx's blocking "hide the menu bar?"
        # question, which otherwise interrupts every touch-only start.
        result = add_missing(result, "Config", {"ResizableSkin": "Pioneered",
                                                "hide_menubar": "1", "show_menubar_hint": "0"})
        result = add_missing(result, "Library", {"MixPiBootstrapLibrary": "1"})
        # Elapsed time only; a tap on the readout shows the remaining time.
        result = add_missing(result, "Controls", {"PositionDisplay": "0"})
    result = three_band_once(result)
    if result == source:
        return
    config.parent.mkdir(parents=True, exist_ok=True)
    mode = stat.S_IMODE(config.stat().st_mode) if existed else 0o600
    with tempfile.NamedTemporaryFile(mode="w", dir=config.parent,
                                     prefix=".mixpi-touch-", delete=False) as handle:
        temporary = Path(handle.name)
        try:
            handle.write(result)
            handle.flush()
            os.fchmod(handle.fileno(), mode)
            os.replace(temporary, config)
        finally:
            temporary.unlink(missing_ok=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--config", type=Path, default=Path.home() / ".mixxx/mixxx.cfg")
    args = parser.parse_args()
    running = subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "mixxx"],
                             stdout=subprocess.DEVNULL, check=False)
    if running.returncode != 1:
        parser.exit(1, "Mixxx may be running; touch defaults were not changed.\n")
    try:
        seed(args.config)
    except (OSError, ValueError) as error:
        parser.exit(1, f"Touch defaults unchanged: {error}\n")


if __name__ == "__main__":
    main()
