+WaveformWidgetType::Type WaveformWidgetFactory::mixpiAppliedType() const {
+    // m_configType: setConfig has checked it against the types this start can
+    // draw, slotSkinLoaded gives it to the waveforms, and every later change
+    // of m_type sets it too.
+    for (const auto& holder : m_waveformWidgetHolders) {
+        if (!holder.m_waveformWidget || holder.m_waveformWidget->getType() != m_configType) {
+            return WaveformWidgetType::EmptyWaveform;
+        }
+    }
+    return m_configType;
+}
+
+bool WaveformWidgetFactory::mixpiSwitchTo(WaveformWidgetType::Type type) {
+    const int handle = findHandleIndexFromType(type);
+    if (handle < 0) {
+        return false;
+    }
+    setWidgetTypeFromHandle(handle);
+    return mixpiAppliedType() == type;
+}
