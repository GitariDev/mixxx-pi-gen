+// A button with an agreed icon before its label (OPEN with the list icon,
+// EJECT with the eject icon). The stylesheet paints the button; the icon and
+// the label take its text colour. QSS colours for :pressed do not reach the
+// palette, so the button carries down="true" while pressed and the
+// stylesheet gives that state its text colour too.
+class MixpiGlyphButton : public QPushButton {
+  public:
+    static constexpr int kIcon = 20;
+    static constexpr int kGap = 6;
+    MixpiGlyphButton(mixpi_media::Glyph glyph, const QString& text, QWidget* parent)
+            : QPushButton(text, parent), m_glyph(glyph) {
+        setFocusPolicy(Qt::NoFocus);
+        setProperty("down", false);
+        connect(this, &QPushButton::pressed, this, [this] { setDownLook(true); });
+        connect(this, &QPushButton::released, this, [this] { setDownLook(false); });
+    }
+
+  protected:
+    void paintEvent(QPaintEvent*) override {
+        QStylePainter painter(this);
+        QStyleOptionButton option;
+        initStyleOption(&option);
+        option.text.clear();
+        option.icon = QIcon();
+        painter.drawControl(QStyle::CE_PushButton, option);
+        const QColor color = palette().color(QPalette::ButtonText);
+        const int textWidth = fontMetrics().horizontalAdvance(text());
+        const int left = (width() - (kIcon + kGap + textWidth)) / 2;
+        mixpi_media::paintGlyph(painter, m_glyph, QRectF(left, (height() - kIcon) / 2.0, kIcon, kIcon), color);
+        painter.setPen(color);
+        painter.drawText(QRect(left + kIcon + kGap, 0, textWidth + 2, height()), Qt::AlignLeft | Qt::AlignVCenter,
+                text());
+    }
+
+  private:
+    void setDownLook(bool down) {
+        if (property("down").toBool() != down) {
+            setProperty("down", down);
+            mixpi_media::repolish(this);
+        }
+    }
+
+    mixpi_media::Glyph m_glyph;
+};
