+// The agreed icons (design/all-mockups.html, 24 x 24 view box, 1.8 stroke,
+// round caps and joins).
+enum class Glyph { Usb, List, Eject };
+
+inline QPainterPath glyphPath(Glyph glyph) {
+    QPainterPath path;
+    const auto line = [&path](std::initializer_list<QPointF> points) {
+        auto point = points.begin();
+        path.moveTo(*point);
+        for (++point; point != points.end(); ++point) {
+            path.lineTo(*point);
+        }
+    };
+    switch (glyph) {
+    case Glyph::Usb:
+        line({{12, 3}, {12, 18}});
+        path.addEllipse(QPointF(12, 19.5), 1.8, 1.8);
+        line({{12, 14}, {7, 11}, {7, 8}});
+        line({{12, 12}, {17, 9}, {17, 6}});
+        path.addRect(QRectF(5.5, 6, 3, 2.5));
+        path.addEllipse(QPointF(17, 5), 1.4, 1.4);
+        line({{10, 5}, {12, 2.5}, {14, 5}});
+        break;
+    case Glyph::List:
+        for (const double y : {7.0, 12.0, 17.0}) {
+            line({{9, y}, {20, y}});
+            line({{4, y}, {5, y}});
+        }
+        break;
+    case Glyph::Eject:
+        line({{12, 5}, {19, 13}, {5, 13}});
+        path.closeSubpath();
+        line({{5, 18}, {19, 18}});
+        break;
+    }
+    return path;
+}
+
+inline void paintGlyph(QPainter& painter, Glyph glyph, const QRectF& box, const QColor& color) {
+    painter.save();
+    painter.setRenderHint(QPainter::Antialiasing);
+    painter.translate(box.topLeft());
+    painter.scale(box.width() / 24.0, box.height() / 24.0);
+    painter.setPen(QPen(color, 1.8, Qt::SolidLine, Qt::RoundCap, Qt::RoundJoin));
+    painter.setBrush(Qt::NoBrush);
+    painter.drawPath(glyphPath(glyph));
+    painter.restore();
+}
+
 } // namespace mixpi_media
 
