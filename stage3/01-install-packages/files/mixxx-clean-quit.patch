diff --git a/src/util/unixsignalquit.h b/src/util/unixsignalquit.h
new file mode 100644
index 0000000..0fe950b
--- /dev/null
+++ b/src/util/unixsignalquit.h
@@ -0,0 +1,128 @@
+#pragma once
+
+// MixPi: turn SIGTERM and SIGHUP into the normal quit path.
+//
+// systemd stops the Mix Pi session (service stop, reboot, power-off) with
+// SIGTERM. The default action kills Mixxx at once, so mixxx.cfg and
+// samplers.xml are never written. This follows Qt's documented Unix-signal
+// pattern: the handler only writes one byte to a socketpair, and a
+// QSocketNotifier calls the quit function from the event loop. Only the first
+// request quits; later signals (a second stop, a SIGHUP during shutdown) are
+// logged and ignored. The handlers stay installed until the process exits, so
+// a later signal can never kill Mixxx while it saves.
+
+#include <QSocketNotifier>
+#include <QtDebug>
+#include <cerrno>
+#include <csignal>
+#include <fcntl.h>
+#include <functional>
+#include <memory>
+#include <sys/socket.h>
+#include <unistd.h>
+#include <utility>
+
+namespace mixxx {
+
+class UnixSignalQuit {
+  public:
+    using QuitFunction = std::function<void(int signalNumber)>;
+
+    // Installs the handlers at once. Requests are held in the socket until
+    // enable() runs, so a stop during startup quits as soon as the event
+    // loop runs instead of killing Mixxx half-initialized.
+    UnixSignalQuit() {
+        if (s_fds[0] >= 0) {
+            return; // One process-wide installation.
+        }
+        int fds[2];
+        if (::socketpair(AF_UNIX, SOCK_STREAM, 0, fds) != 0) {
+            qWarning() << "UnixSignalQuit: socketpair failed, errno" << errno;
+            return;
+        }
+        for (int fd : fds) {
+            ::fcntl(fd, F_SETFD, FD_CLOEXEC);
+            ::fcntl(fd, F_SETFL, ::fcntl(fd, F_GETFL) | O_NONBLOCK);
+        }
+        s_fds[0] = fds[0];
+        s_fds[1] = fds[1];
+        for (int signalNumber : {SIGTERM, SIGHUP}) {
+            struct sigaction previous = {};
+            ::sigaction(signalNumber, nullptr, &previous);
+            if (previous.sa_handler == SIG_IGN) {
+                continue; // Keep nohup and similar callers working.
+            }
+            struct sigaction action = {};
+            action.sa_handler = &UnixSignalQuit::handle;
+            sigemptyset(&action.sa_mask);
+            action.sa_flags = SA_RESTART;
+            ::sigaction(signalNumber, &action, nullptr);
+        }
+    }
+
+    UnixSignalQuit(const UnixSignalQuit&) = delete;
+    UnixSignalQuit& operator=(const UnixSignalQuit&) = delete;
+
+    void setQuitFunction(QuitFunction quit) {
+        m_quit = std::move(quit);
+    }
+
+    // Starts delivering requests from the calling thread's event loop.
+    void enable() {
+        if (s_fds[1] < 0 || m_pNotifier) {
+            return;
+        }
+        m_pNotifier = std::make_unique<QSocketNotifier>(s_fds[1], QSocketNotifier::Read);
+        QObject::connect(m_pNotifier.get(),
+                &QSocketNotifier::activated,
+                m_pNotifier.get(),
+                [this] { readRequests(); });
+    }
+
+    // The event loop has ended (by any path): later signals only log.
+    void finish() {
+        m_quitRequested = true;
+        m_quit = nullptr;
+    }
+
+    bool quitRequested() const {
+        return m_quitRequested;
+    }
+
+  private:
+    // Async-signal-safe: write(2) only, errno preserved, no allocation or Qt.
+    static void handle(int signalNumber) {
+        const int savedErrno = errno;
+        const unsigned char byte = static_cast<unsigned char>(signalNumber);
+        // A full socket (EAGAIN) means a request is already pending.
+        [[maybe_unused]] const ssize_t written = ::write(s_fds[0], &byte, 1);
+        errno = savedErrno;
+    }
+
+    void readRequests() {
+        unsigned char bytes[16];
+        ssize_t count;
+        while ((count = ::read(s_fds[1], bytes, sizeof(bytes))) > 0) {
+            for (ssize_t i = 0; i < count; ++i) {
+                const int signalNumber = bytes[i];
+                if (m_quitRequested) {
+                    qInfo() << "Signal" << signalNumber
+                            << "received while Mixxx is already quitting; ignored";
+                    continue;
+                }
+                m_quitRequested = true;
+                qInfo() << "Signal" << signalNumber << "received; quitting Mixxx";
+                if (m_quit) {
+                    m_quit(signalNumber);
+                }
+            }
+        }
+    }
+
+    inline static int s_fds[2] = {-1, -1};
+    QuitFunction m_quit;
+    std::unique_ptr<QSocketNotifier> m_pNotifier;
+    bool m_quitRequested = false;
+};
+
+} // namespace mixxx
