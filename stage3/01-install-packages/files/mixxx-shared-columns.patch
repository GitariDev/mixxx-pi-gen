+        const int column = columnOf.value(arranged.at(position));
+        moveSection(visualIndex(column), position);
+    }
+    for (const auto& entry : shared) {
+        const auto it = columnOf.constFind(entry.name);
+        if (it == columnOf.constEnd()) {
+            continue; // a column this table does not have
+        }
+        const int column = it.value();
+        setSectionHidden(column, entry.hidden);
+        const int size = std::max(entry.size, WTTVH_MINIMUM_SECTION_SIZE);
+        resizeSection(column, size);
+        if (entry.hidden) {
+            m_hiddenColumnSizes.insert(column, size);
+        } else {
+            m_hiddenColumnSizes.remove(column);
+        }
+    }
+    bool shown = false;
+    for (int column : std::as_const(columnOf)) {
+        shown = shown || !isSectionHidden(column);
+    }
+    if (!shown) {
+        // None of the shared columns shows here: the table's defaults.
+        loadDefaultHeaderState();
+    }
+    m_applyingShared = false;
+    return true;
