diff --git a/src/util/mixpiwaveformcolours.h b/src/util/mixpiwaveformcolours.h
new file mode 100644
index 0000000..de4dd01
--- /dev/null
+++ b/src/util/mixpiwaveformcolours.h
@@ -0,0 +1,170 @@
+#pragma once
+
+#include <QMetaObject>
+#include <QObject>
+#include <QString>
+#include <QThread>
+#include <QtDebug>
+#include <functional>
+#include <utility>
+
+#include "control/controlobject.h"
+#include "preferences/usersettings.h"
+
+/// MixPi Settings › Advanced, Waveform colours (three-band R&D; owner,
+/// 2026-11-23: direction A Overlay, as a setting, in Advanced).
+///
+/// - [MixPi],waveform_colours is 0 for RGB (Mixxx's all-shader RGB waveform,
+///   type 17: one mixed colour per column) or 1 for 3-BAND (the all-shader
+///   Filtered waveform, type 19: bass, mids and highs drawn over each other in
+///   the skin's SignalLowColor, SignalMidColor and SignalHighColor). Any other
+///   value is refused.
+/// - The setting is Mixxx's own [Waveform],WaveformType, and the waveform
+///   factory is its only writer. This object lives only while the factory
+///   does: the main window makes it after the factory and deletes it before
+///   the factory, and hands it the factory as three calls (Waveforms).
+/// - A request may come from any thread (a controller script or a MIDI
+///   mapping writes from the controller thread). It never touches a widget
+///   there: Qt queues it to this object's thread, the GUI thread, and the
+///   requests are applied in the order they were made.
+/// - The control shows what the factory runs, not what was asked for: 1 when
+///   every scrolling waveform runs type 19, otherwise 0. A request is confirmed
+///   only when the factory runs the asked type afterwards; when it cannot,
+///   nothing is confirmed, and if a waveform fell back to the empty one the
+///   type from before is asked for again. Either way the control then shows
+///   what the factory runs. sync() re-reads it whenever the
+///   factory changes the type (the skin has loaded, Mixxx's own Preferences).
+/// - [MixPi],waveform_three_band_available is read-only: 1 when this start
+///   can draw type 19 (the factory has a handle for it), otherwise 0 (no
+///   shader support). The skin binds the 3-BAND button's enabled state to it,
+///   so the choice looks unavailable instead of doing nothing (owner,
+///   2026-11-23: "Show it unavailable"). RGB is always enabled.
+/// - The overview strips have their own type and do not change.
+class MixpiWaveformColours : public QObject {
+  public:
+    static constexpr int kRgb = 0;
+    static constexpr int kThreeBand = 1;
+    // WaveformWidgetType::AllShaderRGBWaveform and AllShaderFilteredWaveform.
+    static constexpr int kRgbType = 17;
+    static constexpr int kThreeBandType = 19;
+
+    /// The waveform factory, as this setting uses it. Called on the GUI
+    /// thread only.
+    struct Waveforms {
+        /// The type every scrolling waveform runs (before the skin has made
+        /// them, the type they will get); 0, the empty type, when one of
+        /// them could not start it.
+        std::function<int()> appliedType;
+        /// Switches every scrolling waveform to the type and saves it. True
+        /// when they all run it afterwards.
+        std::function<bool(int)> switchTo;
+        /// True when this start can draw the type (the factory has a handle
+        /// for it).
+        std::function<bool(int)> canDraw;
+    };
+
+    /// Three-band by default, once (owner, 2026-11-23). Called when mixxx.cfg
+    /// has been read, before anything reads [Waveform],WaveformType: without
+    /// [MixPi],ThreeBandDefault the type becomes 19. The key is recorded by
+    /// the constructor below once the factory has taken the type, so a later
+    /// choice of RGB is kept. Mixxx's own parser has read the file, so a
+    /// repeated or indented key counts as Mixxx reads it.
+    static void defaultOnce(const UserSettingsPointer& pSettings) {
+        if (!pSettings->exists(defaultDoneKey())) {
+            pSettings->setValue(typeKey(), kThreeBandType);
+        }
+    }
+
+    MixpiWaveformColours(UserSettingsPointer pSettings,
+            Waveforms waveforms,
+            QObject* pParent = nullptr)
+            : QObject(pParent),
+              m_pSettings(std::move(pSettings)),
+              m_waveforms(std::move(waveforms)),
+              m_pColours(new ControlObject(ConfigKey(
+                      QStringLiteral("[MixPi]"), QStringLiteral("waveform_colours")))),
+              m_pThreeBandAvailable(new ControlObject(ConfigKey(
+                      QStringLiteral("[MixPi]"),
+                      QStringLiteral("waveform_three_band_available")))) {
+        m_pColours->setParent(this);
+        m_pThreeBandAvailable->setParent(this);
+        m_pThreeBandAvailable->setReadOnly();
+        if (!m_pSettings->exists(defaultDoneKey())) {
+            if (appliedType() == kThreeBandType) {
+                m_pSettings->setValue(defaultDoneKey(), 1);
+            } else {
+                qWarning() << "MixPi: this start cannot draw the three-band waveforms;"
+                           << "the default is tried again at the next start";
+            }
+        }
+        sync();
+        // Not a direct connection: a request made on another thread is
+        // delivered on this object's thread.
+        m_pColours->connectValueChangeRequest(
+                this, [this](double value) { request(value); });
+    }
+
+    /// Shows what the factory runs, and whether it can draw 3-BAND.
+    void sync() {
+        m_pThreeBandAvailable->forceSet(
+                m_waveforms.canDraw && m_waveforms.canDraw(kThreeBandType) ? 1 : 0);
+        m_pColours->setAndConfirm(valueForType(appliedType()));
+    }
+
+    static int valueForType(int type) {
+        return type == kThreeBandType ? kThreeBand : kRgb;
+    }
+
+    static int typeForValue(int value) {
+        return value == kThreeBand ? kThreeBandType : kRgbType;
+    }
+
+    static ConfigKey typeKey() {
+        return ConfigKey(QStringLiteral("[Waveform]"), QStringLiteral("WaveformType"));
+    }
+
+    static ConfigKey defaultDoneKey() {
+        return ConfigKey(QStringLiteral("[MixPi]"), QStringLiteral("ThreeBandDefault"));
+    }
+
+  private:
+    int appliedType() const {
+        return m_waveforms.appliedType ? m_waveforms.appliedType() : 0;
+    }
+
+    /// On this object's thread. The connection is not direct, so Qt has
+    /// already queued a request made elsewhere; the check keeps a widget from
+    /// ever being touched off the GUI thread.
+    void request(double value) {
+        if (value != kRgb && value != kThreeBand) {
+            return;
+        }
+        if (QThread::currentThread() != thread()) {
+            QMetaObject::invokeMethod(
+                    this, [this, value] { request(value); }, Qt::QueuedConnection);
+            return;
+        }
+        apply(static_cast<int>(value));
+    }
+
+    /// The GUI thread only.
+    void apply(int value) {
+        if (!m_waveforms.switchTo) {
+            return;
+        }
+        const int type = typeForValue(value);
+        const int before = appliedType();
+        if (!m_waveforms.switchTo(type)) {
+            qWarning() << "MixPi: the waveforms cannot run type" << type;
+            if (before != 0 && appliedType() != before) {
+                m_waveforms.switchTo(before);
+            }
+        }
+        sync();
+    }
+
+    UserSettingsPointer m_pSettings;
+    Waveforms m_waveforms;
+    ControlObject* m_pColours;
+    ControlObject* m_pThreeBandAvailable;
+};
