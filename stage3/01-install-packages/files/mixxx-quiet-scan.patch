 LibraryScannerDlg::~LibraryScannerDlg() {
+    // The main window may already have deleted the strip with its children.
+    delete m_pStrip.data();
+}
+
+bool LibraryScannerDlg::eventFilter(QObject* pObject, QEvent* pEvent) {
+    if (m_pStrip && pObject == m_pStrip->parentWidget() &&
+            pEvent->type() == QEvent::Resize) {
+        placeStrip();
+    }
+    return QWidget::eventFilter(pObject, pEvent);
+}
+
+bool LibraryScannerDlg::stripShown() const {
+    return m_pStrip && !m_pStrip->isHidden();
+}
+
+void LibraryScannerDlg::showStrip() {
+    if (!m_pStrip) {
+        return;
+    }
+    QWidget* pHost = scannerStripHost();
+    if (pHost && m_pStrip->parentWidget() != pHost) {
+        if (m_pStrip->parentWidget()) {
+            m_pStrip->parentWidget()->removeEventFilter(this);
+        }
+        // A child widget: no separate window, no modality, no activation.
+        m_pStrip->setParent(pHost, Qt::Widget);
+        pHost->installEventFilter(this);
+    }
+    placeStrip();
+    m_pStrip->raise();
+    m_pStrip->show();
+}
+
+void LibraryScannerDlg::hideStrip() {
+    if (m_pStrip) {
+        m_pStrip->hide();
+    }
+}
+
+void LibraryScannerDlg::placeStrip() {
+    QWidget* pHost = m_pStrip->parentWidget();
+    if (pHost) {
+        m_pStrip->setGeometry(0,
+                pHost->height() - kStripHeight,
+                pHost->width(),
+                kStripHeight);
+    } else {
+        m_pStrip->resize(480, kStripHeight);
+    }
 }
 
