+
+QString WLibrarySidebar::tileOf(const QModelIndex& index) const {
+    // The tile that holds a row: a node tile's row or a row below it (the
+    // deepest such node), else a set tile with the row's top-level source.
+    QString found;
+    int depth = -1;
+    for (const auto& tile : m_groupedTiles) {
+        int level = 0;
+        for (QModelIndex step = tile.node; step.isValid(); step = step.parent()) {
+            ++level;
+        }
+        for (QModelIndex step = index; step.isValid() && tile.node.isValid(); step = step.parent()) {
+            if (step == tile.node && level > depth) {
+                found = tile.id;
+                depth = level;
+            }
+        }
+    }
+    if (!found.isEmpty() || !index.isValid()) {
+        return found;
+    }
+    QModelIndex top = index;
+    while (top.parent().isValid()) {
+        top = top.parent();
+    }
+    for (const auto& tile : m_groupedTiles) {
+        if (tile.rows.contains(QPersistentModelIndex(top))) {
+            return tile.id;
+        }
+    }
+    return {};
+}
+
+bool WLibrarySidebar::withinSelectedTile() const {
+    const auto* pTile = selectedTile();
+    if (!pTile) {
+        return false;
+    }
+    const QModelIndex root = rootIndex();
+    if (pTile->node.isValid()) {
+        // At the tile's row or below it; or, for a row without children
+        // (Recordings), the level that shows it.
+        for (QModelIndex step = root; step.isValid(); step = step.parent()) {
+            if (step == pTile->node) {
+                return true;
+            }
+        }
+        return root == pTile->node.parent() && model()->rowCount(pTile->node) == 0;
+    }
+    QModelIndex top = root;
+    while (top.parent().isValid()) {
+        top = top.parent();
+    }
+    return !top.isValid() || pTile->rows.contains(QPersistentModelIndex(top));
+}
+
+void WLibrarySidebar::setSourceRowHidden(int row, bool hidden) {
+    if (hidden) {
+        m_hiddenSourceRows.insert(row);
+    } else {
+        m_hiddenSourceRows.remove(row);
+    }
+    if (groupedTiles && m_sourceScreen) {
+        applyTileFilter();
+    } else {
+        setRowHidden(row, QModelIndex(), hidden);
+    }
+}
+
+bool WLibrarySidebar::isSourceRowHidden(int row) const {
+    return m_hiddenSourceRows.contains(row);
+}
+
+void WLibrarySidebar::applyTileFilter() {
+    if (!model()) {
+        return;
+    }
+    // A set tile shows its rows only; a node tile without children shows its
+    // own row only. The owner's hidden sources stay hidden.
+    const auto* pTile = groupedTiles && m_sourceScreen ? selectedTile() : nullptr;
+    for (int row = 0; row < model()->rowCount(); ++row) {
+        const QPersistentModelIndex index(model()->index(row, 0));
+        bool shown = !m_hiddenSourceRows.contains(row);
+        if (pTile && !pTile->rows.isEmpty()) {
+            shown = shown && pTile->rows.contains(index);
+        } else if (pTile && pTile->node.isValid() && !pTile->node.parent().isValid()) {
+            shown = index == pTile->node;
+        }
+        if (isRowHidden(row, QModelIndex()) == shown) {
+            setRowHidden(row, QModelIndex(), !shown);
+        }
+    }
+}
+
+void WLibrarySidebar::openGroupedTile(const QString& id, bool activate) {
+    if (!m_touchNavigation || m_sourcesEditing) {
+        return;
+    }
+    m_selectedTile = id;
+    const auto* pTile = selectedTile();
+    applyTileFilter();
+    if (!pTile) {
+        m_touchNavigation->setFloor({});
+        m_touchNavigation->home();
+        updateSourceChrome();
+        return;
+    }
+    const QPersistentModelIndex node = pTile->node;
+    m_touchNavigation->setFloor(node);
+    m_touchNavigation->home();
+    if (!node.isValid()) {
+        // A set tile (This Pi): its sources at the top level.
+        updateSourceChrome();
+        return;
+    }
+    // A node tile: its row's children on the right.
+    m_touchNavigation->reveal(node);
+    if (activate) {
+        selectionModel()->setCurrentIndex(node,
+                QItemSelectionModel::ClearAndSelect | QItemSelectionModel::Rows);
+        // The same as a tap on the row: it opens in Tracks, and a list
+        // without children closes Sources.
+        activateTouchIndex(node);
+    } else {
+        m_touchNavigation->enter(node);
+    }
+    updateSourceChrome();
+}
