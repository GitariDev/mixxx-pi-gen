@@ -0,0 +1,925 @@
+#pragma once
+
+#include <QDateTime>
+#include <QElapsedTimer>
+#include <QFrame>
+#include <QGridLayout>
+#include <QHBoxLayout>
+#include <QLabel>
+#include <QList>
+#include <QPointer>
+#include <QPushButton>
