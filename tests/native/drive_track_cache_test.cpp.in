using TrackPointer = std::shared_ptr<int>;
constexpr bool sDebug = false;
struct BaseTrackCache {
    BaseTrackCache(const QString& connection)
            : m_tableName(kRekordboxLibraryTable),
              m_idColumn("id"),
              m_columnsJoined("id,title,location,key"),
              m_bIndexBuilt(false),
              m_bIsCaching(false),
              m_database(QSqlDatabase::database(connection)) {
    }
    const QString m_tableName;
    const QString m_idColumn;
    const QString m_columnsJoined;
    mutable TrackId m_recentTrackId;
    mutable TrackPointer m_recentTrackPtr;
    mutable QSet<TrackId> m_dirtyTracks;
    bool m_bIndexBuilt;
    bool m_bIsCaching;
    QHash<TrackId, QVector<QVariant>> m_trackInfo;
    QSqlDatabase m_database;
    int builds = 0;

    int columnCount() const {
        return 4;
    }
    int fieldIndex(ColumnCache::Column column) const {
        switch (column) {
        case ColumnCache::COLUMN_LIBRARYTABLE_TITLE:
            return 1;
        case ColumnCache::COLUMN_TRACKLOCATIONSTABLE_LOCATION:
            return 2;
        case ColumnCache::COLUMN_LIBRARYTABLE_KEY:
            return 3;
        default:
            return -1;
        }
    }
    const TrackPointer& getCachedTrack(TrackId) const {
        return m_recentTrackPtr;
    }
    QVariant getTrackValueForColumn(TrackPointer, int) const {
        return {};
    }
    void resetRecentTrack() const {
        m_recentTrackId = TrackId();
        m_recentTrackPtr.reset();
    }
    void tracksChanged(const QSet<TrackId>&) {
    }
    void buildIndex();
    bool updateIndexWithQuery(const QString& query);
    void updateTrackInIndex(TrackId trackId);
    void updateTracksInIndex(const QSet<TrackId>& trackIds);
    bool isCached(TrackId trackId) const;
    void ensureCached(TrackId trackId);
    QVariant data(TrackId trackId, int column) const;
};
PRODUCTION_CACHE

// The sidebar model: TreeItemModel's index, insert and remove over the real
// TreeItems (removeRows announces the removal, as TreeItemModel's does).
struct Sidebar : QAbstractItemModel {
    TreeItem root;
    TreeItem* getRootItem() const {
        return const_cast<TreeItem*>(&root);
    }
    TreeItem* item(const QModelIndex& index) const {
        return index.isValid() ? static_cast<TreeItem*>(index.internalPointer()) : getRootItem();
    }
    QModelIndex index(int row, int column, const QModelIndex& parent = {}) const override {
        TreeItem* owner = item(parent);
        if (row < 0 || row >= owner->childRows()) {
            return {};
        }
        return createIndex(row, column, owner->child(row));
    }
    QModelIndex parent(const QModelIndex& index) const override {
        TreeItem* owner = index.isValid() ? item(index)->parent() : nullptr;
        if (!owner || owner == &root) {
            return {};
        }
        return createIndex(owner->parentRow(), 0, owner);
    }
    int rowCount(const QModelIndex& parent = {}) const override {
        return item(parent)->childRows();
    }
    int columnCount(const QModelIndex& = {}) const override {
        return 1;
    }
    QVariant data(const QModelIndex& index, int role = Qt::DisplayRole) const override {
        return index.isValid() && role == Qt::DisplayRole ? QVariant(item(index)->getLabel()) : QVariant();
    }
    void triggerRepaint() {
    }
    void insertTreeItemRows(std::vector<std::unique_ptr<TreeItem>>&& rows, int position,
            const QModelIndex& parent = QModelIndex()) {
        if (rows.empty()) {
            return;
        }
        beginInsertRows(parent, position, position + static_cast<int>(rows.size()) - 1);
        item(parent)->insertChildren(position, std::move(rows));
        endInsertRows();
    }
    bool removeRows(int position, int count, const QModelIndex& parent = QModelIndex()) override {
        if (count == 0) {
            return true;
        }
        beginRemoveRows(parent, position, position + count - 1);
        item(parent)->removeChildren(position, count);
        endRemoveRows();
        return true;
    }
};
struct Collection {
    QString name;
    QSqlDatabase database() {
        return QSqlDatabase::database(name);
    }
};
struct Row {
    QString title;
    QString location;
};
// RekordboxPlaylistModel: the list shown, its rows by track id, its cells
// read through the shared track cache.
struct PlaylistModel {
    QString name;
    QSharedPointer<BaseTrackCache> cache;
    QString m_playlist;
    int playlistId = kInvalidPlaylistId;
    QVector<TrackId> rowIds;
    void setPlaylist(const QString& path) {
        m_playlist = path;
        QSqlQuery query(QSqlDatabase::database(name));
        query.prepare("SELECT id FROM rekordbox_playlists WHERE name=:name");
        query.bindValue(":name", path);
        if (query.exec() && query.next()) {
            playlistId = query.value(0).toInt();
        }
    }
    const QString& playlist() const {
        return m_playlist;
    }
    void select() {
        rowIds.clear();
        if (playlistId == kInvalidPlaylistId) {
            return;
        }
        QSqlQuery query(QSqlDatabase::database(name));
        query.prepare("SELECT track_id FROM rekordbox_playlist_tracks WHERE playlist_id=:id ORDER BY position");
        query.bindValue(":id", playlistId);
        if (query.exec()) {
            while (query.next()) {
                rowIds.append(TrackId(query.value(0)));
            }
        }
        if (!rowIds.isEmpty() && !cache->m_bIndexBuilt) {
            cache->buildIndex();
        }
    }
    QVariant cell(TrackId id, ColumnCache::Column column) const {
        if (!cache->isCached(id)) {
            cache->ensureCached(id);
        }
        return cache->data(id, cache->fieldIndex(column));
    }
    QList<Row> rows() const {
        QList<Row> result;
        for (const auto& id : rowIds) {
            result.append({cell(id, ColumnCache::COLUMN_LIBRARYTABLE_TITLE).toString(),
                    QDir::fromNativeSeparators(
                            cell(id, ColumnCache::COLUMN_TRACKLOCATIONSTABLE_LOCATION).toString())});
        }
        return result;
    }
};
