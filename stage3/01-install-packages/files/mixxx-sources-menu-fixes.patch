diff --git a/src/library/mixpistartdrive.h b/src/library/mixpistartdrive.h
new file mode 100644
index 0000000..7453aa6
--- /dev/null
+++ b/src/library/mixpistartdrive.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#include <QJsonArray>
+#include <QJsonObject>
+#include <QString>
+#include <functional>
+
+// ★ on the drive row of Sources edit (agreed UI s5, m-sources-edit.png):
+// Tracks starts at the drive. The drive is the first one in the media
+// inventory that has a mounted volume. It opens only when it has exactly one
+// volume (a drive with more is chosen on the Media page) and no drive is
+// open yet (Tracks shows that one).
+struct MixpiStartDrive {
+    QString identity;
+    QString token;
+    bool isEmpty() const {
+        return token.isEmpty();
+    }
+};
+
+inline MixpiStartDrive mixpiStartDrive(const QJsonObject& snapshot,
+        const std::function<bool(const QJsonObject&)>& opened) {
+    const auto drives = snapshot.value(QStringLiteral("drives")).toArray();
+    for (const auto& value : drives) {
+        if (opened(value.toObject())) {
+            return {};
+        }
+    }
+    for (const auto& value : drives) {
+        const auto drive = value.toObject();
+        const auto volumes = drive.value(QStringLiteral("volumes")).toArray();
+        if (volumes.isEmpty()) {
+            continue;
+        }
+        if (volumes.size() != 1) {
+            return {};
+        }
+        return {drive.value(QStringLiteral("identity")).toString(),
+                volumes.first().toObject().value(QStringLiteral("token")).toString()};
+    }
+    return {};
+}
