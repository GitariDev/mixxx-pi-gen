+void WLibrarySidebar::updateSourceScreen() {
+    const bool wanted = m_touchNavigation &&
+            width() >= LibraryInterface::kSourceScreenMinimumWidth;
+    if (wanted != m_sourceScreen) {
+        m_sourceScreen = wanted;
+        if (wanted && !m_sourceRail) {
+            m_sourceRail = new QScrollArea(this);
+            m_sourceRail->setObjectName("MixpiSourceRail");
+            m_sourceRail->setFrameShape(QFrame::NoFrame);
+            m_sourceRail->setWidgetResizable(true);
+            m_sourceRail->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+            auto* pTiles = new QWidget(m_sourceRail);
+            pTiles->setObjectName("MixpiSourceTiles");
+            auto* pTileLayout = new QVBoxLayout(pTiles);
+            pTileLayout->setContentsMargins(0, 0, 0, 0);
+            pTileLayout->setSpacing(0);
+            pTileLayout->addStretch();
+            m_sourceRail->setWidget(pTiles);
+            m_sourceRailDrag = new LibraryInterface::TouchDragScroll(m_sourceRail);
+            m_sourceBar = new QWidget(this);
+            m_sourceBar->setObjectName("MixpiSourceBar");
+            m_sourceBar->setAttribute(Qt::WA_StyledBackground);
+            m_sourceBack = new QPushButton(tr("Back"), m_sourceBar);
+            m_sourceBack->setObjectName("MixpiSourceBack");
+            m_sourceBack->setFocusPolicy(Qt::NoFocus);
+            m_sourceBack->setFixedSize(LibraryInterface::kSourceBackWidth,
+                    LibraryInterface::kSourceBarHeight);
+            connect(m_sourceBack, &QPushButton::clicked, this, [this] {
+                if (m_touchNavigation) {
+                    m_touchNavigation->back();
+                }
+            });
+            m_sourceCrumbLabel = new QLabel(m_sourceBar);
+            m_sourceCrumbLabel->setObjectName("MixpiSourceCrumb");
+        }
+        if (m_sourceRail) {
+            m_sourceRail->setVisible(wanted);
+            m_sourceBar->setVisible(wanted && !m_sourcesEditing);
+        }
+        if (wanted) {
+            // The rail and the bar start at the edge: no frame around them.
+            m_frameShape = frameShape();
+            setFrameShape(QFrame::NoFrame);
+            applySourceMargins();
+            rebuildSourceRail();
+        } else {
+            setFrameShape(m_frameShape);
+            // QTreeView sets its own (header) margins again.
+            setViewportMargins(0, 0, 0, 0);
+            updateGeometries();
+        }
+        // Row heights change with the screen.
+        scheduleDelayedItemsLayout();
+    }
+    layoutSourceScreen();
+}
+
+void WLibrarySidebar::layoutSourceScreen() {
+    if (m_sourceScreen && frameShape() != QFrame::NoFrame) {
+        // Polishing (a style sheet) may bring the frame back.
+        setFrameShape(QFrame::NoFrame);
+    }
+    const int frame = frameWidth();
+    const QRect inside = rect().adjusted(frame, frame, -frame, -frame);
+    if (m_sourceScreen) {
+        const int rail = LibraryInterface::kSourceRailWidth;
+        const int bar = LibraryInterface::kSourceBarHeight;
+        m_sourceRail->setGeometry(inside.x(), inside.y(), rail, inside.height());
+        m_sourceBar->setGeometry(inside.x() + rail, inside.y(), inside.width() - rail, bar);
+        m_sourceBack->move(4, 0);
+        const int crumbLeft = 4 + LibraryInterface::kSourceBackWidth + 8;
+        m_sourceCrumbLabel->setGeometry(crumbLeft, 0,
+                std::max(0, m_sourceBar->width() - crumbLeft - 8), bar);
+        m_sourceRail->raise();
+        m_sourceBar->raise();
+        updateSourceChrome();
+    }
+    if (m_sourcesEditPanel) {
+        m_sourcesEditPanel->setGeometry(m_sourceScreen
+                        ? inside.adjusted(LibraryInterface::kSourceRailWidth, 0, 0, 0)
+                        : inside);
+        if (m_sourcesEditing) {
+            m_sourcesEditPanel->raise();
+        }
+    }
+}
