@@ -0,0 +1,345 @@
+#pragma once
+
+#include "library/media/mediause.h"
+
+#ifdef __linux__
+#include <algorithm>
+#include <chrono>
+#include <functional>
+#include <linux/nsfs.h>
+#include <poll.h>
+#include <pwd.h>
+#include <sched.h>
+#include <sys/file.h>
+#include <sys/ioctl.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <vector>
