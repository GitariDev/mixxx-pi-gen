#ifndef BASELINE
    void resetTrackCache();
    void dropRemovedList();
#endif
};

PRODUCTION_METHODS

QByteArray driveDigest(const QString& path) {
    QCryptographicHash hash(QCryptographicHash::Sha256);
    QDirIterator files(path, QDir::Files | QDir::Hidden | QDir::System, QDirIterator::Subdirectories);
    QStringList names;
    while (files.hasNext()) {
        names.append(files.next());
    }
    names.sort();
    for (const auto& name : names) {
        QFile file(name);
        file.open(QIODevice::ReadOnly);
        const QFileInfo info(name);
        hash.addData(name.toUtf8());
        hash.addData(QByteArray::number(info.lastModified().toMSecsSinceEpoch()));
        hash.addData(file.readAll());
    }
    return hash.result();
}

QString deviceRevision(const QString& drive) {
    return QString("db:" + drive);
}

TreeItem* findDevice(RekordboxFeature& feature, const QString& drive) {
    for (int row = 0; row < feature.sidebar.root.childRows(); ++row) {
        if (feature.sidebar.root.child(row)->getData().toList().value(0).toString() == drive) {
            return feature.sidebar.root.child(row);
        }
    }
    return nullptr;
}

QModelIndex indexOf(RekordboxFeature& feature, TreeItem* item) {
    if (!item) {
        return {};
    }
    if (item->parent() == &feature.sidebar.root) {
        return feature.sidebar.index(item->parentRow(), 0);
    }
    return feature.sidebar.index(item->parentRow(), 0, indexOf(feature, item->parent()));
}

// Discovery: the drives in `drives` are mounted, every other is gone.
void discover(RekordboxFeature& feature, const QStringList& drives) {
    mixxx::rekordbox::observations.clear();
    feature.m_devicesFuture.found.clear();
    for (const auto& drive : drives) {
        mixxx::rekordbox::observations[drive] = {"mount:" + drive.toStdString(), "db:" + drive.toStdString()};
        feature.m_devicesFuture.found.append(new TreeItem(QFileInfo(drive).fileName(),
                QVariantList{drive, IS_RECORDBOX_DEVICE, deviceRevision(drive)}));
    }
    feature.onRekordboxDevicesFound();
    events();
}

// A tap on the drive (OPEN): the import, then the drive's whole list.
bool open(RekordboxFeature& feature, const QString& drive) {
    TreeItem* device = findDevice(feature, drive);
    if (!device) {
        return false;
    }
    feature.activateChild(indexOf(feature, device));
    const bool imported = until([&] { return !feature.m_trackImportActive; });
    events();
    return imported;
}

void show(RekordboxFeature& feature, TreeItem* item) {
    require(item != nullptr, "every list the fixture opens is in the menu");
    feature.activateChild(indexOf(feature, item));
    events();
}

TreeItem* childLabelled(TreeItem* parent, const QString& prefix) {
    // Depth first, into folders (Practice Lists › Sunny).
    for (int row = 0; parent && row < parent->childRows(); ++row) {
        if (parent->child(row)->getLabel().startsWith(prefix)) {
            return parent->child(row);
        }
        if (TreeItem* found = childLabelled(parent->child(row), prefix)) {
            return found;
        }
    }
    return nullptr;
}

QStringList titles(const QList<Row>& rows) {
    QStringList result;
    for (const auto& row : rows) {
        result.append(row.title);
    }
    return result;
}

// Every row of the list is the drive's: its title is the drive's, its
// location is a file on the drive (what LOAD loads).
bool onlyDrive(const QList<Row>& rows, const QString& drive, const QString& label) {
    if (rows.isEmpty()) {
        return false;
    }
    for (const auto& row : rows) {
        if (!row.title.startsWith(label + " ") || !row.location.startsWith(drive + "/Contents/") ||
                !QFileInfo(row.location).isFile()) {
            return false;
        }
    }
    return true;
}

void observe(const char* what, const QList<Row>& rows) {
    std::cout << "OBSERVE " << what << ": " << titles(rows).join(" | ").toStdString() << std::endl;
}

QStringList expected(const QString& label, std::initializer_list<int> numbers) {
    QStringList result;
    for (int number : numbers) {
        result.append(QStringLiteral("%1 %2").arg(label).arg(number));
    }
    return result;
}

int count(const QString& connection, const QString& table) {
    QSqlQuery query(QSqlDatabase::database(connection));
    return query.exec("SELECT count(*) FROM " + table) && query.next() ? query.value(0).toInt() : -1;
}

void createTables(const QString& name) {
    auto database = QSqlDatabase::database(name);
    createLibraryTable(database, kRekordboxLibraryTable);
    createPlaylistsTable(database, kRekordboxPlaylistsTable);
    createPlaylistTracksTable(database, kRekordboxPlaylistTracksTable);
}

#ifdef EXPORT_MODE
// Fault 2: one playlist of a real export.pdb, as Mixxx's import reads it.
int listExport(const QString& home, const QString& wanted) {
    const QString name = QStringLiteral("main");
    Library library(QString(home + "/library.sqlite"));
    auto database = QSqlDatabase::addDatabase("QSQLITE", name);
    database.setDatabaseName(*library.pool);
    database.open();
    createTables(name);
    RekordboxFeature feature(&library, name);
    const QString drive = home + "/media/IXIAN";
    discover(feature, {drive});
    const bool imported = open(feature, drive);
    std::cout << "IMPORTED " << imported << " tracks " << count(name, kRekordboxLibraryTable)
              << " playlists " << count(name, kRekordboxPlaylistsTable) << std::endl;
    QSqlQuery query(database);
    query.prepare("SELECT p.name, t.position, t.track_id, l.rb_id, l.title, l.location "
                  "FROM rekordbox_playlists p JOIN rekordbox_playlist_tracks t ON t.playlist_id = p.id "
                  "LEFT JOIN rekordbox_library l ON l.id = t.track_id "
                  "WHERE instr(p.name, :wanted) > 0 ORDER BY p.name, t.position");
    query.bindValue(":wanted", wanted);
    query.exec();
    int rows = 0;
    int missing = 0;
    while (query.next()) {
        ++rows;
        missing += query.value(3).isNull();
        std::cout << "ENTRY " << query.value(1).toInt() << " track_id " << query.value(2).toInt() << " rb_id "
                  << query.value(3).toString().toStdString() << " title "
                  << query.value(4).toString().toStdString() << " file "
                  << query.value(5).toString().mid(drive.size()).toStdString() << std::endl;
    }
    std::function<void(TreeItem*)> labels = [&](TreeItem* item) {
        for (int row = 0; row < item->childRows(); ++row) {
            if (item->child(row)->getLabel().contains(wanted)) {
                std::cout << "LABEL " << item->child(row)->getLabel().toStdString() << std::endl;
            }
            labels(item->child(row));
        }
    };
    labels(&feature.sidebar.root);
    std::cout << "COUNT " << rows << " without a track row " << missing << std::endl;
    return imported ? 0 : 1;
}
#endif

int main(int argc, char** argv) {
    QGuiApplication application(argc, argv);
    const QString home = QString::fromLocal8Bit(argv[1]);
#ifdef EXPORT_MODE
    return listExport(home, QString::fromLocal8Bit(argv[2]));
#else
    const QString gander = home + "/media/GANDER1";
    const QString ixian = home + "/media/IXIAN";
    const QString name = QStringLiteral("main");
    Library library(QString(home + "/library.sqlite"));
    {
        auto database = QSqlDatabase::addDatabase("QSQLITE", name);
        database.setDatabaseName(*library.pool);
        database.open();
        createTables(name);
    }
    const QByteArray ganderBefore = driveDigest(gander);
    const QByteArray ixianBefore = driveDigest(ixian);
    auto feature = std::make_unique<RekordboxFeature>(&library, name);
    RekordboxFeature& f = *feature;

    // 1. GANDER1 is the only drive: opened, its lists viewed.
    discover(f, {gander});
    require(open(f, gander) && f.playlist.playlist() == gander,
            "GANDER1's export is read and Tracks shows its whole list");
    observe("GANDER1 Tracks", f.playlist.rows());
    require(onlyDrive(f.playlist.rows(), gander, "Gander") &&
                    titles(f.playlist.rows()) == expected("Gander", {1, 2, 3, 4, 5}),
            "GANDER1's Tracks lists its 5 tracks, each with its file on GANDER1");
    show(f, childLabelled(findDevice(f, gander), "Warm-up"));
    require(titles(f.playlist.rows()) == expected("Gander", {1, 2, 3}) &&
                    onlyDrive(f.playlist.rows(), gander, "Gander"),
            "GANDER1's playlist Warm-up shows its 3 tracks");

    // 2. GANDER1 is ejected; no drive is left, so the tables are dropped and
    // made again (their ids start at 1 again).
    discover(f, {});
    require(f.sidebar.root.childRows() == 0 && count(name, kRekordboxLibraryTable) == 0,
            "with GANDER1 ejected and no drive left, its rows and lists are gone");
    observe("after the eject, the list in view", f.playlist.rows());
    require(f.m_trackSource->m_trackInfo.isEmpty(),
            "after the eject the track cache holds no row of GANDER1");
    require(f.playlist.rows().isEmpty(),
            "after the eject the list in view shows no row of GANDER1");

    // 3. IXIAN is plugged and opened: its ids reuse GANDER1's.
    discover(f, {ixian});
    require(open(f, ixian) && f.playlist.playlist() == ixian,
            "IXIAN's export is read and Tracks shows its whole list");
    observe("IXIAN Tracks", f.playlist.rows());
    require(titles(f.playlist.rows()) == expected("Ixian", {1, 2, 3, 4, 5, 6, 7}),
            "IXIAN's Tracks lists its 7 tracks, not GANDER1's songs");
    require(onlyDrive(f.playlist.rows(), ixian, "Ixian"),
            "each IXIAN row loads IXIAN's file, never a GANDER1 path");
    show(f, childLabelled(findDevice(f, ixian), "Sunny"));
    observe("IXIAN Sunny", f.playlist.rows());
    require(titles(f.playlist.rows()) == expected("Ixian", {2, 4, 6}) && onlyDrive(f.playlist.rows(), ixian, "Ixian"),
            "IXIAN's playlist Sunny shows its own 3 tracks and paths");
    TreeItem* tracksRow = findDevice(f, ixian) ? findDevice(f, ixian)->child(0) : nullptr;
    require(tracksRow && tracksRow->getLabel() == "Tracks", "IXIAN's first row is Tracks");
    show(f, tracksRow);
    require(f.playlist.playlist() == ixian && titles(f.playlist.rows()) == expected("Ixian", {1, 2, 3, 4, 5, 6, 7}) &&
                    onlyDrive(f.playlist.rows(), ixian, "Ixian"),
            "IXIAN's Tracks row lists only IXIAN's tracks and paths");

    // 4. A second drive: GANDER1 plugged again next to IXIAN, then IXIAN
    // pulled with GANDER1 left, then both pulled and IXIAN plugged alone.
    discover(f, {ixian, gander});
    require(open(f, gander), "GANDER1 plugged again next to IXIAN is read");
    require(titles(f.playlist.rows()) == expected("Gander", {1, 2, 3, 4, 5}) &&
                    onlyDrive(f.playlist.rows(), gander, "Gander"),
            "with two drives, GANDER1's Tracks shows only GANDER1's tracks");
    show(f, childLabelled(findDevice(f, ixian), "Sunny"));
    require(titles(f.playlist.rows()) == expected("Ixian", {2, 4, 6}) && onlyDrive(f.playlist.rows(), ixian, "Ixian"),
            "with two drives, IXIAN's Sunny shows only IXIAN's tracks");
    show(f, childLabelled(findDevice(f, gander), "Warm-up"));
    discover(f, {gander});
    require(findDevice(f, gander) && !findDevice(f, ixian),
            "IXIAN pulled: GANDER1 stays in the menu");
    require(titles(f.playlist.rows()) == expected("Gander", {1, 2, 3}) && onlyDrive(f.playlist.rows(), gander, "Gander"),
            "GANDER1's list in view keeps its rows when IXIAN is pulled");
    show(f, childLabelled(findDevice(f, gander), "Warm-up"));
    discover(f, {});
    discover(f, {ixian});
    require(open(f, ixian), "IXIAN plugged alone again is read");
    require(titles(f.playlist.rows()) == expected("Ixian", {1, 2, 3, 4, 5, 6, 7}) &&
                    onlyDrive(f.playlist.rows(), ixian, "Ixian"),
            "after both drives left, IXIAN's Tracks shows only IXIAN's tracks");
    show(f, childLabelled(findDevice(f, ixian), "Sunny"));
    require(titles(f.playlist.rows()) == expected("Ixian", {2, 4, 6}) && onlyDrive(f.playlist.rows(), ixian, "Ixian"),
            "after both drives left, IXIAN's Sunny shows only IXIAN's tracks");
    {
        bool cacheMatches = true;
        QSqlQuery query(QSqlDatabase::database(name));
        query.exec("SELECT id, title FROM rekordbox_library");
        int rows = 0;
        while (query.next()) {
            ++rows;
            cacheMatches = cacheMatches &&
                    f.m_trackSource->m_trackInfo.value(TrackId(query.value(0))).value(1).toString() ==
                            query.value(1).toString();
        }
        require(cacheMatches && rows == f.m_trackSource->m_trackInfo.size(),
                "after the re-plug the track cache holds exactly the tables' rows");
    }

    require(driveDigest(gander) == ganderBefore && driveDigest(ixian) == ixianBefore,
            "nothing on either drive was written (read only)");
    feature.reset();
    QSqlDatabase::database(name).close();
    QSqlDatabase::removeDatabase(name);
    std::cout << "OK " << failures << std::endl;
    return failures ? 1 : 0;
#endif
}
