+    OpenSource m_openSource;
+    std::function<void()> m_refreshSources;
+    QScopedPointer<ControlObject> m_available;
+    QScopedPointer<ControlPushButton> m_load;
+    QScopedPointer<ControlPushButton> m_eject;
+    QPointer<QDialog> m_dialog;
+    QPointer<MixpiControlledMedia> m_controlled;
+};
