#!/usr/bin/python3
"""Task-based touch launcher for the installed Sway desktop utilities."""
from pathlib import Path
import subprocess

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gio, GLib, Gtk
from mixpi_ui import button, label, message, shell, tile


class Settings(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.mixpi.Settings", flags=Gio.ApplicationFlags.FLAGS_NONE)
        self.window = None

    def do_activate(self):
        if self.window is None:
            GLib.set_prgname("mixpi-settings")
            self.window, body, footer = shell(self, "Settings", "UTILITY")
            body.pack_start(label("Choose what you want to set up.", "muted"), False, False, 0)
            grid = Gtk.Grid(column_spacing=10, row_spacing=8, column_homogeneous=True)
            body.pack_start(grid, False, False, 0)
            groups = [
                ("PLAYBACK", [
                    ("Speaker mode", "Spotify, phone & output", ["/usr/local/bin/mixpi-speaker"]),
                    ("Mixxx preferences", "DJ audio & controllers", ["/usr/local/bin/mixpi-audio-preferences"]),
                ]),
                ("CONNECTIONS", [
                    ("Wi-Fi", "Manage networks", ["nm-connection-editor"]),
                    ("Bluetooth devices", "Pair & manage devices", ["blueman-manager"]),
                    ("Display", "Screen & orientation", ["wdisplays"]),
                ]),
                ("FILES & SYSTEM", [
                    ("USB → Pi", "Copy music to this Pi", ["/usr/local/bin/mixpi-media"]),
                    ("Music on Pi", "Browse saved files", ["nautilus", str(Path.home() / "Music")]),
                    ("Terminal", "Advanced commands", ["foot"]),
                ]),
            ]
            for column, (heading, actions) in enumerate(groups):
                grid.attach(label(heading, "eyebrow"), column, 0, 1, 1)
                for row, (title, description, command) in enumerate(actions, 1):
                    item = tile(title, description, lambda _, cmd=command: self.launch(cmd))
                    grid.attach(item, column, row, 1, 1)
            footer.pack_start(button("Close settings", lambda _: self.window.hide()), False, False, 0)
            footer.pack_end(button("Back to Mixxx", lambda _: self.launch(["/usr/local/bin/mixpi-mixxx"]), True), False, False, 0)
            self.window.connect("delete-event", self.hide_window)
            self.window.show_all()
        self.window.present()

    def hide_window(self, window, _event):
        window.hide()
        return True

    def launch(self, command):
        try:
            subprocess.Popen(command)
            self.window.hide()
        except OSError as error:
            message(self.window, "Could not open this setting", str(error))


if __name__ == "__main__":
    raise SystemExit(Settings().run())
