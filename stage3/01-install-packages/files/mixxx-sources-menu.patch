+// A sidebar label "Name (12)" or "Name (12) 1:02:03" (Mixxx playlists and
+// crates): the name, and the count shown at the right of a menu row.
+inline QPair<QString, QString> sourceLabelCount(const QString& label) {
+    static const QRegularExpression counted(
+            QStringLiteral("^(.*\\S)\\s+\\((\\d+)\\)(\\s+[0-9:]+)?$"));
+    const auto match = counted.match(label);
+    return match.hasMatch() ? qMakePair(match.captured(1), match.captured(2))
+                            : qMakePair(label, QString());
+}
