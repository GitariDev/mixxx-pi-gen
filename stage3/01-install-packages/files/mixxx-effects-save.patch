+    // CoreServices has stopped the MixPi autosave (EffectsAutosave) before
+    // this quit-time save, so this is the last write.
+    const QByteArray contents = mixxx::effectsXml(*this);
+    if (contents.isEmpty()) {
+        return;
+    }
+    QDir settingsPath(m_pConfig->getSettingsPath());
+    if (!settingsPath.exists()) {
+        return;
+    }
+    // Atomic: a temporary file, synced, then renamed over effects.xml.
+    if (!mixxx::writeFileAtomically(
+                settingsPath.absoluteFilePath(kEffectsXmlFile), contents)) {
+        qWarning() << "EffectsManager: could not save effects.xml file";
+    }
