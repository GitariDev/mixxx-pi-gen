+QString BrowseFeature::releaseGoneFolder() {
+    // Spec 2e, as 2g applies it (owner: "Let just land on the top menu
+    // instead"): a drive whose folder Tracks shows through Folders
+    // (Removable Devices, a Quick Link or /) is ejected or pulled out, so
+    // its mount left the mount table. The table stops showing that folder's
+    // rows. Another drive's mount going, or a folder of the Pi (/ never
+    // goes): nothing changes. Only the mount table is read, nothing on a
+    // drive.
+    const QStringList points = mountPoints();
+    QString folder;
+    if (!m_shownMount.isEmpty() && m_shownMount != QDir::rootPath() &&
+            !points.isEmpty() && !points.contains(m_shownMount)) {
+        folder = m_shownFolder;
+        m_shownFolder.clear();
+        m_shownMount.clear();
+        m_browseModel.releasePath();
+    }
+#if defined(__LINUX__)
+    // Removable Devices drops a drive that is no longer mounted, as the
+    // Media page does (its rows were read when it was opened).
+    auto* root = m_pSidebarModel->getRootItem();
+    for (int row = 0; !points.isEmpty() && row < root->childRows(); ++row) {
+        const TreeItem* pDevices = root->child(row);
+        if (pDevices->getData().toString() != DEVICE_NODE) {
+            continue;
+        }
+        const QModelIndex devices = m_pSidebarModel->index(row, 0);
+        for (int device = pDevices->childRows() - 1; device >= 0; --device) {
+            if (!points.contains(QDir::cleanPath(pDevices->child(device)->getData().toString()))) {
+                m_pSidebarModel->removeRows(device, 1, devices);
+            }
+        }
+    }
+#endif
+    return folder;
+}
