+bool SidebarModel::moveLibraryFeature(
+        int from, int to, const std::function<void()>& coordinated) {
+    if (from < 0 || to < 0 || from >= m_sFeatures.size() ||
+            to >= m_sFeatures.size() || from == to || !coordinated) {
+        return false;
+    }
+    auto* defaultFeature = m_iDefaultSelectedIndex < static_cast<unsigned>(m_sFeatures.size())
+            ? m_sFeatures.at(m_iDefaultSelectedIndex) : nullptr;
+    if (!beginMoveRows({}, from, from, {}, to > from ? to + 1 : to)) {
+        return false;
+    }
+    m_sFeatures.move(from, to);
+    coordinated();
+    if (defaultFeature) {
+        m_iDefaultSelectedIndex = m_sFeatures.indexOf(defaultFeature);
+    }
+    endMoveRows();
+    return true;
 }
 
