+// Build G3: the width saved for the column drawn stretched to fill the row,
+// instead of its drawn one.
+int setWidth(const QHeaderView* header,
+        int column,
+        const QString& name,
+        const QList<MixpiSharedColumns::Column>& stored) {
+    // Its width in the shared setup: what it was set to, by a restore, by a
+    // drag where it does not stretch (TITLE in a folder), or as shown again.
+    // A drag of its own edge where it stretches sets nothing: the stretch
+    // gives it the rest of the row again at the next layout. 0 or the
+    // minimum (20) means it was never shown: the table's default width.
+    for (const auto& entry : stored) {
+        if (entry.name == name) {
+            if (entry.size > WTTVH_MINIMUM_SECTION_SIZE) {
+                return entry.size;
+            }
+            break;
+        }
+    }
+    const int width = header->model()
+                              ->headerData(column, header->orientation(), TrackModel::kHeaderWidthRole)
+                              .toInt();
+    return width > 0 ? width : LibraryInterface::kStretchColumnMinimumWidth;
+}
