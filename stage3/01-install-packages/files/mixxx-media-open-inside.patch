+void WLibrarySidebar::openShownSource() {
+    // followShownSource makes the drive the menu's source and its rows the
+    // place, but kept the menu's level: m_menuInside, which picks the top
+    // level or the rows when ☰ opens, was only set by a tap on a source row.
+    // After an eject (the top level, spec 2e) or with the menu left at the
+    // top level, ☰ showed the top level with the edge on the drive (acceptance
+    // I, 3f). Now the place is inside the drive, so ☰ opens there; the
+    // feature then makes the drive's Tracks row current (the edge).
+    followShownSource();
+    if (!m_sourceScreen || !groupedTiles || !m_touchNavigation || m_sourcesEditing) {
+        return;
+    }
+    const auto* pTile = selectedTile();
+    if (!pTile || !pTile->id.startsWith(QStringLiteral("drive:")) || !pTile->node.isValid()) {
+        return;
+    }
+    // Only once the drive's rows show (its row or below it is the place).
+    for (QModelIndex step = rootIndex(); step.isValid(); step = step.parent()) {
+        if (step == pTile->node) {
+            m_menuInside = true;
+            updateSourceChrome();
+            return;
+        }
+    }
+}
