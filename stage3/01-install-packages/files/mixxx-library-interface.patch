+// Only the current library view owns the Actions control. Resolve again on each
+// request because nested views can recreate their table without changing pages.
+void WLibrary::updateTrackMenuView() {
+    auto* table = getCurrentTrackTableView();
+    if (m_pTrackMenuView == table) {
+        return;
+    }
+    if (m_pTrackMenuView && m_pTrackMenuView->model()) {
+        m_pTrackMenuView->slotShowHideTrackMenu(false);
+    }
+    disconnect(m_trackMenuVisibilityConnection);
+    disconnect(m_trackMenuDestroyedConnection);
+    m_pTrackMenuView = table;
+    if (table) {
+        m_trackMenuVisibilityConnection = connect(table,
+                &WTrackTableView::trackMenuVisible,
+                this, &WLibrary::trackMenuVisible);
+        m_trackMenuDestroyedConnection = connect(table, &QObject::destroyed,
+                this, [this] { emit trackMenuVisible(false); });
+    }
+    emit trackMenuVisible(false);
+}
+
+void WLibrary::slotShowHideTrackMenu(bool show) {
+    updateTrackMenuView();
+    if (m_pTrackMenuView && m_pTrackMenuView->model()) {
+        m_pTrackMenuView->slotShowHideTrackMenu(show);
+    } else {
+        emit trackMenuVisible(false);
+    }
+}
