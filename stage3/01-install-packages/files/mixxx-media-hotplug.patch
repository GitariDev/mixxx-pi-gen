diff --git a/src/library/rekordbox/removablemounts.h b/src/library/rekordbox/removablemounts.h
new file mode 100644
index 0000000..928b422
--- /dev/null
+++ b/src/library/rekordbox/removablemounts.h
@@ -0,0 +1,62 @@
+#pragma once
+
+#include <istream>
+#include <map>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace mixxx::rekordbox {
+
+// Linux mountinfo escapes whitespace and backslashes in path fields. Decode
+// exactly once so a literal "\\040" in a volume label is not decoded twice.
+inline std::string decodeMountPath(const std::string& encoded) {
+    std::string decoded;
+    for (std::size_t i = 0; i < encoded.size(); ++i) {
+        if (encoded[i] == '\\' && i + 3 < encoded.size()) {
+            const auto escape = encoded.substr(i + 1, 3);
+            if (escape == "040" || escape == "011" ||
+                    escape == "012" || escape == "134") {
+                decoded += static_cast<char>(std::stoi(escape, nullptr, 8));
+                i += 3;
+                continue;
+            }
+        }
+        decoded += encoded[i];
+    }
+    return decoded;
+}
+
+// Include mount identity as well as mount path: a different drive may reuse the
+// same label/path between polls. Reading mountinfo does not touch audio files.
+using RemovableMounts = std::map<std::string, std::string>;
+
+inline RemovableMounts readRemovableMounts(std::istream& mountInfo) {
+    RemovableMounts result;
+    std::string line;
+    while (std::getline(mountInfo, line)) {
+        std::istringstream fields(line);
+        std::string id, parent, device, root, path;
+        if (!(fields >> id >> parent >> device >> root >> path)) {
+            continue;
+        }
+        path = decodeMountPath(path);
+        if (path.rfind("/media/", 0) == 0 ||
+                path.rfind("/run/media/", 0) == 0) {
+            result[path] = id + ":" + device + ":" + root;
+        }
+    }
+    return result;
+}
+
+// Local SD backups and atomically published export copies use ordinary
+// directories under the same discovery roots. Retain them alongside mounts.
+inline RemovableMounts addExportDirectories(
+        RemovableMounts mounts, const std::vector<std::string>& directories) {
+    for (const auto& path : directories) {
+        mounts.emplace(path, "directory:" + path);
+    }
+    return mounts;
+}
+
+} // namespace mixxx::rekordbox
