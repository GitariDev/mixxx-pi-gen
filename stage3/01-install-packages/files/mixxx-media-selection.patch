+        return tr("Selected volume is no longer readable.");
+    }
+    auto* root = m_pSidebarModel->getRootItem();
+    QModelIndex index;
+    for (int row = 0; row < root->childRows(); ++row) {
+        if (root->child(row)->getData().toString() == path) {
+            index = m_pSidebarModel->index(row, 0);
+            break;
+        }
+    }
+    if (!index.isValid()) {
+        std::vector<std::unique_ptr<TreeItem>> items;
+        items.push_back(std::make_unique<TreeItem>(path, QVariant(path)));
+        const int row = root->childRows();
+        m_pSidebarModel->insertTreeItemRows(std::move(items), row);
+        index = m_pSidebarModel->index(row, 0);
+    }
+    emit featureSelect(this, index);
+    onLazyChildExpandation(index);
+    activateChild(index);
+    return {};
