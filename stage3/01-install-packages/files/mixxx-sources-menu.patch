+                                   "<circle cx=\"18\" cy=\"12\" r=\"1.3\"/>")},
+            {QStringLiteral("list"), QStringLiteral("<path d=\"M9 7h11M9 12h11M9 17h11M4 7h1M4 12h1M4 17h1\"/>")},
+            {QStringLiteral("back"), QStringLiteral("<path d=\"M15 5l-7 7 7 7\"/>")},
