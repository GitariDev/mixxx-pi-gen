diff --git a/src/library/sourceorder.h b/src/library/sourceorder.h
new file mode 100644
--- /dev/null
+++ b/src/library/sourceorder.h
@@ -0,0 +1,58 @@
+#pragma once
+
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QStringList>
+
+namespace SourceOrder {
+
+inline QStringList decode(const QString& serialized) {
+    QStringList identities;
+    const auto document = QJsonDocument::fromJson(serialized.toUtf8());
+    for (const auto& value : document.array()) {
+        if (value.isString() && !value.toString().isEmpty() &&
+                !identities.contains(value.toString())) {
+            identities.append(value.toString());
+        }
+    }
+    return identities;
+}
+
+inline QStringList reconcile(QStringList preferred, const QStringList& available) {
+    QStringList result;
+    for (const auto& identity : preferred + available) {
+        if (!identity.isEmpty() && !result.contains(identity)) {
+            result.append(identity);
+        }
+    }
+    return result;
+}
+
+inline QString encode(const QStringList& identities) {
+    return QString::fromUtf8(QJsonDocument(QJsonArray::fromStringList(
+            reconcile({}, identities))).toJson(QJsonDocument::Compact));
+}
+
+inline QStringList present(const QStringList& preferred, const QStringList& available) {
+    QStringList result;
+    for (const auto& identity : reconcile(preferred, available)) {
+        if (available.contains(identity)) {
+            result.append(identity);
+        }
+    }
+    return result;
+}
+
+inline QStringList mergePresent(QStringList preferred, const QStringList& identities) {
+    const auto reordered = reconcile({}, identities);
+    preferred = reconcile(preferred, reordered);
+    int position = 0;
+    for (auto& identity : preferred) {
+        if (reordered.contains(identity)) {
+            identity = reordered.at(position++);
+        }
+    }
+    return preferred;
+}
+
+} // namespace SourceOrder
diff --git a/src/widget/libraryinterface.h b/src/widget/libraryinterface.h
new file mode 100644
--- /dev/null
+++ b/src/widget/libraryinterface.h
@@ -0,0 +1,260 @@
+#pragma once
+
+#include <functional>
+
+#include <QCheckBox>
+#include <QDialog>
+#include <QDialogButtonBox>
+#include <QHeaderView>
+#include <QHBoxLayout>
+#include <QListWidget>
+#include <QKeyEvent>
+#include <QLabel>
+#include <QMenu>
+#include <QMap>
+#include <QPushButton>
+#include <QTreeView>
+#include <QVBoxLayout>
+#include <QWidgetAction>
+
+namespace LibraryInterface {
+
+class VisibilityMenu final : public QMenu {
+  public:
+    using QMenu::QMenu;
+
+  protected:
+    void keyPressEvent(QKeyEvent* event) override {
+        if (event->key() == Qt::Key_Return || event->key() == Qt::Key_Enter ||
+                event->key() == Qt::Key_Space) {
+            auto* action = qobject_cast<QWidgetAction*>(activeAction());
+            auto* choice = action ? qobject_cast<QCheckBox*>(action->defaultWidget()) : nullptr;
+            if (choice) {
+                if (choice->isEnabled()) {
+                    choice->toggle();
+                }
+                event->accept();
+                return;
+            }
+        }
+        QMenu::keyPressEvent(event);
+    }
+};
+
+inline int preferredSourceRow(const QString& identity,
+        const QStringList& identities, const QList<bool>& visible) {
+    const int row = identities.indexOf(identity);
+    return !identity.isEmpty() && row >= 0 && row < visible.size() && visible[row] ? row : -1;
+}
+
+inline QCheckBox* addVisibilityChoice(QMenu* menu, const QString& title,
+        bool checked, std::function<void(bool)> changed) {
+    auto* action = new QWidgetAction(menu);
+    auto* checkbox = new QCheckBox(title, menu);
+    checkbox->setChecked(checked);
+    action->setDefaultWidget(checkbox);
+    menu->addAction(action);
+    QObject::connect(checkbox, &QCheckBox::toggled, menu, std::move(changed));
+    QObject::connect(action, &QAction::triggered, checkbox, [checkbox] {
+        if (checkbox->isEnabled()) {
+            checkbox->toggle();
+        }
+    });
+    return checkbox;
+}
+
+inline QListWidget* addSourceOrder(QMenu* menu, const QStringList& identities,
+        const QStringList& titles, std::function<void(const QStringList&)> changed) {
+    auto* action = new QWidgetAction(menu);
+    auto* container = new QWidget(menu);
+    auto* layout = new QVBoxLayout(container);
+    layout->addWidget(new QLabel(QObject::tr("Source order: drag to reorder"), container));
+    auto* list = new QListWidget(container);
+    list->setObjectName(QStringLiteral("MixpiSourceOrder"));
+    list->setAccessibleName(QObject::tr("Source order; drag or use Up and Down"));
+    list->setDragDropMode(QAbstractItemView::InternalMove);
+    list->setDefaultDropAction(Qt::MoveAction);
+    list->setMaximumHeight(140);
+    for (int position = 0; position < identities.size(); ++position) {
+        auto* item = new QListWidgetItem(titles.value(position), list);
+        item->setData(Qt::UserRole, identities.at(position));
+        item->setFlags(item->flags() & ~Qt::ItemIsDropEnabled);
+    }
+    layout->addWidget(list);
+    auto publish = [list, changed] {
+        QStringList order;
+        for (int row = 0; row < list->count(); ++row) {
+            order.append(list->item(row)->data(Qt::UserRole).toString());
+        }
+        changed(order);
+    };
+    QObject::connect(list->model(), &QAbstractItemModel::rowsMoved, list, publish);
+    auto* buttons = new QHBoxLayout;
+    for (int direction : {-1, 1}) {
+        auto* button = new QPushButton(direction < 0 ? QObject::tr("Up") : QObject::tr("Down"), container);
+        buttons->addWidget(button);
+        QObject::connect(button, &QPushButton::clicked, list, [list, direction, publish] {
+            const int from = list->currentRow();
+            const int to = from + direction;
+            if (from < 0 || to < 0 || to >= list->count()) {
+                return;
+            }
+            list->insertItem(to, list->takeItem(from));
+            list->setCurrentRow(to);
+            publish();
+        });
+    }
+    layout->addLayout(buttons);
+    action->setDefaultWidget(container);
+    menu->addAction(action);
+    return list;
+}
+
+inline void protectLastVisible(const QList<QCheckBox*>& choices) {
+    int visible = 0;
+    for (auto* choice : choices) {
+        visible += choice->isChecked() ? 1 : 0;
+    }
+    for (auto* choice : choices) {
+        choice->setEnabled(!choice->isChecked() || visible > 1);
+    }
+}
+
+inline bool hasHiddenContext(QTreeView* view) {
+    auto hidden = [view](QModelIndex index) {
+        if (!index.isValid()) {
+            return false;
+        }
+        while (index.parent().isValid()) {
+            index = index.parent();
+        }
+        return view->isRowHidden(index.row(), QModelIndex());
+    };
+    if (hidden(view->rootIndex()) || hidden(view->currentIndex())) {
+        return true;
+    }
+    if (view->selectionModel()) {
+        for (const auto& index : view->selectionModel()->selectedIndexes()) {
+            if (hidden(index)) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
+inline void initialColumns(QHeaderView* header, const QList<int>& preferred,
+        const QList<int>& available) {
+    if (preferred.isEmpty()) {
+        return;
+    }
+    int position = 0;
+    for (int column : preferred) {
+        if (column >= 0 && available.contains(column)) {
+            header->moveSection(header->visualIndex(column), position++);
+        }
+    }
+    for (int column : available) {
+        header->setSectionHidden(column, !preferred.contains(column));
+    }
+}
+
+inline void rememberColumnWidths(QHeaderView* header, QMap<int, int>* widths) {
+    QObject::connect(header, &QHeaderView::sectionResized, header,
+            [widths](int column, int, int width) {
+                if (width > 0) {
+                    widths->insert(column, width);
+                }
+            });
+}
+
+inline QDialog* arrangeColumns(QHeaderView* header, const QList<int>& available,
+        std::function<void()> save) {
+    if (auto* existing = header->findChild<QDialog*>(
+                QStringLiteral("MixpiColumnArrangement"), Qt::FindDirectChildrenOnly);
+            existing && existing->isVisible()) {
+        existing->raise();
+        existing->activateWindow();
+        return existing;
+    }
+    auto* dialog = new QDialog(header);
+    dialog->setObjectName(QStringLiteral("MixpiColumnArrangement"));
+    dialog->setWindowModality(Qt::WindowModal);
+    dialog->setAttribute(Qt::WA_DeleteOnClose);
+    dialog->setWindowTitle(QObject::tr("Arrange columns"));
+    auto* layout = new QVBoxLayout(dialog);
+    auto* list = new QListWidget(dialog);
+    list->setDragDropMode(QAbstractItemView::InternalMove);
+    for (int position = 0; position < header->count(); ++position) {
+        const int column = header->logicalIndex(position);
+        if (!available.contains(column)) {
+            continue;
+        }
+        auto* item = new QListWidgetItem(
+                header->model()->headerData(column, Qt::Horizontal).toString(), list);
+        item->setData(Qt::UserRole, column);
+        item->setFlags(item->flags() | Qt::ItemIsUserCheckable);
+        item->setCheckState(header->isSectionHidden(column) ? Qt::Unchecked : Qt::Checked);
+    }
+    layout->addWidget(list);
+    auto apply = [header, list, save] {
+        int visible = 0;
+        for (int row = 0; row < list->count(); ++row) {
+            visible += list->item(row)->checkState() == Qt::Checked ? 1 : 0;
+        }
+        if (!visible && list->count()) {
+            list->currentItem() ? list->currentItem()->setCheckState(Qt::Checked)
+                                : list->item(0)->setCheckState(Qt::Checked);
+            return;
+        }
+        for (int row = 0; row < list->count(); ++row) {
+            auto* item = list->item(row);
+            const int column = item->data(Qt::UserRole).toInt();
+            header->moveSection(header->visualIndex(column), row);
+            header->setSectionHidden(column, item->checkState() != Qt::Checked);
+        }
+        save();
+    };
+    QObject::connect(list, &QListWidget::itemChanged, dialog, apply);
+    QObject::connect(list->model(), &QAbstractItemModel::rowsMoved, dialog, apply);
+    auto* movement = new QHBoxLayout;
+    for (int direction : {-1, 1}) {
+        auto* button = new QPushButton(direction < 0 ? QObject::tr("Up") : QObject::tr("Down"), dialog);
+        movement->addWidget(button);
+        QObject::connect(button, &QPushButton::clicked, dialog, [list, direction, apply] {
+            const int row = list->currentRow();
+            const int destination = row + direction;
+            if (row >= 0 && destination >= 0 && destination < list->count()) {
+                auto* item = list->takeItem(row);
+                list->insertItem(destination, item);
+                list->setCurrentItem(item);
+                apply();
+            }
+        });
+    }
+    layout->addLayout(movement);
+    auto* buttons = new QDialogButtonBox(QDialogButtonBox::Close, dialog);
+    QObject::connect(buttons, &QDialogButtonBox::rejected, dialog, &QDialog::close);
+    layout->addWidget(buttons);
+    dialog->resize(360, 360);
+    dialog->show();
+    return dialog;
+}
+
+inline QMenu* actionsMenu(QWidget* parent, QMenu* decks, QMenu* original,
+        std::function<void()> arrange) {
+    auto* menu = new QMenu(parent);
+    menu->setAttribute(Qt::WA_DeleteOnClose);
+    auto* load = menu->addMenu(QObject::tr("Load"));
+    load->setEnabled(decks && decks->isEnabled());
+    if (decks) {
+        load->addActions(decks->actions());
+    }
+    QObject::connect(menu->addAction(QObject::tr("Arrange columns")),
+            &QAction::triggered, menu, std::move(arrange));
+    menu->addSeparator();
+    menu->addMenu(original)->setText(QObject::tr("Original full menu"));
+    return menu;
+}
+
+}
