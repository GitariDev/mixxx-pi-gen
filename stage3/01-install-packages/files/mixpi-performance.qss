/* Agreed UI tokens (AGREED-UI-SPEC section 1, agreed-ui/design/tokens.css):
 * bg #0d1014, surface #161a20, surface-2 #1d222a, surface-3 #262c35,
 * surface-off #13161b, line #2c333d, line-strong #3a424e, text #e4e7ec,
 * dim #949dab, off #7f8896, ink #0d1014, accent #a3c45e (pressed #8fad50,
 * lit text #bcd88a), slider fill #5d7238, deck 1 #5b95d4, deck 2 #d6784a,
 * play #5fae6e, cue #cbb551, info #5aa4c4, caution #dfa33a, danger #d0574d.
 * Radius 3 (thumbs 2); chips are pills. Lit or chosen: the role colour at
 * 26% (alpha 66 of 255) over what is behind, a 2 px role border and the
 * light role text. Sound borders at rest are the tone at 60% over surface-2.
 * Fonts are build B's (owner, 2026-11-18: "All fonts back to build B"): each
 * element has the family, size and weight build B gave it (ef0874d). Where
 * build B set no family, Pioneered's own `*` rule gave it Open Sans, so
 * those rules name "Open Sans" here. A new element
 * takes the build B font of its role. No text under 13 px. */
#MixpiTopbar, #MixpiTransport, #MixpiDeckButtons, #MixpiBottom, #MixpiSourcesBottom { background: #0d1014; }
#MixpiTopbar { border-bottom: 1px solid #2c333d; }

/* Navigate (neutral) at rest; every button family starts here. */
#MixpiButton, #MixpiPlay, #MixpiRecord, #MixpiDesktopBar, #MixpiPrimary,
#MixpiDeck1, #MixpiDeck2, #MixpiCue, #MixpiLoad1, #MixpiLoad2,
#MixpiSegFirst, #MixpiSegMid, #MixpiSegLast, #MixpiSize, #MixpiSound,
#MixpiDanger, #MixpiCaution,
#MixpiRailButton, #MixpiCueTile1, #MixpiCueTile2, #MixpiCueClearTile {
    color: #e4e7ec; background: #1d222a; border: 1px solid #3a424e;
    border-radius: 3px; margin: 2px; font-family: "Ubuntu Condensed", "Ubuntu";
    font-size: 16px; font-weight: bold;
}
#MixpiButton[pressed="true"], #MixpiSegFirst[pressed="true"], #MixpiSegMid[pressed="true"],
#MixpiSegLast[pressed="true"], #MixpiSize[pressed="true"] { background: #262c35; }
/* Choose: the chosen size, page or mode is a see-through accent tint. */
#MixpiButton[value="1"], #MixpiSegFirst[value="1"], #MixpiSegMid[value="1"], #MixpiSegLast[value="1"] {
    color: #bcd88a; background: rgba(163, 196, 94, 66); border: 2px solid #a3c45e;
}
#MixpiButton:disabled, #MixpiSize:disabled, #MixpiSound:disabled, #MixpiDanger:disabled,
#MixpiCaution:disabled, #MixpiDeck1:disabled, #MixpiDeck2:disabled, #MixpiCue:disabled,
#MixpiPlay:disabled {
    color: #7f8896; background: #13161b; border: 1px dashed #2c333d;
}

/* Segments (LOOP / JUMP / CUES, FX 1 / FX 2, routes): one joined control. */
#MixpiSegFirst, #MixpiSegMid, #MixpiSegLast { margin: 2px 0px; }
#MixpiSegFirst { border-top-right-radius: 0px; border-bottom-right-radius: 0px; }
#MixpiSegMid { border-radius: 0px; border-left: 0px; }
#MixpiSegLast { border-top-left-radius: 0px; border-bottom-left-radius: 0px; border-left: 0px; }

/* ½ and ×2: neutral with the accent at 60% over surface-2 as the border. */
#MixpiSize { border-color: #6d8349; }

/* Sound (info tone): LOOP, RELOOP, effect ON/OFF. */
#MixpiSound { color: #86c0d8; border-color: #427086; }
#MixpiSound[pressed="true"] { background: #13272f; border-color: #5aa4c4; }
#MixpiSound[value="1"] { color: #a3d2e6; background: rgba(90, 164, 196, 66); border: 2px solid #5aa4c4; }

/* Danger: EXIT LOOP, CLEAR. Solid red only while pressed. */
#MixpiDanger { color: #ec7f74; background: #34191b; border-color: #d0574d; }
#MixpiDanger[value="1"] { color: #f4a59d; background: rgba(208, 87, 77, 66); border: 2px solid #d0574d; }
#MixpiDanger[pressed="true"] { color: #0d1014; background: #d0574d; border-color: #d0574d; }

/* Caution: pad ■ STOP. Solid amber only while pressed. */
#MixpiCaution { color: #e8b65c; background: #30260e; border-color: #dfa33a; }
#MixpiCaution[pressed="true"] { color: #0d1014; background: #dfa33a; border-color: #dfa33a; }

/* Play and cue (Sound tones). Lit is a tint, never a solid fill. */
#MixpiPlay { color: #7cc58a; border-color: #457653; font-size: 20px; }
#MixpiPlay[pressed="true"] { background: #172a1d; border-color: #5fae6e; }
#MixpiPlay[value="1"] { color: #9bd6a6; background: rgba(95, 174, 110, 66); border: 2px solid #5fae6e; }
#MixpiCue { color: #d9c56a; border-color: #857a41; }
#MixpiCue[pressed="true"] { background: #2c2912; border-color: #cbb551; }
#MixpiCue[value="1"] { color: #e3d58a; background: rgba(203, 181, 81, 66); border: 2px solid #cbb551; }

/* REC (spec silent on its states: build B's amber WAIT and red recording,
 * as lit tints of caution and danger). */
#MixpiRecord { margin: 4px 0px; }
#MixpiRecord[value="1"] { color: #f0c983; background: rgba(223, 163, 58, 66); border: 2px solid #dfa33a; }
#MixpiRecord[value="2"], #MixpiRecord[value="3"] {
    color: #f4a59d; background: rgba(208, 87, 77, 66); border: 2px solid #d0574d;
}

/* Tabs: plain words; the current tab has a 3 px accent underline. */
#MixpiTab {
    color: #949dab; background: #0d1014; border: 0px; border-bottom: 3px solid #0d1014;
    margin: 0px; font-family: "Ubuntu Condensed", "Ubuntu"; font-size: 18px; font-weight: bold;
}
#MixpiTab[pressed="true"] { color: #e4e7ec; background: #161a20; }
#MixpiTab[value="1"] { color: #e4e7ec; border-bottom: 3px solid #a3c45e; }
/* USB chip (R-4): the group draws the chip; its look follows [MixPi],media_state
 * through the highlight property; the transparent button on top takes the taps. */
#MixpiUsbBody {
    background: #1d222a; border: 1px solid #2c333d; border-radius: 3px; margin: 2px 0px;
}
#MixpiUsbBody[highlight="2"] { border-color: #5aa4c4; }
#MixpiUsbBody[highlight="3"] { border-color: #dfa33a; }
#MixpiUsbBody[highlight="4"] { border-color: #5fae6e; }
#MixpiUsbButton { background: transparent; border: 0px; margin: 0px; }
#MixpiUsbButton[pressed="true"] { background: rgba(163, 196, 94, 40); }
/* Lit while the Media page is open (spec s13, m-media.png), as the gear is on
 * Settings: the accent tint over the chip and a 2 px accent border, on the
 * chip's own box (2 px in from the bar's top and bottom). */
#MixpiUsbButton[value="1"] {
    background: rgba(163, 196, 94, 66); border: 2px solid #a3c45e; border-radius: 3px; margin: 2px 0px;
}
#MixpiUsbName { color: #e4e7ec; font-family: "Ubuntu Condensed", "Ubuntu"; font-size: 15px; font-weight: bold; }
#MixpiUsbState0, #MixpiUsbState1, #MixpiUsbState2, #MixpiUsbState3, #MixpiUsbState4 {
    font-family: "Ubuntu Condensed", "Ubuntu"; font-size: 13px; font-weight: bold;
}
#MixpiUsbState0 { color: #949dab; }
#MixpiUsbState1 { color: #7cc58a; }
#MixpiUsbState2 { color: #86c0d8; }
#MixpiUsbState3 { color: #e8b65c; }
#MixpiUsbState4 { color: #9bd6a6; }
/* The scan % is a chip: a pill that cannot be pressed (info tone). */
#MixpiUsbScan {
    color: #86c0d8; background: #1d222a; border: 1px solid #5aa4c4; border-radius: 9px;
    padding: 0px 6px; font-family: "Ubuntu Condensed", "Ubuntu"; font-size: 13px; font-weight: bold;
}

/* Deck tones (Q, SYNC, KEY): neutral at rest, the deck tint when on. */
#MixpiDeck1[value="1"], #MixpiCueTile1[value="1"] {
    color: #b3d1f2; background: rgba(91, 149, 212, 66); border: 2px solid #5b95d4;
}
#MixpiDeck2[value="1"], #MixpiCueTile2[value="1"] {
    color: #f2c2a6; background: rgba(214, 120, 74, 66); border: 2px solid #d6784a;
}
#MixpiLoad1 { color: #9cc2ec; border-color: #426790; }
#MixpiLoad2 { color: #ebb08e; border-color: #8c563d; }
#MixpiLoad1[pressed="true"] { background: #172536; border-color: #5b95d4; }
#MixpiLoad2[pressed="true"] { background: #35201a; border-color: #d6784a; }
#MixpiLoad1:disabled, #MixpiLoad2:disabled, #MixpiCueClearTile:disabled {
    color: #7f8896; background: #13161b; border: 1px dashed #2c333d;
}
#MixpiCueTile1, #MixpiCueTile2 { border-style: dashed; color: #949dab; }
#MixpiCueTile1[value="1"], #MixpiCueTile2[value="1"] { border-style: solid; }
#MixpiCueClearTile { color: #ec7f74; background: #34191b; border-color: #d0574d; }
#MixpiLoadTitle { color: #e4e7ec; font-family: "Open Sans", "Ubuntu"; font-size: 13px; padding-left: 6px; }

/* Chips: indicators, never pressed, so pills. */
#MixpiChip, #MixpiChipPi, #MixpiChipUsb, #MixpiChipSync1, #MixpiChipSync2 {
    font-family: "Ubuntu", "Open Sans"; font-size: 13px; font-weight: bold;
    border: 1px solid #a3c45e; border-radius: 10px; color: #a3c45e; margin: 1px 2px;
}
#MixpiChipPi { color: #0d1014; background: #5fae6e; border-color: #5fae6e; }
#MixpiChipUsb { color: #949dab; border-color: #3a424e; }
#MixpiChipSync1, #MixpiChipSync2 { color: #86c0d8; border-color: #5aa4c4; }
#MixpiRange { color: #949dab; font-family: "Open Sans", "Ubuntu"; font-size: 13px; font-weight: bold; }
#MixpiStateChip {
    color: #949dab; background: transparent; border: 1px solid #3a424e; border-radius: 10px;
    font-family: "Ubuntu", "Open Sans"; font-size: 13px; font-weight: bold;
}
#MixpiStateChip[value="1"] { color: #a3c45e; border-color: #a3c45e; }
#MixpiWaveBadge1, #MixpiWaveBadge2 {
    color: #0d1014; font-family: "Ubuntu Condensed", "Ubuntu"; font-size: 20px; font-weight: bold;
    border-radius: 2px;
}
#MixpiWaveBadge1 { background: #5b95d4; }
#MixpiWaveBadge2 { background: #d6784a; }
#MixpiCaption {
    color: #949dab; font-family: "Ubuntu", "Open Sans"; font-size: 13px; font-weight: bold;
}
#MixpiToolTitle { color: #e4e7ec; font-family: "Ubuntu Condensed", "Ubuntu"; font-size: 18px; font-weight: bold; padding-left: 10px; }
#MixpiToolHeader { background: #161a20; border-bottom: 1px solid #2c333d; }
#MixpiFxPad { color: #949dab; font-family: "Open Sans", "Ubuntu"; font-size: 13px; }
#MixpiFxSwitch, #MixpiSettingsHeader { background: #161a20; border-bottom: 1px solid #2c333d; }

/* Settings rail: menu rows, the text left-aligned 16 px in (m-settings-media.png).
 * The label under a clear button carries the text; the current row is
 * surface-2 with a 4 px accent edge. The text is build B's rail button font
 * (Ubuntu Condensed 18 px bold) on every row. */
#MixpiSettingsRail { background: #161a20; border-right: 1px solid #2c333d; }
#MixpiRailButton { background: transparent; border: 0px; border-radius: 0px; margin: 0px; }
#MixpiRailButton[pressed="true"] { background: rgba(163, 196, 94, 40); }
#MixpiRailLabel {
    color: #e4e7ec; background: #161a20; border: 0px; border-bottom: 1px solid #2c333d;
    padding-left: 16px; font-family: "Ubuntu Condensed", "Ubuntu"; font-size: 18px; font-weight: bold;
}
#MixpiRailLabel[highlight="1"] {
    background: #1d222a; border-left: 4px solid #a3c45e; padding-left: 12px;
}
#MixpiSettingTitle { color: #e4e7ec; font-family: "Open Sans", "Ubuntu"; font-size: 16px; font-weight: bold; }
/* The ON/OFF toggle (primitives.css .mx-toggle), here only an indicator:
 * OFF is surface-2 with a dim knob at the left and OFF at the right; ON is
 * accent-surface with an accent border, ON at the left and the accent knob. */
#MixpiToggleOn, #MixpiToggleOff { border-radius: 3px; margin: 1px 0px; }
#MixpiToggleOff { background: #1d222a; border: 1px solid #3a424e; }
#MixpiToggleOn { background: #253019; border: 1px solid #a3c45e; }
#MixpiToggleWord { font-family: "Open Sans", "Ubuntu"; font-size: 14px; font-weight: bold; }
#MixpiToggleOff #MixpiToggleWord { color: #949dab; }
#MixpiToggleOn #MixpiToggleWord { color: #a3c45e; }
#MixpiToggleKnob { border-radius: 2px; }
#MixpiToggleOff #MixpiToggleKnob { background: #949dab; }
#MixpiToggleOn #MixpiToggleKnob { background: #a3c45e; }
/* The note under "Plugging in a drive": dim text, surface, a 2 px accent edge. */
#MixpiSettingNote {
    color: #949dab; background: #161a20; border-left: 2px solid #a3c45e; padding: 0px 10px;
    font-family: "Open Sans", "Ubuntu"; font-size: 13px; qproperty-wordWrap: true;
}
/* The Brightness readout ("80%"). */
#MixpiSettingValue {
    color: #e4e7ec; font-family: "Ubuntu Mono", "Ubuntu"; font-size: 17px; font-weight: bold;
    qproperty-alignment: 'AlignRight | AlignVCenter';
}
#MixpiIconButton {
    background: #1d222a; border: 1px solid #3a424e; border-radius: 3px; margin: 0px;
}
#MixpiIconButton[pressed="true"] { background: #262c35; }
#MixpiIconButton[value="1"] { background: rgba(163, 196, 94, 66); border: 2px solid #a3c45e; }
#MixpiIconButton:disabled { background: #13161b; border: 1px dashed #2c333d; }
/* The close control: a neutral square with a red ✕ (mixpi-icon-close.svg),
 * no outline at rest; pressed it is danger-surface with a danger border. */
#MixpiClose {
    background: #1d222a; border: 1px solid #1d222a; border-radius: 3px; margin: 0px;
}
#MixpiClose[pressed="true"] { background: #34191b; border-color: #d0574d; }
#MixpiClose:disabled { background: #13161b; border-color: #13161b; }
#MixpiCpuBox { margin: 0px 0px 0px 6px; }
#MixpiCpuLabel { color: #949dab; font-family: "Open Sans", "Ubuntu"; font-size: 13px; }
#MixpiCpu { color: #a3c45e; font-family: "Ubuntu Mono", "Ubuntu"; font-size: 17px; font-weight: bold; }

/* Confirm: the one main action of a screen, solid muted accent, dark text. */
#MixpiPrimary { color: #0d1014; background: #a3c45e; border-color: #a3c45e; font-size: 18px; }
#MixpiPrimary[pressed="true"] { background: #8fad50; border-color: #8fad50; }
#MixpiPrimary:disabled { color: #7f8896; background: #13161b; border: 1px dashed #2c333d; }

/* Full-screen headers (Tracks, Sources, Load sample) and the Sampler header. */
#MixpiBrowseHeader, #MixpiSamplerHeader, #MixpiSampleSources, #MixpiSampleFooter {
    background: #161a20; border-bottom: 1px solid #2c333d;
}
#MixpiSampleFooter { border-bottom: 0px; border-top: 1px solid #2c333d; }
#MixpiScreenTitle {
    color: #e4e7ec; font-family: "Ubuntu Condensed", "Ubuntu"; font-size: 22px; font-weight: bold;
    padding-left: 12px;
}
#MixpiScreenHint {
    color: #949dab; font-family: "Ubuntu", "Open Sans"; font-size: 14px; padding: 0px 10px;
}
#MixpiSavedNote { color: #7cc58a; font-family: "Open Sans", "Ubuntu"; font-size: 14px; }
#MixpiTrackTitles { background: #161a20; border-top: 1px solid #2c333d; }

/* Choose pad: a sheet over the dimmed list. */
#MixpiChooseScrim { background: rgba(5, 7, 9, 168); }
#MixpiChooseSheet { background: #161a20; border: 1px solid #3a424e; border-radius: 3px; }
#MixpiSheetTitle { color: #e4e7ec; font-family: "Ubuntu Condensed", "Ubuntu"; font-size: 23px; font-weight: bold; }
#MixpiChooseCell { background: #1d222a; border: 1px solid #3a424e; border-radius: 3px; }
#MixpiChooseInfo { qproperty-layoutContentsMargins: rect(10 8 10 6); }
#MixpiChooseName { color: #e4e7ec; font-family: "Open Sans", "Ubuntu"; font-size: 14px; }
#MixpiChooseEmpty { color: #949dab; font-family: "Open Sans", "Ubuntu"; font-size: 14px; }
#MixpiChooseTile { background: transparent; border: 0px; border-radius: 3px; margin: 0px; }
#MixpiChooseTile[pressed="true"] { background: rgba(163, 196, 94, 66); }
#MixpiChooseTile:disabled { background: rgba(13, 16, 20, 190); }

/* Sampler pads: deck A pads 1-4 deck 1 badges, deck B pads 5-8 deck 2 badges. */
/* Top-aligned, so spare height never centres the page (WWidgetGroup centres by default). */
#MixpiSampler { qproperty-layoutAlignment: 'AlignTop'; }
#MixpiPadA, #MixpiPadB { background: #161a20; border-right: 1px solid #2c333d; border-bottom: 1px solid #2c333d; }
#MixpiPadEmpty { background: #0d1014; border-right: 1px solid #2c333d; border-bottom: 1px solid #2c333d; }
#MixpiPadBadgeA, #MixpiPadBadgeB {
    color: #0d1014; font-family: "Ubuntu", "Open Sans"; font-size: 15px; font-weight: bold;
    border-radius: 2px; margin: 2px;
}
#MixpiPadBadgeA, #MixpiDeckNumber1 { background: #5b95d4; }
#MixpiPadBadgeB, #MixpiDeckNumber2 { background: #d6784a; }
#MixpiPadTag { color: #e4e7ec; font-family: "Open Sans", "Ubuntu"; font-size: 13px; font-weight: bold; padding-left: 6px; }
#MixpiPadInfo { qproperty-layoutContentsMargins: rect(8 4 8 2); }
#MixpiPadTime { color: #949dab; font-family: "Ubuntu Mono", "Ubuntu"; font-size: 13px; }
#MixpiPadName { color: #e4e7ec; font-family: "Open Sans", "Ubuntu"; font-size: 15px; font-weight: bold; }
#MixpiPadEmptyText { color: #949dab; font-family: "Open Sans", "Ubuntu"; font-size: 15px; }
#MixpiPadLoad { background: transparent; border: 0px; margin: 0px; }
#MixpiPadLoad[pressed="true"] { background: rgba(163, 196, 94, 40); }
/* A playing pad has a 2 px play-coloured edge (m-sampler.png). */
#MixpiPadLoaded[highlight="1"] { border: 2px solid #5fae6e; }

/* Clear samples popover (m-sampler-clear.png): the scrim dims the screen; a
 * 480 px sheet, title row, the rows, the note and CANCEL / CLEAR (n). */
#MixpiClearScrim { background: rgba(5, 7, 9, 168); }
#MixpiClearSheet { background: #161a20; border: 1px solid #3a424e; border-radius: 3px; }
#MixpiClearHead { border-bottom: 1px solid #2c333d; qproperty-layoutContentsMargins: rect(16 4 2 4); }
#MixpiClearList, #MixpiClearList > QWidget, #MixpiClearRows { background: #161a20; border: 0px; }
/* The rows take the list's width, and its height while they fit. */
#MixpiClearList { qproperty-widgetResizable: true; }
#MixpiClearRows { qproperty-layoutAlignment: 'AlignTop'; }
#MixpiClearListArea, #MixpiClearListSpace, #MixpiClearListSpace > #MixpiGap { background: #161a20; border: 0px; }
/* The whole row is the tick row: a transparent button over it takes the taps
 * (pressed: the same light tint as a pad's tap area); the tick box under it
 * only draws. */
#MixpiClearRowTap { background: transparent; border: 0px; border-radius: 0px; margin: 0px; }
#MixpiClearRowTap[pressed="true"] { background: rgba(163, 196, 94, 40); }
#MixpiClearTick { background: transparent; border: 0px; border-radius: 0px; margin: 0px; }
#MixpiClearRowText { background: #161a20; border-bottom: 1px solid #2c333d; }
#MixpiClearRowText[highlight="1"] { background: #1d222a; }
#MixpiClearName { color: #e4e7ec; font-family: "Open Sans", "Ubuntu"; font-size: 15px; font-weight: bold; }
#MixpiClearTime {
    color: #949dab; font-family: "Ubuntu Mono", "Ubuntu"; font-size: 13px;
    qproperty-alignment: 'AlignRight | AlignVCenter';
}
#MixpiClearNote {
    color: #949dab; font-family: "Ubuntu", "Open Sans"; font-size: 14px; padding: 0px 16px;
}
#MixpiClearFoot { border-top: 1px solid #2c333d; }
/* CLEAR (n): Danger. Lit (n ticked) as drawn; not enabled at 0. */
#MixpiClearConfirm {
    color: #f4a59d; background: rgba(208, 87, 77, 66); border: 2px solid #d0574d;
    border-radius: 3px; margin: 2px; font-family: "Ubuntu Condensed", "Ubuntu";
    font-size: 16px; font-weight: bold;
}
#MixpiClearConfirm[pressed="true"] { color: #0d1014; background: #d0574d; }
#MixpiClearConfirm:disabled { color: #7f8896; background: #13161b; border: 1px dashed #2c333d; }
/* 24 px scroll bar at the list's right edge (spec section 1). */
#MixpiClearList QScrollBar:vertical {
    width: 24px; background: #161a20; border: 0px; border-left: 1px solid #2c333d; margin: 0px;
}
#MixpiClearList QScrollBar::handle:vertical {
    min-height: 56px; background: #5b6472; border: 5px solid #161a20; border-radius: 8px;
}
#MixpiClearList QScrollBar::handle:vertical:pressed { background: #a3c45e; }
/* The plain bar of spec section 1: no arrow buttons. */
#MixpiClearList QScrollBar::add-line:vertical, #MixpiClearList QScrollBar::sub-line:vertical {
    height: 0px; width: 0px; border: 0px; background: none; subcontrol-origin: margin;
}
#MixpiClearList QScrollBar::up-arrow:vertical, #MixpiClearList QScrollBar::down-arrow:vertical {
    height: 0px; width: 0px; border: 0px; background: none; image: none;
}
#MixpiClearList QScrollBar::add-page, #MixpiClearList QScrollBar::sub-page { background: #161a20; }

#MixpiLabel, #MixpiWaveKey { color: #e4e7ec; font-family: "Open Sans", "Ubuntu"; font-size: 17px; }
#MixpiWaveInfo { background: #161a20; border-right: 1px solid #2c333d;
    qproperty-layoutContentsMargins: rect(8 8 4 4); qproperty-layoutSpacing: 6; }

/* Deck row: badge, title, the dimmer artist right after it, then the chips.
 * Vertical alignment only: with WWidgetGroup's default AlignCenter the row
 * took just its size hint, centred in its half, and the artist (no size
 * hint) got no width. Without a horizontal alignment the row fills its half. */
#MixpiTitleStrip { background: #161a20; qproperty-layoutAlignment: 'AlignVCenter'; }
#MixpiDeckTitle { color: #e4e7ec; font-family: "Open Sans", "Ubuntu"; font-size: 16px; padding-left: 4px; }
#MixpiDeckArtist { color: #949dab; font-family: "Open Sans", "Ubuntu"; font-size: 14px; padding-left: 6px; }
#MixpiDeckNumber1, #MixpiDeckNumber2 {
    color: #0d1014; font-family: "Open Sans", "Ubuntu"; font-size: 16px; font-weight: bold;
    qproperty-alignment: AlignCenter; margin: 2px; border-radius: 2px;
}
#MixpiDeckStats { background: #161a20; border-right: 1px solid #2c333d; }
#MixpiTime, #MixpiRate, #MixpiKey { color: #e4e7ec; font-family: "Open Sans", "Ubuntu"; font-size: 21px; }
#MixpiKey, #MixpiWaveKey { font-size: 17px; }
#MixpiBpm {
    background: #e4e7ec; color: #0d1014; font-family: "Open Sans", "Ubuntu"; font-size: 25px;
    font-weight: bold; margin: 4px; border-radius: 3px;
}

/* Tool panel (LOOP · JUMP · CUES). */
#MixpiLoopPanel { background: #0d1014; }
#MixpiLoopPanel #MixpiButton, #MixpiLoopPanel #MixpiSize, #MixpiLoopPanel #MixpiDanger,
#MixpiLoopPanel #MixpiSound { font-size: 19px; }
/* EXIT LOOP and RELOOP stay at rest while a loop is on (m-loop.png, spec 2b).
 * RELOOP is disabled while looping (a second tap would end the loop); it keeps
 * the Sound at-rest look then. */
#MixpiLoopTools #MixpiSound:disabled { color: #86c0d8; background: #1d222a; border: 1px solid #427086; }

/* FX: boxes, selectors and full-height slider fills. */
#MixpiFx { background: #0d1014; }
#MixpiFxCardHead { qproperty-layoutContentsMargins: rect(8 0 8 0); }
#MixpiFxCard { background: #161a20; border: 1px solid #2c333d; border-radius: 3px; margin: 3px; }
#MixpiFxMix { margin: 0px 8px 0px 6px; }
/* A combo box clips its text and does not elide, so the whole "SELECT
 * EFFECT…" (build B's Open Sans 18 bold, upper case: 144 px) must fit the
 * text area: 177 px inside the border, less 6 px left padding, no right
 * padding (Pioneered's WEffectSelector gives 4) and the 24 px ▾ zone = 147. */
#MixpiEffectSelector {
    color: #e4e7ec; background: #1d222a; border: 1px solid #2c333d; border-radius: 3px;
    margin: 2px; padding-left: 6px; padding-right: 0px;
    font-family: "Open Sans", "Ubuntu"; font-size: 18px;
}
/* "SELECT EFFECT…" is dim while the slot is empty (N-C's mixpiEmpty). */
#MixpiEffectSelector[mixpiEmpty="true"] { color: #949dab; }
/* The ▾ sits inside the field (m-fx.png): no separate box, dim. */
#MixpiEffectSelector::drop-down {
    subcontrol-origin: padding; subcontrol-position: center right;
    width: 24px; border: 0px; background: transparent;
}
#MixpiEffectSelector::down-arrow { image: url(skin:/mixpi-icon-caret.svg); width: 12px; height: 8px; }
/* The open list: the token colours of every list. The current effect is the
 * current menu row: surface-2 and a 4 px accent edge (the text keeps build
 * B's selector font). */
#MixpiEffectSelector QAbstractItemView {
    color: #e4e7ec; background: #161a20; border: 1px solid #3a424e;
    selection-color: #e4e7ec; selection-background-color: #1d222a;
}
#MixpiEffectSelector:disabled, #MixpiEffectSelector QAbstractItemView:disabled {
    color: #7f8896; background: #13161b;
}
#MixpiEffectSelector QAbstractItemView::item:disabled { color: #7f8896; }
#MixpiEffectSelector QAbstractItemView::item:selected {
    color: #e4e7ec; background: #1d222a; border-left: 4px solid #a3c45e;
}
#MixpiSettingSelector, #MixpiSettingSelector QAbstractItemView {
    color: #e4e7ec; background: #1d222a; font-family: "Open Sans", "Ubuntu"; font-size: 17px;
    selection-color: #0d1014; selection-background-color: #a3c45e;
}
/* The slider widget is the track: surface-2, a line-strong border, radius 3.
 * The fill (BarColor #5d7238) is drawn the full height up to the thumb's centre. */
#MixpiDepth { background: #1d222a; border: 1px solid #3a424e; border-radius: 3px; margin: 0px; }

#MixpiSettings { background: #0d1014; }
#MixpiPlaybackSettings, #MixpiInterfaceSettings { padding: 4px; }
#MixpiSetting { border-bottom: 1px solid #2c333d; }
#MixpiSettingLabel { font-family: "Open Sans", "Ubuntu"; font-size: 13px; color: #949dab; qproperty-wordWrap: true; }
#MixpiDesktopBar { border-radius: 3px; }
#MixpiDesktopBar:disabled { color: #7f8896; background: #13161b; border: 1px dashed #2c333d; }
