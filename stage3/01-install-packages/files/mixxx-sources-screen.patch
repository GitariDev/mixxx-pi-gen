+// The fixed second line of a rail tile, per kind of source.
+inline QString sourceSubline(const QString& identity) {
+    static const QMap<QString, const char*> lines{
+            {QStringLiteral("MixxxLibraryFeature"), QT_TRANSLATE_NOOP("Sources", "All tracks on this Pi")},
+            {QStringLiteral("AutoDJFeature"), QT_TRANSLATE_NOOP("Sources", "Auto DJ queue")},
+            {QStringLiteral("PlaylistFeature"), QT_TRANSLATE_NOOP("Sources", "Your playlists")},
