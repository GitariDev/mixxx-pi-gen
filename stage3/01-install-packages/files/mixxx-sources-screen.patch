+// Buttons in a touch list: a press that moves the drag distance scrolls the
+// list and never clicks, even when it ends on the button it started on (the
+// C-1 rule of the Sources list). A press that stays still is a tap.
+class TouchDragScroll final : public QObject {
+  public:
+    explicit TouchDragScroll(QAbstractScrollArea* area)
+            : QObject(area), m_area(area) {
+    }
+    void watch(QAbstractButton* button) {
+        button->installEventFilter(this);
+    }
+
+  protected:
+    bool eventFilter(QObject* object, QEvent* event) override {
+        auto* button = qobject_cast<QAbstractButton*>(object);
+        if (!button || m_forwarding) {
+            return false;
+        }
+        switch (event->type()) {
+        case QEvent::MouseButtonPress:
+        case QEvent::MouseButtonDblClick: {
+            auto* mouse = static_cast<QMouseEvent*>(event);
+            if (mouse->button() != Qt::LeftButton) {
+                return false;
+            }
+            m_press = mouse->globalPosition().toPoint();
+            m_start = m_area->verticalScrollBar()->value();
+            m_button = button;
+            m_dragging = false;
+            if (event->type() == QEvent::MouseButtonDblClick) {
+                // A second quick tap is a new tap, not a double-click.
+                QMouseEvent press(QEvent::MouseButtonPress, mouse->position(),
+                        mouse->globalPosition(), Qt::LeftButton, mouse->buttons(),
+                        mouse->modifiers());
+                forward(button, &press);
+                return true;
+            }
+            return false;
+        }
+        case QEvent::MouseMove: {
+            auto* mouse = static_cast<QMouseEvent*>(event);
+            if (button != m_button || !(mouse->buttons() & Qt::LeftButton)) {
+                return false;
+            }
+            const QPoint position = mouse->globalPosition().toPoint();
+            if (!m_dragging && (position - m_press).manhattanLength() >=
+                            QApplication::startDragDistance()) {
+                m_dragging = true;
+                // End the button's press away from it: no click.
+                QMouseEvent release(QEvent::MouseButtonRelease, QPointF(-10000, -10000),
+                        mouse->globalPosition(), Qt::LeftButton, Qt::NoButton, Qt::NoModifier);
+                forward(button, &release);
+            }
+            if (m_dragging) {
+                m_area->verticalScrollBar()->setValue(m_start - (position.y() - m_press.y()));
+                return true;
+            }
+            return false;
+        }
+        case QEvent::MouseButtonRelease: {
+            const bool dragged = button == m_button && m_dragging;
+            m_dragging = false;
+            m_button = nullptr;
+            return dragged;
+        }
+        default:
+            return false;
+        }
+    }
+
+  private:
+    void forward(QAbstractButton* button, QMouseEvent* event) {
+        m_forwarding = true;
+        QCoreApplication::sendEvent(button, event);
+        m_forwarding = false;
+    }
+
+    QAbstractScrollArea* const m_area;
+    QPointer<QAbstractButton> m_button;
+    QPoint m_press;
+    int m_start = 0;
+    bool m_dragging = false;
+    bool m_forwarding = false;
+};
+
+// An on/off switch: the whole 64x48 area takes the tap.
+class SourceSwitch final : public QCheckBox {
+  public:
+    using QCheckBox::QCheckBox;
+
+  protected:
+    bool hitButton(const QPoint& position) const override {
+        return rect().contains(position);
+    }
+};
+
+struct SourceEditEntry {
+    QString id;
+    QString title;
+    bool visible;
+    // False for an optional source that is not created yet (it is hidden).
+    bool available;
+};
+
+// Sources edit (R-10): one list. Each 56 px row has the name, Up, Down and
+// an on/off switch; the start source carries a star. Start here (under the
+// list) makes the selected row the start source. The last visible source
+// cannot be switched off. No drag-to-reorder, no menu.
+class SourceEditList final : public QWidget {
+  public:
+    std::function<void(const QStringList&)> orderChanged;
+    std::function<void(const QString&, bool)> visibilityChanged;
+    std::function<void(const QString&)> startChosen;
+
+    explicit SourceEditList(QWidget* parent)
+            : QWidget(parent) {
+        setObjectName(QStringLiteral("MixpiSourceEdit"));
+        setAttribute(Qt::WA_StyledBackground);
+        auto* layout = new QVBoxLayout(this);
+        layout->setContentsMargins(0, 0, 0, 0);
+        layout->setSpacing(0);
+        auto* hint = new QLabel(QObject::tr("Show, order, and ★ where Tracks starts"), this);
+        hint->setObjectName(QStringLiteral("MixpiSourceEditHint"));
+        hint->setFixedHeight(kSourceBarHeight);
+        layout->addWidget(hint);
+        m_area = new QScrollArea(this);
+        m_area->setObjectName(QStringLiteral("MixpiSourceEditList"));
+        m_area->setFrameShape(QFrame::NoFrame);
+        m_area->setWidgetResizable(true);
+        m_area->setHorizontalScrollBarPolicy(Qt::ScrollBarAlwaysOff);
+        m_rows = new QWidget(m_area);
+        m_rows->setObjectName(QStringLiteral("MixpiSourceEditRows"));
+        auto* rows = new QVBoxLayout(m_rows);
+        rows->setContentsMargins(0, 0, 0, 0);
+        rows->setSpacing(0);
+        rows->addStretch();
+        m_area->setWidget(m_rows);
+        layout->addWidget(m_area, 1);
+        auto* footer = new QWidget(this);
+        footer->setObjectName(QStringLiteral("MixpiSourceEditFooter"));
+        footer->setFixedHeight(kSourceRowHeight);
+        auto* footerLayout = new QHBoxLayout(footer);
+        footerLayout->setContentsMargins(8, 4, 8, 4);
+        m_start = new QPushButton(QObject::tr("Start here"), footer);
+        m_start->setObjectName(QStringLiteral("MixpiSourceStartHere"));
+        m_start->setFocusPolicy(Qt::NoFocus);
+        m_start->setFixedSize(160, 48);
+        footerLayout->addWidget(m_start);
+        footerLayout->addStretch();
+        layout->addWidget(footer);
+        m_drag = new TouchDragScroll(m_area);
+        QObject::connect(m_start, &QPushButton::clicked, this, [this] {
+            if (startChosen && !m_selected.isEmpty()) {
+                startChosen(m_selected);
+            }
+        });
+    }
+
+    // Rebuilds the rows. The selection and the scroll position stay.
+    void setSources(const QList<SourceEditEntry>& sources, const QString& start) {
+        const int scroll = m_area->verticalScrollBar()->value();
+        m_sources = sources;
+        m_startSource = start;
+        auto* rows = static_cast<QVBoxLayout*>(m_rows->layout());
+        for (auto* row : std::as_const(m_rowWidgets)) {
+            rows->removeWidget(row);
+            row->hide();
+            // Not now: the button that asked for this may be on that row.
+            row->deleteLater();
+        }
+        m_rowWidgets.clear();
+        m_switches.clear();
+        bool selectedFound = false;
+        for (int position = 0; position < sources.size(); ++position) {
+            const auto& source = sources.at(position);
+            selectedFound |= source.id == m_selected;
+            auto* row = new QWidget(m_rows);
+            row->setObjectName(QStringLiteral("MixpiSourceEditRow"));
+            row->setAttribute(Qt::WA_StyledBackground);
+            row->setFixedHeight(kSourceRowHeight);
+            auto* line = new QHBoxLayout(row);
+            line->setContentsMargins(0, 4, 8, 4);
+            line->setSpacing(6);
+            auto* name = new QPushButton(source.id == start
+                            ? source.title + QStringLiteral("  ★")
+                            : source.title,
+                    row);
+            name->setObjectName(QStringLiteral("MixpiSourceEditName"));
+            name->setCheckable(true);
+            name->setChecked(source.id == m_selected);
+            name->setMinimumHeight(48);
+            name->setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Fixed);
+            name->setProperty("sourceId", source.id);
+            line->addWidget(name, 1);
+            auto* up = new QPushButton(QObject::tr("Up"), row);
+            up->setObjectName(QStringLiteral("MixpiSourceEditUp"));
+            up->setFixedSize(48, 48);
+            up->setEnabled(position > 0);
+            line->addWidget(up);
+            auto* down = new QPushButton(QObject::tr("Down"), row);
+            down->setObjectName(QStringLiteral("MixpiSourceEditDown"));
+            down->setFixedSize(48, 48);
+            down->setEnabled(position + 1 < sources.size());
+            line->addWidget(down);
+            auto* toggle = new SourceSwitch(row);
+            toggle->setObjectName(QStringLiteral("MixpiSourceEditSwitch"));
+            toggle->setAccessibleName(QObject::tr("Show %1").arg(source.title));
+            toggle->setFixedSize(kSourceSwitchWidth, 48);
+            toggle->setChecked(source.visible);
+            line->addWidget(toggle);
+            for (QAbstractButton* button : {static_cast<QAbstractButton*>(name),
+                         static_cast<QAbstractButton*>(up),
+                         static_cast<QAbstractButton*>(down),
+                         static_cast<QAbstractButton*>(toggle)}) {
+                button->setFocusPolicy(Qt::NoFocus);
+                m_drag->watch(button);
+            }
+            const QString id = source.id;
+            QObject::connect(name, &QPushButton::clicked, this, [this, id] { select(id); });
+            QObject::connect(up, &QPushButton::clicked, this, [this, id] { move(id, -1); });
+            QObject::connect(down, &QPushButton::clicked, this, [this, id] { move(id, 1); });
+            QObject::connect(toggle, &QCheckBox::toggled, this, [this, id](bool on) {
+                if (visibilityChanged) {
+                    visibilityChanged(id, on);
+                }
+            });
+            rows->insertWidget(rows->count() - 1, row);
+            m_rowWidgets.append(row);
+            m_switches.append(toggle);
+        }
+        if (!selectedFound) {
+            m_selected.clear();
+        }
+        protectLastVisible(m_switches);
+        updateStart();
+        rows->activate();
+        m_rows->adjustSize();
+        m_area->verticalScrollBar()->setValue(scroll);
+    }
+
+    QString selected() const {
+        return m_selected;
+    }
+    QList<QWidget*> rows() const {
+        return m_rowWidgets;
+    }
+    QPushButton* startButton() const {
+        return m_start;
+    }
+    QScrollArea* area() const {
+        return m_area;
+    }
+
+  private:
+    void select(const QString& id) {
+        m_selected = id;
+        for (auto* row : std::as_const(m_rowWidgets)) {
+            auto* name = row->findChild<QPushButton*>(QStringLiteral("MixpiSourceEditName"));
+            name->setChecked(name->property("sourceId").toString() == id);
+        }
+        updateStart();
+    }
+
+    void move(const QString& id, int direction) {
+        QStringList order;
+        for (const auto& source : std::as_const(m_sources)) {
+            order.append(source.id);
+        }
+        const int from = order.indexOf(id);
+        const int to = from + direction;
+        if (from < 0 || to < 0 || to >= order.size()) {
+            return;
+        }
+        order.move(from, to);
+        m_selected = id;
+        if (orderChanged) {
+            orderChanged(order);
+        }
+    }
+
+    void updateStart() {
+        bool startable = false;
+        for (const auto& source : std::as_const(m_sources)) {
+            if (source.id == m_selected) {
+                startable = source.visible && source.available && source.id != m_startSource;
+            }
+        }
+        m_start->setEnabled(startable);
+    }
+
+    QScrollArea* m_area;
+    QWidget* m_rows;
+    QPushButton* m_start;
+    TouchDragScroll* m_drag;
+    QList<SourceEditEntry> m_sources;
+    QList<QWidget*> m_rowWidgets;
+    QList<QCheckBox*> m_switches;
+    QString m_selected;
+    QString m_startSource;
+};
+
+}
