#!/bin/bash
set -euo pipefail
/usr/local/bin/mixpi-mixxx
# Wait for the window if returning from Speaker mode starts Mixxx.
for attempt in {1..80}; do
    window_id=$(swaymsg -r -t get_tree | jq -r '[.. | objects | select(.app_id? == "org.mixxx.Mixxx" or ((.window_properties.class? // "" | ascii_downcase) == "mixxx")) | .id][0] // empty')
    if [ -n "$window_id" ]; then
        swaymsg "[con_id=$window_id] fullscreen disable, focus" >/dev/null
        sleep 0.3
        wtype -M ctrl -k p -m ctrl
        exit 0
    fi
    sleep 0.25
done
echo 'Mixxx did not open. Tap Mixxx and try again.' >&2
exit 1
