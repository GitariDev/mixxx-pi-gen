[Unit]
Description=Reviewed controlled MixPi media lifecycle
After=local-fs.target systemd-sysctl.service
ConditionPathExists=/etc/mixpi/controlled-media
ConditionPathExists=/etc/mixpi/eject-reviewed

[Service]
Type=simple
ExecStart=/usr/bin/python3 -I /opt/mixpi-skin-tools/mixpi-mount-broker.py
User=root
Group=root
UMask=0077
Restart=no
PrivateMounts=no
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_CHOWN
RestrictAddressFamilies=AF_UNIX
LimitNOFILE=256

[Install]
WantedBy=multi-user.target
