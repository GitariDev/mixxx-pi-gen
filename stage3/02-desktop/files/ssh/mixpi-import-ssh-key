#!/bin/bash
set -euo pipefail

key_file=/boot/firmware/mixpi-authorized-key.pub
[ -f "$key_file" ] || exit 0
# Accept exactly one ordinary Ed25519 public key, never a private key or an
# authorized_keys command/options line supplied on the boot partition.
key=$(tr -d '\r' < "$key_file")
if [[ "$key" == *$'\n'* ]] || [[ ! "$key" =~ ^ssh-ed25519\ [A-Za-z0-9+/]+={0,2}(\ .*)?$ ]]; then
    echo 'Expected one ssh-ed25519 public key in mixpi-authorized-key.pub' >&2
    exit 1
fi
ssh-keygen -l -f "$key_file" >/dev/null
install -d -m 700 -o pi -g pi /home/pi/.ssh
touch /home/pi/.ssh/authorized_keys
if ! grep -qxF "$key" /home/pi/.ssh/authorized_keys; then
    printf '%s\n' "$key" >> /home/pi/.ssh/authorized_keys
fi
chmod 600 /home/pi/.ssh/authorized_keys
chown pi:pi /home/pi/.ssh/authorized_keys
rm -- "$key_file"
