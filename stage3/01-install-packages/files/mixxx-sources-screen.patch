+void WLibrarySidebar::scheduleSourceRail() {
+    if (!m_sourceScreen || m_sourceRailPending) {
+        return;
+    }
+    // After the model change has finished (a reset or a row move is not
+    // over while its signal runs), and once for a burst of changes.
+    m_sourceRailPending = true;
+    QTimer::singleShot(0, this, [this] { rebuildSourceRail(); });
+}
+
+void WLibrarySidebar::rebuildSourceRail() {
+    m_sourceRailPending = false;
+    if (!m_sourceScreen || !m_sourceRail || !model()) {
+        return;
+    }
+    QWidget* pTiles = m_sourceRail->widget();
+    auto* pTileLayout = static_cast<QVBoxLayout*>(pTiles->layout());
+    for (auto* pTile : std::as_const(m_sourceTiles)) {
+        pTileLayout->removeWidget(pTile);
+        pTile->hide();
+        pTile->deleteLater();
+    }
+    m_sourceTiles.clear();
+    m_sourceTileIndexes.clear();
+    // One tile per visible top-level source, in the model's (saved) order.
+    for (int row = 0; row < model()->rowCount(); ++row) {
+        if (isRowHidden(row, QModelIndex())) {
+            continue;
+        }
+        const QPersistentModelIndex index(model()->index(row, 0));
+        auto* pTile = new QPushButton(pTiles);
+        pTile->setObjectName("MixpiSourceTile");
+        pTile->setCheckable(true);
+        pTile->setFocusPolicy(Qt::NoFocus);
+        pTile->setFixedHeight(LibraryInterface::kSourceTileHeight);
+        pTile->setAccessibleName(index.data().toString());
+        auto* pLine = new QHBoxLayout(pTile);
+        pLine->setContentsMargins(12, 6, 8, 6);
+        pLine->setSpacing(10);
+        auto* pIcon = tileLabel("MixpiSourceTileIcon", pTile);
+        pIcon->setFixedSize(26, 26);
+        pIcon->setPixmap(index.data(Qt::DecorationRole).value<QIcon>().pixmap(26, 26));
+        pLine->addWidget(pIcon);
+        auto* pText = new QVBoxLayout;
+        pText->setSpacing(2);
+        auto* pName = tileLabel("MixpiSourceTileName", pTile);
+        pName->setText(index.data().toString());
+        pText->addWidget(pName);
+        auto* pSub = tileLabel("MixpiSourceTileSub", pTile);
+        pSub->setText(sourceSubline ? sourceSubline(index) : QString());
+        pText->addWidget(pSub);
+        pLine->addLayout(pText, 1);
+        connect(pTile, &QPushButton::clicked, this, [this, index] { openSourceTile(index); });
+        m_sourceRailDrag->watch(pTile);
+        pTileLayout->insertWidget(pTileLayout->count() - 1, pTile);
+        m_sourceTiles.append(pTile);
+        m_sourceTileIndexes.append(index);
+    }
+    updateSourceChrome();
 }
 
+QString WLibrarySidebar::sourceCrumb() const {
+    QStringList parts;
+    for (QModelIndex index = rootIndex(); index.isValid(); index = index.parent()) {
+        parts.prepend(index.data().toString());
+    }
+    return parts.isEmpty() ? tr("All sources") : parts.join(QStringLiteral(" \u203A "));
+}
+
+void WLibrarySidebar::updateSourceChrome() {
+    if (!m_sourceScreen || !m_touchNavigation) {
+        return;
+    }
+    m_sourceBack->setEnabled(m_touchNavigation->canGoBack());
+    const QString crumb = sourceCrumb();
+    m_sourceCrumbLabel->setToolTip(crumb);
+    // The end of the path matters most: elide at the left.
+    m_sourceCrumbLabel->setText(m_sourceCrumbLabel->fontMetrics().elidedText(
+            crumb, Qt::ElideLeft, m_sourceCrumbLabel->width()));
+    QModelIndex top = rootIndex();
+    if (!top.isValid()) {
+        top = currentIndex();
+    }
+    while (top.parent().isValid()) {
+        top = top.parent();
+    }
+    for (int tile = 0; tile < m_sourceTiles.size(); ++tile) {
+        m_sourceTiles.at(tile)->setChecked(top.isValid() && m_sourceTileIndexes.at(tile) == top);
+    }
+}
+
+void WLibrarySidebar::openSourceTile(const QPersistentModelIndex& index) {
+    if (!m_touchNavigation || m_sourcesEditing || !index.isValid() ||
+            index.model() != model() || index.parent().isValid() ||
+            isRowHidden(index.row(), QModelIndex())) {
+        return;
+    }
+    // That source's top level on the right: home, then enter it.
+    m_touchNavigation->home();
+    selectionModel()->setCurrentIndex(index,
+            QItemSelectionModel::ClearAndSelect | QItemSelectionModel::Rows);
+    activateTouchIndex(index);
+}
+
+void WLibrarySidebar::activateTouchIndex(const QModelIndex& tapped) {
+    const QPersistentModelIndex index(tapped);
+    m_sourceShown = false;
+    // The same signal a mouse click emits: SidebarModel::clicked() opens the
+    // source at once and TouchSourceNavigation enters it.
+    emit clicked(index);
+    // A list without children (a playlist, a crate, a folder of tracks) is
+    // now in Tracks: close Sources. A row whose children still load (a
+    // rekordbox drive) showed nothing yet and stays open.
+    if (m_sourceScreen && m_sourceShown && index.isValid() && rootIndex() != index &&
+            model()->rowCount(index) == 0) {
+        closeSources();
+    }
+    m_sourceShown = false;
+    updateSourceChrome();
+}
+
+void WLibrarySidebar::closeSources() {
+    // The skin's controls: the sidebar-visible control and [MixPi],screen
+    // (0 none, 1 Sources, ...). A skin without them has nothing to close.
+    for (const auto& key : {ConfigKey("[Sidebar]", "sidebar_visible"),
+                 ConfigKey("[MixPi]", "screen")}) {
+        if (auto* pControl = ControlObject::getControl(key, ControlFlag::NoWarnIfMissing)) {
+            pControl->set(0);
+        }
+    }
+}
+
+void WLibrarySidebar::setSourcesEditPanel(QWidget* pPanel) {
+    if (m_sourcesEditPanel == pPanel) {
+        return;
+    }
+    if (m_sourcesEditPanel) {
+        m_sourcesEditPanel->hide();
+    }
+    m_sourcesEditPanel = pPanel;
+    if (pPanel) {
+        pPanel->setParent(this);
+        pPanel->setVisible(m_sourcesEditing);
+    } else {
+        m_sourcesEditing = false;
+    }
+    layoutSourceScreen();
+}
+
+void WLibrarySidebar::setSourcesEditing(bool editing) {
+    editing = editing && m_sourcesEditPanel;
+    m_sourcesEditing = editing;
+    if (m_sourcesEditPanel) {
+        m_sourcesEditPanel->setVisible(editing);
+    }
+    if (m_sourceBar) {
+        m_sourceBar->setVisible(m_sourceScreen && !editing);
+    }
+    if (m_sourcesEditingControl) {
+        m_sourcesEditingControl->set(editing ? 1 : 0);
+    }
+    layoutSourceScreen();
+    if (!editing) {
+        // The rail shows the new order and visibility.
+        rebuildSourceRail();
+    }
+}
