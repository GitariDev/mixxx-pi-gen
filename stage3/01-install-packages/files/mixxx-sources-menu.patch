+// Style sheet rules that name a widget (or select on a property) apply
+// when it is polished. A QAbstractScrollArea's scroll bars are polished when
+// it is made, before its name is set: polish the children again (and let
+// the layouts see their new size), then the widget.
+inline void repolishTree(QWidget* widget) {
+    for (auto* child : widget->findChildren<QWidget*>()) {
+        child->style()->unpolish(child);
+        child->style()->polish(child);
+        child->updateGeometry();
+    }
+    widget->style()->unpolish(widget);
+    widget->style()->polish(widget);
+    widget->update();
+}
