std::mutex gateMutex;
std::condition_variable gateCondition;
QString gatePhase;
bool gateReached = false;
bool gateReleased = false;
void testBarrier(const char* phase) {
    std::unique_lock<std::mutex> lock(gateMutex);
    if (gatePhase != phase) return;
    gateReached = true;
    gateCondition.notify_all();
    gateCondition.wait(lock, [] { return gateReleased; });
}
void releaseWorker() {
    std::lock_guard<std::mutex> lock(gateMutex);
    gateReleased = true;
    gateCondition.notify_all();
}
void require(bool condition, const char* message) {
    if (!condition) {
        releaseWorker();
        throw std::runtime_error(message);
    }
}
void setGate(const QString& phase) {
    std::lock_guard<std::mutex> lock(gateMutex);
    gatePhase = phase;
    gateReached = false;
    gateReleased = false;
}
bool reached() {
    std::lock_guard<std::mutex> lock(gateMutex);
    return gateReached;
}
#ifndef BASELINE
void testCheckpoint(const std::shared_ptr<mixxx::rekordbox::ImportOperation>& operation,
        const char* phase) {
    testBarrier(phase);
    operation->checkpoint();
}
#endif
void events(int milliseconds = 80) {
    QElapsedTimer timer;
    timer.start();
    while (timer.elapsed() < milliseconds) {
        QCoreApplication::processEvents();
        QThread::msleep(1);
    }
}
template<typename Predicate> void until(Predicate predicate, const char* message) {
    QElapsedTimer timer;
    timer.start();
    while (!predicate() && timer.elapsed() < 5000) events(2);
    require(predicate(), message);
}
namespace mixxx {
using DbConnectionPoolPtr = std::shared_ptr<QString>;
thread_local QString workerConnection;
struct DbConnectionPooler {
    explicit DbConnectionPooler(const DbConnectionPoolPtr& path) {
        workerConnection = QStringLiteral("worker-%1").arg(quintptr(QThread::currentThreadId()));
        auto database = QSqlDatabase::addDatabase("QSQLITE", workerConnection);
        database.setDatabaseName(*path);
        if (!database.open()) throw std::runtime_error("worker SQLite open failed");
        QSqlQuery query(database);
        if (!query.exec("PRAGMA foreign_keys=ON")) throw std::runtime_error("worker SQLite pragma failed");
    }
    ~DbConnectionPooler() {
        QSqlDatabase::database(workerConnection).close();
        QSqlDatabase::removeDatabase(workerConnection);
    }
};
QSqlDatabase DbConnectionPooled(const DbConnectionPoolPtr&) {
    return QSqlDatabase::database(workerConnection);
}
struct FileInfo { explicit FileInfo(const QString&) {} };
}
namespace Sandbox { bool askForAccess(mixxx::FileInfo*) { return true; } }
QString fromUtf16LeString(const std::string& text) {
    QStringDecoder decoder(QStringDecoder::Utf16LE);
    return decoder(QByteArray::fromStdString(text));
}
const QString kRekordboxLibraryTable = "rekordbox_library";
const QString kRekordboxPlaylistsTable = "rekordbox_playlists";
const QString kRekordboxPlaylistTracksTable = "rekordbox_playlist_tracks";
const QString kPdbPath = "PIONEER/rekordbox/export.pdb";
const QString kPLaylistPathDelimiter = "-->";
constexpr int kInvalidPlaylistId = -1;
const QString IS_RECORDBOX_DEVICE = "::isRecordboxDevice::";
const QString IS_NOT_RECORDBOX_DEVICE = "::isNotRecordboxDevice::";
namespace mixxx::rekordbox {
struct Observation { std::string revision; std::string database; };
QMap<QString, Observation> observations;
Observation inspectSource(const std::string& path) { return observations.value(QString::fromStdString(path)); }
