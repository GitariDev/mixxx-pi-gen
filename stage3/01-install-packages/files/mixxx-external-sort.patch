 QString BaseTrackCache::columnSortForFieldIndex(int index) const {
+    // MixPi J6: only This Pi's own library has "key_id", which ColumnCache's
+    // KEY sort reads. Every other table (a rekordbox drive, Serato, Traktor)
+    // sorts its KEY by the key text it shows.
+    if (index >= 0 && index == fieldIndex(ColumnCache::COLUMN_LIBRARYTABLE_KEY) &&
+            fieldIndex(ColumnCache::COLUMN_LIBRARYTABLE_KEY_ID) < 0) {
+        return keyTextSortForFieldIndex(index);
+    }
     return m_columnCache.columnSortForFieldIndex(index);
 }
 
+// MixPi J6: KEY's sort for a table without "key_id", in the order of This
+// Pi's: the circle of fifths in the user's key notation. Each key text in the
+// table is read as This Pi reads a key tag (KeyUtils::guessKeyFromText()), and
+// each key's own spellings in every notation are listed too, for rows added
+// later. Texts that are no key, and NULL, take the order of "no key". The
+// texts go in as SQL string literals (quotes doubled); a text with a NUL
+// character is left out, so it sorts as no key. Nothing is written.
+QString BaseTrackCache::keyTextSortForFieldIndex(int index) const {
+    const QString keyColumn = columnNameForFieldIndex(index);
+    const auto notation = m_columnCache.keyNotation();
+    const QChar quote('\'');
+    QMap<int, QStringList> textsByOrder;
+    QSet<QString> listed;
+    const auto list = [&](const QString& text, mixxx::track::io::key::ChromaticKey key) {
+        if (text.isEmpty() || text.contains(QChar(0)) || listed.contains(text)) {
+            return;
+        }
+        listed.insert(text);
+        QString literal = text;
+        literal.replace(quote, QStringLiteral("''"));
+        textsByOrder[KeyUtils::keyToCircleOfFifthsOrder(key, notation)].append(
+                quote + literal + quote);
+    };
+    QSqlQuery query(m_database);
+    query.setForwardOnly(true);
+    if (query.prepare(QStringLiteral("SELECT DISTINCT %1 FROM %2").arg(keyColumn, m_tableName)) &&
+            query.exec()) {
+        while (query.next()) {
+            const QString text = query.value(0).toString();
+            list(text, KeyUtils::guessKeyFromText(text));
+        }
+    } else {
+        LOG_FAILED_QUERY(query);
+    }
+    for (const auto spelling : {KeyUtils::KeyNotation::Custom,
+                 KeyUtils::KeyNotation::OpenKey,
+                 KeyUtils::KeyNotation::Lancelot,
+                 KeyUtils::KeyNotation::Traditional,
+                 KeyUtils::KeyNotation::OpenKeyAndTraditional,
+                 KeyUtils::KeyNotation::LancelotAndTraditional,
+                 KeyUtils::KeyNotation::ID3v2}) {
+        for (int i = 1; i <= 24; ++i) {
+            const auto key = static_cast<mixxx::track::io::key::ChromaticKey>(i);
+            list(KeyUtils::keyToString(key, spelling), key);
+        }
+    }
+    const int noKey = KeyUtils::keyToCircleOfFifthsOrder(
+            mixxx::track::io::key::INVALID, notation);
+    QString sortSql = QStringLiteral("CASE");
+    for (auto it = textsByOrder.constBegin(); it != textsByOrder.constEnd(); ++it) {
+        if (it.key() == noKey) {
+            continue;
+        }
+        sortSql += QStringLiteral(" WHEN %1 IN (%2) THEN %3")
+                           .arg(keyColumn,
+                                   it.value().join(QChar(',')),
+                                   QString::number(it.key()));
+    }
+    if (sortSql == QStringLiteral("CASE")) {
+        return keyColumn;
+    }
+    return sortSql + QStringLiteral(" ELSE %1 END").arg(noKey);
+}
