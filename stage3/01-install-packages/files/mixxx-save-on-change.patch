+void ConfigAutosave::copyPersistentControlsCached() {
+    // Listing every control takes the control hash mutex and touches
+    // thousands of entries, so the list of persist controls is refreshed
+    // only every few polls; their values are read every poll.
+    if (m_pollsSinceRefresh <= 0) {
+        m_persistentControls.clear();
+        const QList<QSharedPointer<ControlDoublePrivate>> controls =
+                ControlDoublePrivate::getAllInstances();
+        for (const auto& pControl : controls) {
+            if (isPersistent(*pControl)) {
+                m_persistentControls.append(pControl.toWeakRef());
+            }
+        }
+        m_pollsSinceRefresh = m_timing.persistentRefreshPolls;
+    }
+    --m_pollsSinceRefresh;
+    for (const auto& pWeak : std::as_const(m_persistentControls)) {
+        if (const auto pControl = pWeak.toStrongRef()) {
+            copyPersistentValue(m_pConfig.get(), pControl.get());
+        }
+    }
+}
+
+void ConfigAutosave::poll() {
+    if (m_writing) {
+        return;
+    }
+    copyPersistentControlsCached();
+    const quint64 changeCount = m_pConfig->changeCount();
+    if (!m_pConfig->hasUnsavedChanges()) {
+        m_lastSeenChangeCount = changeCount;
+        m_sinceFirstUnsaved.invalidate();
+        return;
+    }
+    if (!m_sinceFirstUnsaved.isValid()) {
+        m_sinceFirstUnsaved.start();
+    }
+    if (changeCount != m_lastSeenChangeCount) {
+        m_lastSeenChangeCount = changeCount;
+        m_sinceChange.start();
+    }
+    const bool quiet = m_sinceChange.elapsed() >= m_timing.quietMs;
+    const bool overdue = m_sinceFirstUnsaved.elapsed() >= m_timing.maxDelayMs;
+    if (!quiet && !overdue) {
+        return;
+    }
+    if (m_sinceFailure.isValid() && m_sinceFailure.elapsed() < m_timing.retryMs) {
+        return;
+    }
+    m_writing = true;
+    const QSharedPointer<ConfigObject<ConfigValue>> pConfig = m_pConfig;
+    QObject* pContext = m_pContext.get();
+    m_pWorker->start([this, pConfig, pContext] {
+        const bool ok = pConfig->save();
+        // Back on the GUI thread. stop() waits for this task, so pContext
+        // outlives the call; a result still queued when pContext is deleted
+        // is dropped with it.
+        QMetaObject::invokeMethod(
+                pContext, [this, ok] { writeFinished(ok); }, Qt::QueuedConnection);
+    });
+}
+
+void ConfigAutosave::writeFinished(bool ok) {
+    m_writing = false;
+    if (!ok) {
+        // ConfigObject::save() has logged why.
+        m_sinceFailure.start();
+        return;
+    }
+    m_sinceFailure.invalidate();
+    // Changes made while the file was written start a new window.
+    if (m_pConfig->hasUnsavedChanges()) {
+        m_sinceFirstUnsaved.start();
+    } else {
+        m_sinceFirstUnsaved.invalidate();
+    }
+    qDebug() << "ConfigAutosave: saved" << m_pConfig->getSettingsPath();
+    pulseSaved();
+}
+
+} // namespace mixxx
