// BaseTrackCache's members, as basetrackcache.h declares them, for its actual
// methods below. The feature's cache is not caching (isCaching false), so the
// global track cache is never asked.
namespace ColumnCache {
enum Column {
    COLUMN_LIBRARYTABLE_TITLE,
    COLUMN_TRACKLOCATIONSTABLE_LOCATION,
    COLUMN_LIBRARYTABLE_KEY,
    COLUMN_LIBRARYTABLE_KEY_ID,
};
}
