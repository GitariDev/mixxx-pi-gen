+++ b/src/library/mixpimedia.h
@@ -0,0 +1,329 @@
+#pragma once
+
+#include <functional>
+#include <memory>
+#include <fstream>
+#include <sstream>
+
+#include <QDialog>
+#include <QFileInfo>
+#include <QFile>
+#include <QJsonArray>
+#include <QJsonDocument>
+#include <QJsonObject>
+#include <QHBoxLayout>
+#include <QLabel>
+#include <QListWidget>
+#include <QMessageBox>
+#include <QPointer>
+#include <QProcess>
+#include <QPushButton>
+#include <QTimer>
+#include <QVBoxLayout>
+
+#include "control/controlobject.h"
+#include "control/controlpushbutton.h"
+#include "library/rekordbox/removablemounts.h"
+#include "library/rekordbox/sourceidentity.h"
+#include "library/media/copyservice.h"
+#include "library/mixpicontrolleddialog.h"
+
+class MixpiMedia final : public QObject {
+  public:
+    using OpenSource = std::function<QString(const QJsonObject&)>;
+
+    MixpiMedia(QObject* owner, std::function<QWidget*()> parent, OpenSource openSource,
+            std::function<void()> refreshSources = {})
+            : QObject(owner), m_parent(std::move(parent)), m_openSource(std::move(openSource)),
+              m_refreshSources(std::move(refreshSources)),
+              m_available(new ControlObject(ConfigKey("[MixPi]", "media_available"))),
+              m_load(new ControlPushButton(ConfigKey("[MixPi]", "media_load"))),
+              m_eject(new ControlPushButton(ConfigKey("[MixPi]", "media_eject"))) {
+        m_load->connectValueChangeRequest(this, [this](double value) {
+            if (value > 0) {
+                show(false);
+            }
+        });
+        m_eject->connectValueChangeRequest(this, [this](double value) {
+            if (value > 0) {
+                show(true);
+            }
+        });
+#ifdef __linux__
+        auto& copies = mixxx::media::copyService();
+        copies.tick();
+        auto* copyTimer = new QTimer(this);
+        connect(copyTimer, &QTimer::timeout, this, [&copies] { copies.tick(); });
+        copyTimer->start(20);
+#endif
+#ifdef __LINUX__
+        m_available->set(QFileInfo(helper()).isReadable() ? 1 : 0);
+#else
+        m_available->set(0);
+#endif
+    }
+
+    ~MixpiMedia() override {
+        if (m_dialog) {
+            m_dialog->close();
+        }
+    }
+
+    static QString helper() {
+        return QStringLiteral("/opt/mixpi-skin-tools/mixpi-media-inventory.py");
+    }
+
+    static QJsonArray entries(const QJsonObject& snapshot, bool eject) {
+        if (eject) {
+            return snapshot.value("drives").toArray();
+        }
+        QJsonArray result;
+        for (const auto& drive : snapshot.value("drives").toArray()) {
+            for (const auto& volume : drive.toObject().value("volumes").toArray()) {
+                result.append(volume);
+            }
+        }
+        return result;
+    }
+
+    static QJsonObject resolve(const QJsonObject& snapshot, const QString& token, bool eject) {
+        QJsonObject found;
+        if (token.isEmpty() || snapshot.contains("error") || snapshot.value("version").toInt() != 1) {
+            return found;
+        }
+        for (const auto& value : entries(snapshot, eject)) {
+            const auto entry = value.toObject();
+            if (entry.value("token").toString() == token) {
+                if (!found.isEmpty()) {
+                    return {};
+                }
+                found = entry;
+            }
+        }
+        return found;
+    }
+
+    static mixxx::rekordbox::SourceObservation inspectSelected(const QJsonObject& volume) {
+        const auto physical = volume.value("physical").toObject();
+        const auto mount = volume.value("mount").toObject();
+        const auto path = mount.value("path").toString().toStdString();
+        const mixxx::rekordbox::SourceMount expectedMount{
+                QString::number(mount.value("id").toInt()).toStdString(),
+                mount.value("device").toString().toStdString(),
+                mount.value("root").toString().toStdString(), path};
+        const mixxx::rekordbox::PhysicalGeneration expectedGeneration{
+                physical.value("boot_id").toString().toStdString(),
+                physical.value("namespace").toString().toStdString(),
+                physical.value("sysfs").toString().toStdString(),
+                physical.value("device").toString().toStdString(),
+                physical.value("diskseq").toString().toStdString()};
+        auto observed = mixxx::rekordbox::inspectSource(path);
+        if (observed.revision.empty() ||
+                observed.revision != mixxx::rekordbox::sourceRevision(expectedMount, expectedGeneration)) {
+            return {};
+        }
+        return observed;
+    }
+
+    static bool stillPresent(const QJsonObject& volume) {
+        return !inspectSelected(volume).revision.empty();
+    }
+
+  private:
+    void showControlled(bool mount) {
+        if (!m_controlled) {
+            m_controlled = MixpiControlledMedia::openProduction();
+            m_controlled->setCompletionHandler(this, m_refreshSources);
+        }
+        auto* dialog = new MixpiControlledDialog(m_controlled, mount, m_parent());
+        m_dialog = dialog;
+        connect(dialog, &QDialog::accepted, this, [this] {
+            m_dialog = nullptr;
+            show(false);
+        });
+        dialog->show();
+    }
+
+    void observe(std::function<void(QJsonObject)> receive) {
+        auto* process = new QProcess(QCoreApplication::instance());
+        auto* deadline = new QTimer(process);
+        deadline->setSingleShot(true);
+        auto finished = std::make_shared<bool>(false);
+        const QPointer<MixpiMedia> owner(this);
+        auto complete = [process, deadline, finished, receive, owner](QJsonObject answer) {
+            if (*finished) {
+                return;
+            }
+            *finished = true;
+            deadline->stop();
+            if (owner) {
+                receive(answer);
+            }
+            if (process->state() == QProcess::NotRunning) {
+                process->deleteLater();
+            }
+        };
+        connect(deadline, &QTimer::timeout, process, [process, complete] {
+            process->kill();
+            complete(QJsonObject{{"error", "Media observation timed out; nothing was changed."}});
+        });
+        connect(process, &QProcess::errorOccurred, process, [complete](QProcess::ProcessError) {
+            complete(QJsonObject{{"error", "Media observer unavailable; nothing was changed."}});
+        });
+        connect(process, qOverload<int, QProcess::ExitStatus>(&QProcess::finished), process,
+                [process, complete](int exitCode, QProcess::ExitStatus exitStatus) {
+                    const auto document = QJsonDocument::fromJson(process->readAllStandardOutput());
+                    auto answer = document.object();
+                    if (exitStatus != QProcess::NormalExit || exitCode != 0 ||
+                            !document.isObject() || answer.value("version").toInt() != 1 ||
+                            !answer.value("drives").isArray()) {
+                        if (!answer.contains("error")) {
+                            answer.insert("error", "Media inventory could not be verified.");
+                        }
+                    }
+                    complete(answer);
+                    process->deleteLater();
+                });
+        deadline->start(6000);
+        process->start(QStringLiteral("/usr/bin/python3"), {helper()});
+    }
+
+    static QString description(const QJsonObject& entry, bool eject) {
+        const QString capacity = QString::number(entry.value("size").toDouble() / 1073741824.0, 'f', 1) + " GiB";
+        if (!eject) {
+            return entry.value("label").toString() + " · " + capacity + "\n" +
+                    entry.value("discriminator").toString();
+        }
+        QStringList volumes;
+        for (const auto& value : entry.value("volumes").toArray()) {
+            const auto volume = value.toObject();
+            volumes.append(volume.value("label").toString() + " — " +
+                    volume.value("discriminator").toString());
+        }
+        return capacity + " · disk " + entry.value("device").toString() +
+                " · generation " + entry.value("diskseq").toString() + " · EJECT BLOCKED\n" +
+                (volumes.isEmpty() ? QStringLiteral("No mounted whole-volume source") : volumes.join("\n"));
+    }
+
+    void show(bool eject) {
+        if (m_dialog) {
+            m_dialog->raise();
+            return;
+        }
+        auto* parent = m_parent();
+        if (!parent || m_available->get() != 1) {
+            return;
+        }
+        if (eject || (m_controlled && m_controlled->locked())) {
+            showControlled(false);
+            return;
+        }
+        auto* dialog = new QDialog(parent);
+        dialog->setAttribute(Qt::WA_DeleteOnClose);
+        dialog->setWindowTitle(eject ? tr("EJECT — choose physical USB drive") : tr("LOAD — choose USB volume"));
+        dialog->setMinimumSize(650, 320);
+        dialog->setWindowModality(Qt::WindowModal);
+        m_dialog = dialog;
+        auto* layout = new QVBoxLayout(dialog);
+        auto* status = new QLabel(tr("Choose explicitly. Playback and files are unchanged."), dialog);
+        status->setTextFormat(Qt::PlainText);
+        status->setWordWrap(true);
+        layout->addWidget(status);
+        auto* list = new QListWidget(dialog);
+        list->setStyleSheet("QListWidget::item { min-height: 56px; }");
+        layout->addWidget(list);
+        auto* actions = new QHBoxLayout;
+        auto* refresh = new QPushButton(tr("Refresh"), dialog);
+        auto* accept = new QPushButton(eject ? tr("Check selected drive") : tr("Load selected source"), dialog);
+        auto* cancel = new QPushButton(tr("Cancel"), dialog);
+        auto* mount = new QPushButton(tr("Mount USB…"), dialog);
+        for (auto* button : {refresh, accept, mount, cancel}) {
+            button->setMinimumHeight(48);
+            button->setAutoDefault(false);
+            actions->addWidget(button);
+        }
+        layout->addLayout(actions);
+        accept->setEnabled(false);
+        connect(mount, &QPushButton::clicked, dialog, [this, dialog] {
+            dialog->close();
+            m_dialog = nullptr;
+            showControlled(true);
+        });
+        connect(cancel, &QPushButton::clicked, dialog, &QDialog::reject);
+        connect(list, &QListWidget::currentItemChanged, dialog,
+                [accept](QListWidgetItem* current) { accept->setEnabled(current != nullptr); });
+        const QPointer<QDialog> guard(dialog);
+        auto reload = [this, guard, list, status, accept, refresh, eject] {
+            list->clear();
+            accept->setEnabled(false);
+            refresh->setEnabled(false);
+            status->setText(tr("Observing connected physical USB media…"));
+            observe([guard, list, status, refresh, eject](const QJsonObject& snapshot) {
+                if (!guard || !guard->isVisible()) {
+                    return;
+                }
+                refresh->setEnabled(true);
+                if (snapshot.contains("error")) {
+                    status->setText(snapshot.value("error").toString());
+                    return;
+                }
+                for (const auto& value : entries(snapshot, eject)) {
+                    const auto entry = value.toObject();
+                    auto* item = new QListWidgetItem(description(entry, eject), list);
+                    item->setData(Qt::UserRole, entry.value("token").toString());
+                }
+                list->setCurrentRow(-1);
+                list->clearSelection();
+                status->setText(list->count() ? tr("Select one entry. Identity is checked again before dispatch.") :
+                                              tr("No eligible physical USB media. Internal copies and system disks are excluded."));
+            });
+        };
+        connect(refresh, &QPushButton::clicked, dialog, reload);
+        connect(accept, &QPushButton::clicked, dialog,
+                [this, guard, list, status, accept, refresh, eject] {
+                    if (!list->currentItem()) {
+                        return;
+                    }
+                    const QString token = list->currentItem()->data(Qt::UserRole).toString();
+                    list->setEnabled(false);
+                    accept->setEnabled(false);
+                    refresh->setEnabled(false);
+                    status->setText(tr("Rechecking the exact selected device and all its partitions…"));
+                    observe([this, guard, list, status, refresh, token, eject](const QJsonObject& snapshot) {
+                        if (!guard || !guard->isVisible()) {
+                            return;
+                        }
