+void WLibrarySidebar::releaseShownSource() {
+    // Spec 2e, as 2g applies it (owner: "Let just land on the top menu
+    // instead"): a drive's folder in Tracks, opened through Folders
+    // (Removable Devices, a Quick Link or /), went with the drive. Its rows
+    // below Removable Devices went earlier, or the row stays (a Quick Link),
+    // so rowsAboutToBeRemoved did not see a drive's own row go. As there:
+    // the top level, nothing current, so the next ☰ opens there and no row
+    // has the edge.
+    if (!m_sourceScreen || !groupedTiles || !m_touchNavigation) {
+        return;
+    }
+    m_shownSourceGone = true;
+    if (selectionModel()) {
+        selectionModel()->clear();
+    }
+    m_menuInside = false;
+    m_touchNavigation->setFloor({});
+    m_touchNavigation->home();
+    updateSourceChrome();
+}
