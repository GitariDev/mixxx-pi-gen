+++ b/src/waveform/mixpiwaveformgain.h
@@ -0,0 +1,43 @@
+#pragma once
+
+#include <QString>
+#include <QWidget>
+
+// MixPi (spec 2h, wave J13): the decks' main waveforms on the Decks page draw
+// their height from the pregain knob only. Stock Mixxx scales every
+// waveform by [ChannelN],total_gain, the pregain knob times the ReplayGain
+// correction, so a loudly mastered track (the smallest ReplayGain) is drawn
+// smallest. The sound is unchanged: EnginePregain still applies the
+// ReplayGain. The EQ knobs and VisualGain_N still scale the height as before.
+// The Loop panel's waveform, the overview strips and every other waveform
+// keep total_gain.
+namespace mixpi {
+
+/// The skin group that holds each deck's main waveform (wave_row in
+/// mixpi-performance.py); tests/test_waveform_height.py keeps the two names
+/// the same.
+inline const QString& mainWaveformGroup() {
+    static const QString kGroup = QStringLiteral("MixpiWaveRow");
+    return kGroup;
+}
+
+/// True for a waveform viewer inside a main waveform row. The skin parser
+/// creates the viewer as a child of its group, after the group's object name
+/// is set, so the answer is final when the factory makes the widget.
+inline bool isMainWaveform(const QWidget* pViewer) {
+    for (const QWidget* pWidget = pViewer; pWidget != nullptr;
+            pWidget = pWidget->parentWidget()) {
+        if (pWidget->objectName() == mainWaveformGroup()) {
+            return true;
+        }
+    }
+    return false;
+}
+
+/// The gain a waveform's height follows: the pregain knob for a main
+/// waveform, total_gain for every other waveform.
+inline double waveformHeightGain(bool mainWaveform, double pregain, double totalGain) {
+    return mainWaveform ? pregain : totalGain;
+}
+
+} // namespace mixpi
