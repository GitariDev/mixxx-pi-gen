+std::function<void()> RekordboxFeature::openRemovableDeviceAsync(const QString& path,
+        const QString& mountRevision, const QString& databaseRevision, QObject* receiver,
+        mixxx::rekordbox::PendingSelection::Completion completion) {
+    if (m_pendingSelection) {
+        m_pendingSelection->cancel();
+    }
+    const auto observed = mixxx::rekordbox::inspectSource(path.toStdString());
+    QString initialError;
+    const auto admission = mixxx::media::acquireUnknown(mixxx::media::Producer::Import);
+    if (!admission) {
+        initialError = tr("Media is draining; source selection rejected.");
+    } else if (observed.database.empty() || observed.revision != mountRevision.toStdString() ||
+            observed.database != databaseRevision.toStdString()) {
+        initialError = tr("Selected Rekordbox generation or database path changed; choose again.");
+    } else if (mixxx::rekordbox::cachedSourceRow(m_pSidebarModel->getRootItem(), path,
+                       databaseRevision) < 0 || m_deviceDiscoveryActive || m_trackImportActive ||
+            m_deviceRefreshPending) {
+        m_requestedMounts.insert(path, mountRevision);
+        requestDeviceRefresh();
+    }
+    auto* operation = new mixxx::rekordbox::PendingSelection(this, receiver,
+            [this, path, mountRevision, databaseRevision, initialError]() -> std::optional<QString> {
+                if (!initialError.isEmpty()) {
+                    return initialError;
+                }
+                const auto current = mixxx::rekordbox::inspectSource(path.toStdString());
+                if (current.revision != mountRevision.toStdString() ||
+                        current.database != databaseRevision.toStdString() || current.database.empty()) {
+                    return tr("Selected device or database changed; no source was opened.");
+                }
+                if (m_deviceRefreshPending || m_deviceDiscoveryActive || m_trackImportActive) {
+                    return std::nullopt;
+                }
+                const int row = mixxx::rekordbox::cachedSourceRow(
+                        m_pSidebarModel->getRootItem(), path, databaseRevision);
+                if (row < 0) {
+                    return tr("Selected source was not found after discovery. Refresh and choose again.");
+                }
+                const auto mediaUse = mixxx::media::acquireUnknown(mixxx::media::Producer::Import);
+                if (!mediaUse) {
+                    return tr("Media is draining; source selection rejected.");
+                }
+                auto* item = m_pSidebarModel->getRootItem()->child(row);
+                const bool needsImport = item->getData().toList().value(1).toString() == IS_RECORDBOX_DEVICE;
+                const auto index = m_pSidebarModel->index(row, 0);
+                activateChild(index);
+                if (needsImport &&
+                        (!m_trackImportActive || m_pImportingDevice != item || !m_importMediaUse)) {
+                    return tr("Source import could not be admitted; no LOAD mode was changed.");
+                }
+                const auto confirmed = mixxx::rekordbox::inspectSource(path.toStdString());
+                const auto admittedUse = mixxx::media::acquireUnknown(mixxx::media::Producer::Import);
+                if (!admittedUse || m_deviceRefreshPending ||
+                        confirmed.revision != mountRevision.toStdString() ||
+                        confirmed.database != databaseRevision.toStdString()) {
+                    return tr("Source changed or admission was revoked; choose again.");
+                }
+                emit featureSelect(this, index);
+                return QString();
+            }, std::move(completion));
+    m_pendingSelection = operation;
+    const QPointer<mixxx::rekordbox::PendingSelection> guard(operation);
+    return [guard] {
+        if (guard) {
+            guard->cancel();
+        }
+    };
+}
