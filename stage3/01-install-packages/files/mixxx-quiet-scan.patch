+// One line only: long paths are elided in the middle instead of wrapping.
+class ScannerStatusLabel : public QLabel {
+  public:
+    using QLabel::QLabel;
+
+  protected:
+    void paintEvent(QPaintEvent* pEvent) override {
+        Q_UNUSED(pEvent);
+        QPainter painter(this);
+        const QRect area = contentsRect();
+        painter.drawText(area,
+                Qt::AlignLeft | Qt::AlignVCenter,
+                fontMetrics().elidedText(text(), Qt::ElideMiddle, area.width()));
