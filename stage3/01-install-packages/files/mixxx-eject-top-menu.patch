+void WLibrarySidebar::rowsAboutToBeRemoved(const QModelIndex& parent, int start, int end) {
+    // Spec 2e (owner: "Let just land on the top menu instead"): the drive
+    // whose list Tracks shows is ejected or pulled out. Its row is a drive
+    // tile's row; the current row (the list in Tracks) is that row or below
+    // it. RekordboxFeature empties the table; here the menu lands on the top
+    // level with nothing current, so the next ☰ opens there and no row has
+    // the edge. Another drive going, a list of This Pi in Tracks, or a
+    // drive's lists released while it stays (refreshMediaLifecycle removes
+    // rows below a drive, not the drive's row): nothing changes.
+    bool shownGoes = false;
+    if (m_sourceScreen && groupedTiles && m_touchNavigation) {
+        for (const auto& tile : std::as_const(m_groupedTiles)) {
+            if (!tile.id.startsWith(QStringLiteral("drive:")) || !tile.node.isValid() ||
+                    tile.node.parent() != parent || tile.node.row() < start ||
+                    tile.node.row() > end) {
+                continue;
+            }
+            for (QModelIndex step = currentIndex(); step.isValid(); step = step.parent()) {
+                shownGoes = shownGoes || step == tile.node;
+            }
+        }
+    }
+    QTreeView::rowsAboutToBeRemoved(parent, start, end);
+    if (!shownGoes) {
+        return;
+    }
+    m_shownSourceGone = true;
+    // Nothing is selected: not the row the view (single selection) or the
+    // selection model would move to (a neighbouring drive, or Rekordbox).
+    if (selectionModel()) {
+        selectionModel()->clear();
+    }
+    m_menuInside = false;
+    m_touchNavigation->setFloor({});
+    m_touchNavigation->home();
+    updateSourceChrome();
+}
