+void WLibrarySidebar::syncSourcesEditing() {
+    // Shown: editing, with a panel that is not hidden. The control is
+    // read-only for the skin, so it is confirmed directly (a set() on a
+    // read-only control is dropped by its change-request handler).
+    const bool shown = m_sourcesEditing && m_sourcesEditPanel && !m_sourcesEditPanel->isHidden();
+    m_sourcesEditing = shown;
+    if (m_sourcesEditingControl && m_sourcesEditingControl->get() != (shown ? 1 : 0)) {
+        m_sourcesEditingControl->setAndConfirm(shown ? 1 : 0);
+    }
+}
