@@ -0,0 +1,136 @@
+#pragma once
+
+#include <QEvent>
+#include <QFrame>
+#include <QHBoxLayout>
+#include <QLabel>
+#include <QPointer>
+#include <QPushButton>
+#include <QVBoxLayout>
+#include <functional>
+
+// MixPi native page host (R-2): a full-width child of the main window under
+// the 48 px top bar, down to the bottom edge. Not a dialog: it needs no window
+// manager and is not capped at 780x420. It writes [MixPi],screen (through the
+// callback) on open and 0 on close. The skin hides the waveforms whenever
+// screen is not 0, so the page never sits over a live waveform.
+class MixpiPage : public QFrame {
+  public:
+    static constexpr int kTopBarHeight = 48;
+    static constexpr int kHeaderHeight = 48;
+    static constexpr int kTouch = 48;
+    using WriteScreen = std::function<void(double)>;
+
+    MixpiPage(QWidget* window, int number, const QString& title, const QString& hint,
+            WriteScreen writeScreen)
+            : QFrame(window), m_number(number), m_writeScreen(std::move(writeScreen)) {
+        setObjectName(QStringLiteral("MixpiPage"));
+        setAttribute(Qt::WA_StyledBackground);
+        setAutoFillBackground(true);
+        setFocusPolicy(Qt::NoFocus);
+        auto* layout = new QVBoxLayout(this);
+        layout->setContentsMargins(0, 0, 0, 0);
+        layout->setSpacing(0);
+        auto* header = new QFrame(this);
+        header->setObjectName(QStringLiteral("MixpiPageHeader"));
+        header->setAttribute(Qt::WA_StyledBackground);
+        header->setFixedHeight(kHeaderHeight);
+        auto* row = new QHBoxLayout(header);
+        row->setContentsMargins(0, 0, 8, 0);
+        row->setSpacing(12);
+        m_close = new QPushButton(QStringLiteral("✕"), header);
+        m_close->setObjectName(QStringLiteral("MixpiPageClose"));
+        m_close->setAccessibleName(tr("Close"));
+        m_close->setFixedSize(kTouch, kTouch);
+        m_close->setFocusPolicy(Qt::NoFocus);
+        m_title = new QLabel(title, header);
+        m_title->setObjectName(QStringLiteral("MixpiPageTitle"));
+        m_title->setTextFormat(Qt::PlainText);
+        m_hint = new QLabel(hint, header);
+        m_hint->setObjectName(QStringLiteral("MixpiPageHint"));
+        m_hint->setTextFormat(Qt::PlainText);
+        row->addWidget(m_close);
+        row->addWidget(m_title);
+        row->addWidget(m_hint, 1);
+        layout->addWidget(header);
+        m_content = new QWidget(this);
+        m_content->setObjectName(QStringLiteral("MixpiPageContent"));
+        m_content->setAttribute(Qt::WA_StyledBackground);
+        layout->addWidget(m_content, 1);
+        connect(m_close, &QPushButton::clicked, this, [this] { closePage(); });
+        hide();
+        if (window) {
+            window->installEventFilter(this);
+        }
+    }
+
+    int number() const {
+        return m_number;
+    }
+    QWidget* content() const {
+        return m_content;
+    }
+    QPushButton* closeButton() const {
+        return m_close;
+    }
+
+    // Called after every open and close (the owner refreshes its state).
+    std::function<void(bool)> visibilityChanged;
+
+    void open() {
+        place();
+        show();
+        raise();
+        if (m_writeScreen) {
+            m_writeScreen(m_number);
+        }
+        if (visibilityChanged) {
+            visibilityChanged(true);
+        }
+    }
+
+    // The ✕: hide, and write screen 0 so the tab that was open shows again.
+    void closePage() {
+        const bool wasVisible = isVisible();
+        hide();
+        if (m_writeScreen) {
+            m_writeScreen(0);
+        }
+        if (wasVisible && visibilityChanged) {
+            visibilityChanged(false);
+        }
+    }
+
+    // The skin wrote [MixPi],screen (a tab, another view): leave without
+    // writing it again.
+    void screenChanged(double value) {
+        if (isVisible() && static_cast<int>(value) != m_number) {
+            hide();
+            if (visibilityChanged) {
+                visibilityChanged(false);
+            }
+        }
+    }
+
+    void place() {
+        if (auto* host = parentWidget()) {
+            setGeometry(0, kTopBarHeight, host->width(), qMax(0, host->height() - kTopBarHeight));
+        }
+    }
+
+  protected:
+    bool eventFilter(QObject* object, QEvent* event) override {
+        if (object == parentWidget() && event->type() == QEvent::Resize) {
+            place();
+        }
+        return QFrame::eventFilter(object, event);
+    }
+
+  private:
+    const int m_number;
+    WriteScreen m_writeScreen;
+    QPushButton* m_close;
+    QLabel* m_title;
+    QLabel* m_hint;
+    QWidget* m_content;
+};
